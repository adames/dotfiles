# macos/Brewfile — env apps shared between machines (M3 + Air).
#
# Idempotent. `brew bundle install --file=…` (called by phase_packages).
# Heavy / per-Mac apps live in macos/Brewfile.local (untracked) — the Air
# has no Brewfile.local so it stays lean.
# Skip casks in headless runs: BOOTSTRAP_SKIP_CASKS=1 ./bootstrap.sh
#
# This file is the whole truth for formulae: `brew leaves` should contain
# nothing that isn't listed here. Anything that drifts in gets adopted
# (add a line, with the reason) or torn down in phase_apply — never left
# floating, or the next fresh Mac silently comes up different.

# CLI formulae — shell, multiplexer, prompt, fuzzy / grep / git stack.
brew "git"
brew "zsh"
brew "tmux"
brew "direnv"
brew "starship"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "git-delta"
brew "zoxide"
brew "gh"
brew "lazygit"
brew "yazi"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "jq"                # JSON surgery — every script here and at work
brew "htop"
brew "mas"               # App Store CLI — lets update-system upgrade App Store apps (Xcode)

# Editor + runtimes. neovim was installed by hand on both Macs and never
# declared, so a fresh machine deployed nvim's config with no nvim.
#
# The runtimes are brew's now, not mise's. mise was handing out versions
# byte-identical to these formulae through an extra shim layer, and its
# one real advantage — per-project switching — went unused: the .nvmrc
# files in ~/code were being ignored and nobody noticed for five weeks.
# Versioned formulae pin just as hard (node@24 stays on 24 through a
# `brew upgrade`), and uv covers per-project Python properly.
#
# Both versioned formulae are keg-only — configs/zshrc puts their bin
# dirs on PATH, python@3.12 via libexec/bin so bare `python3` resolves
# here instead of falling back to macOS's system 3.9.
brew "neovim"
brew "node@24"
brew "python@3.12"
# The CLI, not `tree-sitter` — that formula is the C library. This is the
# binary nvim-treesitter shells out to when it compiles a parser, and
# it's what mise was actually providing under the name "tree-sitter".
brew "tree-sitter-cli"

# Language servers / linters. Nvim gates each on `executable()`, so a
# missing one degrades instead of erroring — but the whole point is that
# they're here. Python (read at work): pyright + ruff.
brew "pyright"
brew "ruff"

# JS/TS (personal projects): the LSP is `tsc --lsp`, TypeScript 7's own
# Go-native server. NOT typescript-language-server — that wraps the old
# tsserver.js, which TS 7 no longer ships, so the brew pairing is broken
# on arrival ("Could not find a valid TypeScript installation"). The
# native server also needs no node_modules, so a stray .ts file opened
# anywhere still gets gd / K / diagnostics.
brew "typescript"

# uv: the Python entry point — `uv run`, `uv venv`, `uv tool install`.
# Replaces pipx (removed in phase_apply) and keeps work Python readable
# without a global site-packages to maintain.
brew "uv"

# ffmpeg: yazi's video thumbnails, plus ad-hoc transcodes.
brew "ffmpeg"

# glow: the markdown viewer. One, deliberately. A 381 MB App Store app
# for rendering a README lost to a 10 MB binary that also works over SSH
# on the Linux box — same command on every machine, which is the whole
# point. Obsidian is still the place markdown gets *written*.
brew "glow"

# Terminal font (nerd glyphs for starship / yazi).
cask "font-jetbrains-mono-nerd-font"

# Network privacy. One VPN, not two — ExpressVPN is torn down in phase_apply.
cask "protonvpn"

# GUI env shared between machines.
cask "hyperkey"          # caps tap→esc (the one keymap survivor)
cask "ghostty"
cask "helium-browser"    # net.imput.helium (NOT the deprecated `helium` cask)
cask "obsidian"          # home notes; Notion is the work surface, not managed here
cask "iina"              # video. Beat Elmedia on merit; declared so every Mac has it.
