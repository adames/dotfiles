#!/usr/bin/env bash
# ws-doctor — keymap / launcher health check.
#
# Catches the failure modes the workspace stack has actually shipped:
#
#   1. stale aerospace.toml       — `aerospace.toml` edited after the
#                                   daemon started, so new bindings aren't
#                                   live (run `aerospace reload-config`).
#                                   Symptom: chord does nothing.
#
#   2. keystroke collision        — `osascript … keystroke "X" using …` driven
#                                   from a Hyper chord fires while the user is
#                                   still holding Caps. The synthetic event
#                                   picks up the live Hyper modifier state and
#                                   becomes Hyper+X. If Hyper+X is bound in
#                                   aerospace.toml, the wrong action fires.
#                                   (Historically this made a held Caps+T move
#                                   spaces: a launcher sent Cmd+N, which became
#                                   Hyper+N.) Launchers are bare `open -a` now,
#                                   so the live surface is small — but the lint
#                                   stays as a guard for any osascript chord.
#
#   3. source/deploy drift        — `configs/aerospace.toml` (or ghostty-config)
#                                   was patched but the deployed copy under
#                                   `~/.config/` is stale (or vice versa —
#                                   fixing only the deployed copy lets the next
#                                   `bootstrap.sh` clobber the fix). aerospace.toml
#                                   is hand-written now, so it pair-cmps cleanly.
#
#   4. menu item drift            — a launcher uses
#                                   `click menu item "New Window" of menu "File"`
#                                   to drive an app whose menu item silently
#                                   got renamed by an upstream release.
#
#   5. missing target app         — `tell application "Foo"` where Foo isn't
#                                   installed; AppleScript prompts for the
#                                   app and the launcher hangs.
#
#   6. phantom workspace tiles    — aerospace's tree tracks more windows on a
#                                   workspace than the AX window list reports
#                                   for those apps (window was closed without
#                                   aerospace getting a destroy event, or a
#                                   chord moved a stale tree node onto the
#                                   workspace). The reserved tile slots eat
#                                   layout space — the visible grid is shifted
#                                   right with empty space the user can't fill.
#
# Each check is independent; the script keeps going on failure so one report
# covers everything. Exit code is the number of FAILED checks (0 = clean).
# Warnings don't count against exit code; use --strict to promote them.
#
# Usage:
#   ws-doctor                # run every check, human report
#   ws-doctor --strict       # warnings become failures
#   ws-doctor --only=NAME    # run a single check (see CHECKS array)
#   ws-doctor --list         # print check names + descriptions
#   ws-doctor --quiet        # only print failures
#   ws-doctor --fix          # after diagnostics, attempt to repair any
#                            # FAILed check that has a registered fixer.
#                            # No fixers are registered today, so --fix
#                            # reports "no fixer" for each FAIL; the hook
#                            # stays plumbed for future repair automation.
#
# The Hyper layer is discovered at runtime by parsing aerospace.toml, so
# adding / removing a Hyper binding automatically updates the collision
# matrix.

set -u

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
. "$DOTFILES_DIR/lib/common.sh"

STRICT=
ONLY=
QUIET=
LIST=
FIX=
for arg in "$@"; do
  case "$arg" in
    --strict)  STRICT=1 ;;
    --quiet)   QUIET=1 ;;
    --list)    LIST=1 ;;
    --fix)     FIX=1 ;;
    --only=*)  ONLY="${arg#--only=}" ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) err "unknown arg: $arg"; exit 2 ;;
  esac
done

# Run state. Each check appends one line:
#   <status>\t<check>\t<message>
# Status ∈ {PASS, WARN, FAIL, SKIP}. Tab-separated so we can re-render
# without re-running.
REPORT=$(mktemp)
trap 'rm -f "$REPORT"' EXIT

_record() {
  local status="$1" check="$2" msg="$3"
  printf '%s\t%s\t%s\n' "$status" "$check" "$msg" >> "$REPORT"
}
PASS() { _record PASS "$1" "${2:-ok}"; }
WARN() { _record WARN "$1" "$2"; }
FAIL() { _record FAIL "$1" "$2"; }
SKIP() { _record SKIP "$1" "$2"; }

# The individual checks live in lib/ws-doctor-checks.sh (sourced here so
# they can use the PASS/WARN/FAIL/SKIP recorders defined just above). The
# dispatcher (CHECKS array), --fix hook, and rendering stay below.
. "$DOTFILES_DIR/lib/ws-doctor-checks.sh"
# ─── fixers (paired with checks via FIXERS map) ────────────────────────────
# Each fix_<name> function takes no args. It's called by the --fix
# dispatcher AFTER all checks have run, only for checks whose status
# was FAIL. Fixers print their own banner; their exit code drives the
# overall --fix exit status (0 = all attempted fixes succeeded).

# ─── render ─────────────────────────────────────────────────────────────────
declare -a CHECKS=(
  "aerospace-freshness:check_aerospace_freshness:Is AeroSpace serving the current aerospace.toml?"
  "keystroke-collision:check_keystroke_collision:osascript keystrokes vs Hyper layer"
  "source-deploy-drift:check_source_deploy_drift:configs/ matches deployed copies"
  "menu-items:check_menu_items:click-menu-item refs resolve in live apps"
  "app-references:check_app_references:tell application targets are installed"
  "aerospace-app-casing:check_aerospace_app_casing:script .app filters match aerospace output"
  "aerospace-daemon:check_aerospace_daemon:AeroSpace.app is running + reachable"
  "phantom-tiles:check_phantom_tiles:focused workspace has no phantom tile slots eating layout space"
)

# Map check-name → fixer-function-name. Only entries here are
# eligible for --fix dispatch; everything else is detect-only.
# Empty today — every check is detect-only — but the --fix dispatch
# hook below stays plumbed for future fixers.
declare -A FIXERS=()

if [[ -n "$LIST" ]]; then
  for spec in "${CHECKS[@]}"; do
    name="${spec%%:*}"; rest="${spec#*:}"
    fn="${rest%%:*}";  desc="${rest#*:}"
    printf '%-22s %s\n' "$name" "$desc"
  done
  exit 0
fi

[[ -z "$QUIET" ]] && section "ws-doctor (keymap / launcher health)"

for spec in "${CHECKS[@]}"; do
  name="${spec%%:*}"; rest="${spec#*:}"
  fn="${rest%%:*}"
  [[ -n "$ONLY" && "$ONLY" != "$name" ]] && continue
  "$fn"
done

# Render. Sort failures first so they're visible without scrolling.
fails=0 warns=0 passes=0 skips=0
while IFS=$'\t' read -r status check msg; do
  case "$status" in
    PASS) passes=$((passes + 1))
          [[ -z "$QUIET" ]] && ok "$(printf '%-22s %s' "$check" "$msg")" ;;
    WARN) warns=$((warns + 1))
          warn "$(printf '%-22s %s' "$check" "$msg")" ;;
    FAIL) fails=$((fails + 1))
          err  "$(printf '%-22s %s' "$check" "$msg")" ;;
    SKIP) skips=$((skips + 1))
          [[ -z "$QUIET" ]] && printf "skip %-17s %s\n" "$check" "$msg" ;;
  esac
done < "$REPORT"

[[ -z "$QUIET" ]] && printf '\n'
[[ -z "$QUIET" ]] && printf "summary: %d pass · %d warn · %d fail · %d skip\n" "$passes" "$warns" "$fails" "$skips"

# --fix: for each FAILed check with a fixer in FIXERS, invoke it. FIXERS
# is empty today (see the map above), so --fix just reports "no fixer" —
# the hook stays plumbed for future fixers.
if [[ -n "$FIX" ]] && (( fails > 0 )); then
  [[ -z "$QUIET" ]] && printf '\n' && section "--fix: attempting to repair $fails FAIL(s)"
  fix_fails=0
  while IFS=$'\t' read -r status check _; do
    [[ "$status" == "FAIL" ]] || continue
    fixer="${FIXERS[$check]:-}"
    if [[ -z "$fixer" ]]; then
      warn "no fixer registered for $check; skipping"
      continue
    fi
    if ! "$fixer"; then
      err "fixer for $check exited non-zero"
      fix_fails=$((fix_fails + 1))
    fi
  done < "$REPORT"
  [[ -z "$QUIET" ]] && printf '\n' && printf "fix summary: %d/%d repaired\n" "$((fails - fix_fails))" "$fails"
  # Re-exit reflects how many fixes failed (not how many checks failed).
  exit "$fix_fails"
fi

# Exit code: fails (or fails+warns under --strict).
if [[ -n "$STRICT" ]]; then
  exit $(( fails + warns ))
fi
exit "$fails"
