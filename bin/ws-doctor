#!/usr/bin/env bash
# ws-doctor — does every deployed config still match its source in configs/?
#
# The one failure mode this setup keeps shipping: a config gets patched in
# only one of its two homes. Fix the deployed copy under ~/.config and the
# next bootstrap reverts it; fix configs/ and forget to re-run bootstrap and
# the running system stays on the old one. Neither says a word. (A box ran a
# months-stale nvim-init.lua that way, and the LSP failure it caused got
# blamed on the LSP for a day.)
#
# The pairs come from config_manifest in lib/common.sh — the same list the
# bootstraps deploy from, so coverage can't drift from reality. This was a
# check-runner with a dispatcher, a --fix hook, four report severities and a
# plugin file, all for one check and zero fixers; that framework is in git
# history if a second check ever earns it back.
#
# Usage:
#   ws-doctor            # report every pair
#   ws-doctor --quiet    # print only problems
#
# Exit code is the number of drifted files (0 = clean).

set -u

# Unlike the bootstraps, ws-doctor can't just walk up from its own path: it's
# *deployed* to ~/.local/bin/ws-doctor, where that yields ~/.local. Try
# script-relative first but only accept it if lib/ is actually there (true in
# the repo, and for a clone anywhere on disk — CI checks out to
# /home/runner/work/...), then fall back to ~/dotfiles. DOTFILES_DIR wins.
if [[ -z "${DOTFILES_DIR:-}" ]]; then
  _self_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  if [[ -f "$_self_root/lib/common.sh" ]]; then
    DOTFILES_DIR="$_self_root"
  else
    DOTFILES_DIR="$HOME/dotfiles"
  fi
  unset _self_root
fi

# Fail loudly. Sourcing a missing lib used to leave every helper undefined
# and still print a summary of zeroes — a broken run that reads as a clean one.
if [[ ! -f "$DOTFILES_DIR/lib/common.sh" ]]; then
  printf 'ws-doctor: cannot find lib/common.sh under %s\n' "$DOTFILES_DIR" >&2
  printf 'ws-doctor: set DOTFILES_DIR to your dotfiles checkout\n' >&2
  exit 2
fi
. "$DOTFILES_DIR/lib/common.sh"

QUIET=
for arg in "$@"; do
  case "$arg" in
    --quiet) QUIET=1 ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) err "unknown arg: $arg"; exit 2 ;;
  esac
done

[[ -z "$QUIET" ]] && section "ws-doctor (config source/deploy drift)"

total=0 drifted=0 missing=0
while IFS='|' read -r src dst _; do
  [[ -n "$src" ]] || continue
  total=$((total + 1))
  if [[ ! -f "$src" ]]; then
    missing=$((missing + 1)); warn "missing source: ${src/#$HOME/~}"
  elif [[ ! -f "$dst" ]]; then
    missing=$((missing + 1)); warn "not deployed:   ${dst/#$HOME/~}"
  elif ! cmp -s "$src" "$dst"; then
    drifted=$((drifted + 1)); err "drift: ${src/#$HOME/~} vs ${dst/#$HOME/~}"
  elif [[ -z "$QUIET" ]]; then
    ok "${dst/#$HOME/~}"
  fi
done < <(config_manifest)

if (( drifted > 0 )); then
  err "$drifted of $total configs drifted — run: $DOTFILES_DIR/bootstrap.sh"
elif (( missing > 0 )); then
  warn "$total configs: $missing not deployed"
elif [[ -z "$QUIET" ]]; then
  printf '\n'; ok "$total configs in sync"
fi

exit "$drifted"
