#!/usr/bin/env bash
# ws-mouse-follow — pointer follows focus, called from aerospace's
# on-focus-changed. Lazy: move-mouse only fires when the mouse is
# outside the newly focused window.
#
# Exists as a script (not a bare callback command) for one reason:
# ws-grid's tree walk focuses every window in sequence, and a bare
# move-mouse would pinball the cursor through all of them on every
# grid rebuild. ws-grid raises a busy flag for its run; we no-op
# while it's up.
set -u

[[ -e "${TMPDIR:-/tmp}/ws-grid.busy" ]] && exit 0
exec aerospace move-mouse window-lazy-center
