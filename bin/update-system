#!/usr/bin/env bash
# update-system — full sweep of package updates. One source of truth:
# bootstrap calls this from phase_packages, and the `update-sys` zsh alias
# runs it standalone (PATH-resolved; bootstrap installs it to ~/.local/bin).
#
# brew update → brew upgrade → brew cleanup covers everything now: the
# runtimes are versioned formulae (node@24, python@3.12), so a `brew
# upgrade` moves them within their pin and never across it. The mise
# pass that used to live here went with mise itself. mas upgrades App
# Store apps in place.
# softwareupdate is list-only — applying
# needs sudo and risks an unwanted reboot, so this surfaces what's
# pending and tells you the one-liner to apply it.
#
# Idempotent. TTY-aware (softwareupdate only runs with a TTY).

# pipefail so the `cmd 2>&1 | sed | ... || warn` patterns below see the
# real exit status of brew. Without it the pipeline status is sed's
# (always 0) and every `|| warn` is dead code — failures pass silently.
set -u
set -o pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
. "$DOTFILES_DIR/lib/common.sh"

section "update-system"

if have brew; then
  step "brew update / upgrade / cleanup"
  brew update --quiet 2>&1 | sed 's/^/    /' || warn "brew update had issues"
  brew upgrade         2>&1 | sed 's/^/    /' || warn "brew upgrade had failures"
  brew cleanup --quiet 2>&1 | sed 's/^/    /' || true
  ok "brew current"
else
  warn "brew not installed — skipping"
fi

# App Store apps (Xcode, …) — mas upgrades them in place, no App Store
# GUI round-trip. Skipped silently where mas isn't installed (Ubuntu).
if have mas; then
  step "mas upgrade (App Store apps)"
  mas upgrade 2>&1 | sed 's/^/    /' || warn "mas upgrade had failures"
  ok "App Store apps current"
fi

if has_tty && have softwareupdate; then
  step "softwareupdate -l (list-only — apply with: sudo softwareupdate -i -a)"
  out=$(softwareupdate -l 2>&1)
  sw_status=$?
  if (( sw_status != 0 )); then
    # A daemon/network failure exits non-zero and its output won't
    # contain "No new software available" either — that used to fall
    # through to the else branch and get misreported as "updates
    # available" when we just couldn't reach softwareupdate at all.
    warn "couldn't check for macOS updates (softwareupdate exited $sw_status)"
  elif printf '%s\n' "$out" | grep -q "No new software available"; then
    ok "no macOS updates"
  else
    printf '%s\n' "$out" | sed 's/^/    /'
    warn "macOS updates available — review above"
  fi
else
  warn "skipping softwareupdate (no TTY)"
fi

ok "update-system complete"
