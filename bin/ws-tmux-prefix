#!/usr/bin/env bash
# ws-tmux-prefix — Caps+Space shim. Sends C-Space to the running tmux
# server; no-ops if none is up.
#
# Why a script: the previous inline aerospace binding ran tmux send-keys
# directly. When tmux's server is down, that errors silently through
# exec-and-forget — looks like the chord "doesn't work" but actually
# there's just no tmux to forward to. This script gates on server
# liveness so future debugging has somewhere to hook in.
set -u
T=/opt/homebrew/bin/tmux
[[ -x "$T" ]] || exit 0
"$T" list-clients >/dev/null 2>&1 || exit 0
exec "$T" send-keys C-Space
