#!/usr/bin/env bash
# ws-tmux-prefix — retained for debug / fallback; no longer called by
# AeroSpace. The primary Caps+Space path now uses AeroSpace mode.tmux,
# which fires direct tmux commands without keystroke injection.
#
# If re-enabling: send-keys C-Space writes bytes to pane stdin, bypassing
# tmux's key-binding layer (prefix never entered). Use osascript injection
# instead, with a short sleep so Caps releases before the event fires.
set -u
T=/opt/homebrew/bin/tmux
[[ -x "$T" ]] || exit 0
"$T" list-clients >/dev/null 2>&1 || exit 0
sleep 0.08
osascript -e 'tell application "System Events" to key code 49 using {control down}'
