#!/bin/sh
# Mirror every Claude project memory (*.md only) to ~/documents/claude-memory/<project>/ (iCloud-synced).
# --restore copies the other way, never overwriting a newer local file. Copy, never symlink.
#
# The backup direction uses --delete, so this is a mirror rather than an
# append-only archive. Without it, memory could only ever grow: pruning a
# memory locally left it in the mirror, and the next --restore on a fresh
# Mac resurrected it. Five memories describing a deleted repo came back
# that way, which is how this was found.
#
# --delete is deliberately asymmetric. It applies going OUT (local is the
# source of truth for what Claude currently believes) and never coming
# back IN, where deleting local files from a stale mirror would be
# actively destructive. Non-.md files in the mirror are excluded and
# therefore protected from deletion too — rsync won't delete what it was
# told to ignore, absent --delete-excluded.
#
# The guard that makes this safe is below: a project whose local memory
# dir has no *.md at all is SKIPPED, not mirrored. So an emptied or
# not-yet-created memory dir can never wipe that project's backup.
# iCloud version history is the net for anything else.
set -e
SRC="$HOME/.claude/projects"; DST="$HOME/documents/claude-memory"; mkdir -p "$DST"
if [ "$1" = "--restore" ]; then
  for d in "$DST"/*/; do p=$(basename "$d"); [ -f "$d/MEMORY.md" ] || continue
    mkdir -p "$SRC/$p/memory"; rsync -a --update --include='*.md' --exclude='*' "$d" "$SRC/$p/memory/"; done
  echo "$(date '+%F %T')  restored" >> "$DST/.last-sync"; exit 0
fi
n=0
for m in "$SRC"/*/memory; do [ -d "$m" ] || continue; p=$(basename "$(dirname "$m")")
  case "$p" in *--claude-worktrees-*) continue;; esac
  ls "$m"/*.md >/dev/null 2>&1 || continue
  mkdir -p "$DST/$p"; rsync -a --delete --include='*.md' --exclude='*' "$m/" "$DST/$p/"; n=$((n+1)); done
echo "$(date '+%F %T')  synced $n projects" >> "$DST/.last-sync"; echo "synced $n projects -> $DST"
