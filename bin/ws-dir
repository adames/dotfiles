#!/usr/bin/env bash
# ws-dir <h|j|k|l> — direction-aware dispatch for Caps+hjkl.
#
# Floating window: snap via ws-snap (h=left, l=right, j=center, k=max).
# Tiled  window: focus neighbor via yabai --window --focus.
#
# Lives behind a single chord so skhdrc stays one-line-per-binding
# and the float-vs-tile decision has exactly one source of truth.
set -u

dir="${1:-}"
case "$dir" in
  h|j|k|l) ;;
  *)
    echo "usage: ws-dir <h|j|k|l>" >&2
    exit 2
    ;;
esac

# is-floating? Exit 0 = floating, 1 = tiled (or no focused window).
floating=0
if yabai -m query --windows --window 2>/dev/null \
     | jq -e '.["is-floating"] == true' >/dev/null 2>&1; then
  floating=1
fi

if (( floating )); then
  case "$dir" in
    h) region=left ;;
    l) region=right ;;
    j) region=center ;;
    k) region=max ;;
  esac
  exec "$HOME/.local/bin/ws-snap" "$region"
else
  case "$dir" in
    h) direction=west  ;;
    j) direction=south ;;
    k) direction=north ;;
    l) direction=east  ;;
  esac
  exec yabai -m window --focus "$direction"
fi
