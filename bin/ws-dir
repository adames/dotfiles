#!/usr/bin/env bash
# ws-dir <h|j|k|l> — direction-aware dispatch for Caps+hjkl.
#
# Floating window: snap via ws-snap (h=left, l=right, j=center, k=max).
# Tiled  window: focus neighbor via aerospace.
#
# Lives behind a single chord so aerospace.toml stays one line per
# binding and the float-vs-tile decision has exactly one source of
# truth.
set -u

dir="${1:-}"
case "$dir" in
  h|j|k|l) ;;
  *)
    echo "usage: ws-dir <h|j|k|l>" >&2
    exit 2
    ;;
esac

# is-floating? AeroSpace exposes the layout of the focused node via
# `list-windows --focused --json`'s ."floating-or-tiling" field
# ("floating" | "tiling"). Empty / failed query → treat as tiled and
# fall through to the focus path.
floating=0
layout=$(aerospace list-windows --focused --json 2>/dev/null \
           | jq -r '.[0]."floating-or-tiling" // empty' 2>/dev/null)
[[ "$layout" == "floating" ]] && floating=1

if (( floating )); then
  case "$dir" in
    h) region=left ;;
    l) region=right ;;
    j) region=center ;;
    k) region=max ;;
  esac
  exec "$HOME/.local/bin/ws-snap" "$region"
else
  case "$dir" in
    h) direction=left  ;;
    j) direction=down  ;;
    k) direction=up    ;;
    l) direction=right ;;
  esac
  exec aerospace focus "$direction"
fi
