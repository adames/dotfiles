#!/usr/bin/env bash
# ws-grid <apply|rotate|detect|auto> — rows-of-2 grid for the focused
# workspace.
#
#   apply   flatten + pair into rows of two + balance. 1 window fills,
#           2 sit side by side, 3 = two top + full-width bottom,
#           4 = two top two bottom. Floating windows are left alone.
#   rotate  cycle every tiled window one grid position (reading order).
#           The tree is untouched — windows replace each other. Press
#           again to keep cycling; n presses returns to start.
#   detect  debounced apply, fired by [[on-window-detected]] so new
#           windows settle into the grid. Skips when the focused
#           workspace's tiled count is unchanged (background dialogs).
#   auto    toggle the detect hook off/on (flag file).
#
# Driven by window-id where possible. The unavoidable focus hops
# (focus --dfs-index has no --ignore-floating, so tree order can only
# be read by walking) are restored before exit.
set -u

# AeroSpace fires exec-and-forget with launchd's minimal PATH (no
# Homebrew bindir), so bare `aerospace` would not resolve when this is
# called from a binding or the on-window-detected hook. Prepend the
# usual brew paths — same class of fix as ws-tmux-prefix (290dcb3).
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

FLAG="$HOME/.config/workspace/grid-auto-off"
LOCK="${TMPDIR:-/tmp}/ws-grid.lock"
COUNT_CACHE="${TMPDIR:-/tmp}/ws-grid.count"

# Raised while we touch the tree. Historically ws-mouse-follow no-oped
# on it so the focus walk didn't pinball the pointer; that shim is gone
# (focus-follow is native `move-mouse window-lazy-center` now), so the
# pointer lazily chases the walk and re-centers on the restored window
# when we finish. Harmless; the flag is kept for any future coordinator.
BUSY="${TMPDIR:-/tmp}/ws-grid.busy"
RAISED_BUSY=0
GRABBED_LOCK=0
raise_busy() { touch "$BUSY"; RAISED_BUSY=1; }
cleanup() {
  (( RAISED_BUSY ))  && rm -f "$BUSY"
  (( GRABBED_LOCK )) && rmdir "$LOCK" 2>/dev/null
}

notify() { osascript -e "display notification \"$1\" with title \"ws\"" 2>/dev/null; }

tiled_count() {
  aerospace list-windows --workspace focused --format '%{window-layout}' \
    | grep -cv '^floating$'
}

# Tiled window ids of the focused workspace in tree (reading) order.
# dfs-index perceives floating windows, so each leaf is focused and
# filtered by layout — call only between flatten and the joins.
tiled_in_order() {
  local total i line
  total=$(aerospace list-windows --workspace focused --count)
  for ((i = 0; i < total; i++)); do
    aerospace focus --dfs-index "$i" 2>/dev/null || continue
    line=$(aerospace list-windows --focused --format '%{window-id} %{window-layout}')
    [[ "${line#* }" == floating ]] || printf '%s\n' "${line%% *}"
  done
}

apply() {
  local n orig id i ids=()
  n=$(tiled_count)
  printf '%s %s\n' "$(aerospace list-workspaces --focused)" "$n" > "$COUNT_CACHE"
  (( n >= 2 )) || return 0
  orig=$(aerospace list-windows --focused --format '%{window-id}' 2>/dev/null)

  raise_busy
  aerospace flatten-workspace-tree
  while IFS= read -r id; do ids+=("$id"); done < <(tiled_in_order)
  (( ${#ids[@]} >= 2 )) || return 0

  # join-with errors out while a floating window holds focus — park
  # focus on a tiled window before touching the tree.
  aerospace focus --window-id "${ids[0]}"
  aerospace layout --window-id "${ids[0]}" v_tiles
  for ((i = 1; i < ${#ids[@]}; i += 2)); do
    aerospace join-with --window-id "${ids[i]}" up
  done
  aerospace balance-sizes

  [[ -n "$orig" ]] && aerospace focus --window-id "$orig" 2>/dev/null
  return 0
}

rotate() {
  local n i layout tid
  n=$(tiled_count)
  (( n >= 2 )) || return 0
  raise_busy
  # swap from a float-focused state errors — park focus on any tiled
  # window first (rotation is position-independent).
  layout=$(aerospace list-windows --focused --format '%{window-layout}' 2>/dev/null)
  if [[ "$layout" == floating || -z "$layout" ]]; then
    tid=$(aerospace list-windows --workspace focused \
            --format '%{window-id} %{window-layout}' \
          | awk '$2 != "floating" {print $1; exit}')
    [[ -n "$tid" ]] || return 0
    aerospace focus --window-id "$tid"
  fi
  for ((i = 1; i < n; i++)); do
    aerospace swap dfs-next --wrap-around
  done
}

detect() {
  [[ -e "$FLAG" ]] && exit 0
  # Coalesce bursts (an app restoring N windows): the first caller
  # holds the lock and sleeps so the windows attach, then re-grids
  # once; concurrent callers bail. A window landing mid-apply re-fires
  # detect after the lock frees, so nothing is missed.
  #
  # Self-heal an abandoned lock: a live run holds it well under a second,
  # so a lock dir older than a minute is a previous detect killed before
  # its EXIT trap ran (SIGKILL / launchd teardown / display sleep). Without
  # this, one such kill wedges auto-grid silently until a manual rmdir.
  [[ -d "$LOCK" ]] && find "$LOCK" -maxdepth 0 -mmin +1 -exec rmdir {} \; 2>/dev/null
  mkdir "$LOCK" 2>/dev/null || exit 0
  GRABBED_LOCK=1
  sleep 0.3
  # Unchanged tiled count on the focused workspace means the new
  # window landed elsewhere (or floated) — don't churn the tree.
  if [[ -r "$COUNT_CACHE" ]] &&
     [[ "$(cat "$COUNT_CACHE")" == "$(aerospace list-workspaces --focused) $(tiled_count)" ]]; then
    exit 0
  fi
  apply
}

auto() {
  if [[ -e "$FLAG" ]]; then
    rm -f "$FLAG"
    notify "auto-grid on"
  else
    touch "$FLAG"
    notify "auto-grid off"
  fi
}

trap cleanup EXIT
case "${1:-}" in
  apply)  apply ;;
  rotate) rotate ;;
  detect) detect ;;
  auto)   auto ;;
  *)
    echo "usage: ws-grid <apply|rotate|detect|auto>" >&2
    exit 2
    ;;
esac
