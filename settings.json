{
  "_comment": "AI Agent Shared Settings Template — Copy to settings.json and customize",
  "version": "1.0.0",
  "project": "dotfiles",
  "project_root": "~/dotfiles",

  "agents": {
    "allowed_tools": [
      "Bash(git status)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(brew list *)",
      "Bash(brew install *)",
      "Bash(nvim --headless *)",
      "Bash(tmux *)",
      "Bash(cp ~/dotfiles/configs/* ~/*)",
      "Bash(~/dotfiles/bootstrap.sh)",
      "Bash(~/dotfiles/tests/run-all.sh)",
      "Bash(~/dotfiles/bin/ws-doctor)",
      "Bash(~/dotfiles/bin/ws-dir)",
      "Read(~/dotfiles/**)",
      "Edit(~/dotfiles/**)",
      "Write(~/dotfiles/**)",
      "WebSearch",
      "WebFetch(domain:github.com)"
    ],

    "workflows": {
      "bootstrap": "~/dotfiles/bootstrap.sh",
      "test": "~/dotfiles/tests/run-all.sh",
      "verify": "~/dotfiles/bin/ws-doctor",
      "lint": "bash -n ~/dotfiles/**/*.sh"
    },

    "constraints": [
      "No agent references in commit messages (no 'Co-Authored-By:', no '🤖 Generated')",
      "No first-person agent self-references ('I added', 'this AI')",
      "No agent-named branches — use feat/, fix/, chore/, refactor/, docs/, ci/ only",
      "No agent references in code, comments, docs, or PRs",
      "No agent signatures or generation badges in any artifacts",
      "Author and committer must remain the human's identity"
    ],

    "workspace_dirs": {
      "claude": "~/personas/.claude/",
      "windsurf": "~/personas/.windsurf/",
      "devin": "~/personas/.devin/",
      "cursor": "~/personas/.cursor/"
    },

    "persona_file": "~/dotfiles/AGENTS.md"
  }
}
