# PATH is not set here. ~/.zshenv owns it (every zsh reads that), and
# ~/.zprofile re-asserts it for login shells after Apple's path_helper has
# had its way — and /etc/zprofile → ~/.zprofile both run before this file.
# A third `source ~/.zshenv` at the top of .zshrc was doing nothing that
# ~/.zprofile hadn't already done a moment earlier.

# @cs section Shell
# @cs family terminal
# @cs sub zsh · vi mode · fzf · zoxide
# @cs idea fzf, zoxide and vi-mode turn the shell into a navigable surface, not a typewriter.
# @cs row ctrl-r         :: fzf history search
# @cs row ctrl-t         :: fzf file picker (insert path)
# @cs row alt-c          :: fzf cd into subdir
# @cs row ⟨pat⟩**<tab>   :: fzf completion on the current word
# @cs row esc            :: enter vi-mode normal (then hjkl, /, w, b, …)
# @cs row z ⟨pat⟩        :: zoxide: jump to most-frecent matching dir
# @cs row zi             :: zoxide: interactive picker
# @cs row rg ⟨pat⟩       :: ripgrep — uses ~/.ripgreprc defaults
# @cs row fd ⟨pat⟩       :: fd — fast find replacement
# @cs end

# vi-mode first: fzf/autosuggestions bind to the active keymap at source time.
bindkey -v

# Cached tool init. `starship init zsh`, `fzf --zsh` and `zoxide init zsh`
# each print the same static script on every shell start, and charge 22 / 6
# / 4 ms of fork-and-run to do it — more than half this file's total. Cache
# the output, source the cache, and regenerate when the tool's binary is
# newer than the cache: a `brew upgrade` invalidates it by itself, with
# nobody left to remember. Deliberately bash-parseable, like the rest of
# this file — CI lints it with `bash -n`.
_zcache="$HOME/.cache/zsh"
_init_cached() {
  local name="$1" bin f
  shift
  bin="$(command -v "$1" 2>/dev/null)"
  [[ -n "$bin" ]] || return 0
  f="$_zcache/$name.zsh"
  if [[ ! -s "$f" || "$bin" -nt "$f" ]]; then
    mkdir -p "$_zcache"
    "$@" > "$f.new" 2>/dev/null && mv -f "$f.new" "$f" || rm -f "$f.new"
  fi
  [[ -s "$f" ]] && source "$f"
}

_init_cached starship starship init zsh

# brew on macOS, ~/.zsh git-clone on Linux
for _zp in \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
do [[ -f "$_zp" ]] && { source "$_zp"; break; }; done
unset _zp

# fzf, fd-backed (respects .gitignore by default)
if command -v fd &>/dev/null; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi
_init_cached fzf fzf --zsh

HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

export EDITOR='nvim'
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

alias ll='ls -lah'
alias la='ls -A'
alias ..='cd ..'
alias ...='cd ../..'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gpl='git pull'
alias update-sys='update-system'

_init_cached zoxide zoxide init zsh

# User zsh completions from ~/.config/zsh/completions.
if [[ -d "$HOME/.config/zsh/completions" ]]; then
  fpath=("$HOME/.config/zsh/completions" $fpath)
fi

# Prune broken completion symlinks (e.g. uninstalled Homebrew casks) before
# compinit. Plain glob + [[ -L && ! -e ]] does the dangling-link test with
# zero forks per fpath dir; null_glob makes an empty dir a no-op instead of
# a NOMATCH error. Deliberately bash-parseable — CI lints this file with
# bash -n (glob qualifiers like (N-@) would break it).
setopt null_glob
for _zd in $fpath; do
  [[ -d $_zd ]] || continue
  for _zf in "$_zd"/_*; do
    [[ -L "$_zf" && ! -e "$_zf" ]] && command rm -f -- "$_zf" 2>/dev/null
  done
done
unsetopt null_glob
unset _zd _zf

# .zcompdump: a full compinit forks compaudit (an insecure-directory scan)
# on every shell start. Skip it once the dump is <24h old — compinit -C
# trusts the cache and just sources it. find(1) does the mtime check: one
# cheap fork, and unlike (#q...) glob qualifiers it needs no extendedglob
# and stays bash-parseable for CI lint.
autoload -Uz compinit
_zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
if [[ -f "$_zcompdump" && -n "$(find "$_zcompdump" -mmin -1440 2>/dev/null)" ]]; then
  compinit -C
else
  compinit -i
fi
unset _zcompdump

# Auto-attach tmux on SSH
if [[ -n "$SSH_CONNECTION" && -z "$TMUX" ]]; then
  tmux attach-session -t main 2>/dev/null || tmux new-session -s main
fi

# zsh-syntax-highlighting: its own docs require sourcing at the very end of
# .zshrc — it wraps every widget already defined, so anything sourced after
# it (fzf/zoxide key bindings, etc.) would silently lose highlighting.
# brew on macOS, ~/.zsh git-clone on Linux
for _zp in \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
do [[ -f "$_zp" ]] && { source "$_zp"; break; }; done
unset _zp _zcache
unfunction _init_cached 2>/dev/null
