export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:$PATH"
typeset -U PATH

# @cs section Shell
# @cs family terminal
# @cs sub zsh · vi mode · fzf · zoxide
# @cs idea fzf, zoxide and vi-mode turn the shell into a navigable surface, not a typewriter.
# @cs row ctrl-r         :: fzf history search
# @cs row ctrl-t         :: fzf file picker (insert path)
# @cs row alt-c          :: fzf cd into subdir
# @cs row ⟨pat⟩**<tab>   :: fzf completion on the current word
# @cs row esc            :: enter vi-mode normal (then hjkl, /, w, b, …)
# @cs row z ⟨pat⟩        :: zoxide: jump to most-frecent matching dir
# @cs row zi             :: zoxide: interactive picker
# @cs row rg ⟨pat⟩       :: ripgrep — uses ~/.ripgreprc defaults
# @cs row fd ⟨pat⟩       :: fd — fast find replacement
# @cs row direnv allow   :: trust this dir's .envrc on first entry
# @cs end

# vi-mode FIRST: ZLE consumers (fzf, autosuggestions) bind to the active
# keymap at source time. Switching after them loses Ctrl-R / Ctrl-T.
bindkey -v

eval "$(starship init zsh)"

# brew on macOS, ~/.zsh git-clone on Linux
for _zp in \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
do [[ -f "$_zp" ]] && { source "$_zp"; break; }; done
for _zp in \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
do [[ -f "$_zp" ]] && { source "$_zp"; break; }; done
unset _zp

# fzf, fd-backed (respects .gitignore by default)
if command -v fd &>/dev/null; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

export EDITOR='vim'
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

alias ll='ls -lah'
alias la='ls -A'
alias ..='cd ..'
alias ...='cd ../..'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gpl='git pull'

# mise: brew on mac, ~/.local/bin on linux
if   command -v mise        &>/dev/null; then eval "$(mise activate zsh)"
elif [ -f ~/.local/bin/mise ];                then eval "$(~/.local/bin/mise activate zsh)"
fi

command -v direnv &>/dev/null && eval "$(direnv hook zsh)"
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# Workspace identity: source the env file written by the yabai
# space_changed signal so MACOS_SPACE_NAME / COLOR / ICON / INDEX are
# available to starship's custom workspace module. precmd refresh keeps
# the prompt in sync after a space switch without requiring a new shell.
_workspace_env() {
  [[ -r "$HOME/.cache/workspace/current.env" ]] && \
    source "$HOME/.cache/workspace/current.env"
}
_workspace_env
typeset -ag precmd_functions
precmd_functions+=(_workspace_env)

# ws CLI completion (installed by bootstrap to ~/.config/zsh/completions).
# Adds the dir to fpath, then compinit picks up _ws (also completes
# the `workspace` compat symlink).
if [[ -d "$HOME/.config/zsh/completions" ]]; then
  fpath=("$HOME/.config/zsh/completions" $fpath)
fi

# Prune dangling _completion symlinks from fpath dirs. An uninstalled
# Homebrew cask (e.g. docker-desktop pointing into /Applications/Docker.app)
# can leave broken symlinks under site-functions that compinit then errors
# on with `:527: no such file or directory` and a cascaded `:529 shift`.
for _zd in $fpath; do
  [[ -d $_zd ]] || continue
  for _zf in "$_zd"/_*(N); do
    [[ -e $_zf ]] || command rm -f -- "$_zf" 2>/dev/null
  done
done
unset _zd _zf

autoload -Uz compinit && compinit -i

# Auto-attach tmux on SSH
if [[ -n "$SSH_CONNECTION" && -z "$TMUX" ]]; then
  tmux attach-session -t main 2>/dev/null || tmux new-session -s main
fi
