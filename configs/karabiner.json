{
  "global": {
    "check_for_updates_on_startup": true,
    "show_in_menu_bar": true,
    "show_profile_name_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Default",
      "selected": true,
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "ansi"
      },
      "complex_modifications": {
        "rules": [
          {
            "description": "Hyper+Space -> Ctrl+Space (so Caps+Space sends the tmux prefix)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "spacebar",
                  "modifiers": {
                    "mandatory": ["left_control", "left_option", "left_command", "left_shift"]
                  }
                },
                "to": [
                  {
                    "key_code": "spacebar",
                    "modifiers": ["left_control"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Caps Lock+Shift -> Mod (Ctrl+Opt+Cmd) so Hyper+Shift+key is distinguishable in skhd",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "mandatory": ["shift"] }
                },
                "to": [
                  {
                    "key_code": "left_control",
                    "modifiers": ["left_option", "left_command"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Caps Lock -> Hyper (Ctrl+Opt+Cmd+Shift); tap-Caps -> Escape",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [
                  {
                    "key_code": "left_control",
                    "modifiers": ["left_shift", "left_option", "left_command"]
                  }
                ],
                "to_if_alone": [
                  { "key_code": "escape" }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
