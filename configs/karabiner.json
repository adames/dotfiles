{
  "global": {
    "check_for_updates_on_startup": true,
    "show_in_menu_bar": true,
    "show_profile_name_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Default",
      "selected": true,
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "ansi"
      },
      "complex_modifications": {
        "rules": [
          {
            "description": "Caps Lock+Shift -> Meh (Ctrl+Opt+Cmd) so Hyper+Shift+key is distinguishable in skhd",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "mandatory": ["shift"] }
                },
                "to": [
                  {
                    "key_code": "left_control",
                    "modifiers": ["left_option", "left_command"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Caps Lock -> Hyper (Ctrl+Opt+Cmd+Shift); tap-Caps -> Escape",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [
                  {
                    "key_code": "left_control",
                    "modifiers": ["left_shift", "left_option", "left_command"]
                  }
                ],
                "to_if_alone": [
                  { "key_code": "escape" }
                ]
              }
            ]
          },
          {
            "description": "Hyper app launchers: b/c/g/s -> Brave/Claude/Chrome/Safari",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "b",
                  "modifiers": {
                    "mandatory": ["left_command", "left_option", "left_control", "left_shift"]
                  }
                },
                "to": [{ "shell_command": "open -a 'Brave Browser'" }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "c",
                  "modifiers": {
                    "mandatory": ["left_command", "left_option", "left_control", "left_shift"]
                  }
                },
                "to": [{ "shell_command": "open -a 'Claude'" }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "g",
                  "modifiers": {
                    "mandatory": ["left_command", "left_option", "left_control", "left_shift"]
                  }
                },
                "to": [{ "shell_command": "open -a 'Google Chrome'" }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "s",
                  "modifiers": {
                    "mandatory": ["left_command", "left_option", "left_control", "left_shift"]
                  }
                },
                "to": [{ "shell_command": "open -a 'Safari'" }]
              }
            ]
          }
        ]
      }
    }
  ]
}
