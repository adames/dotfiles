# Ghostty. Reference: https://ghostty.org/docs/config/reference

# Left Option as Alt — vim/tmux expect the Alt modifier, not special chars.
macos-option-as-alt = left

font-size = 16
mouse-hide-while-typing = true
window-padding-x = 8
window-padding-y = 8

# cmd-t / cmd-n both make a fresh window (tabs never earned their keep;
# habit kept from the aerospace era, where a tab halved the tile).
keybind = cmd+t=new_window
keybind = cmd+n=new_window
