# Ghostty. Reference: https://ghostty.org/docs/config/reference

# Left Option as Alt — vim/tmux expect the Alt modifier, not special chars.
macos-option-as-alt = left

font-size = 16
mouse-hide-while-typing = true
window-padding-x = 8
window-padding-y = 8

# new_window instead of macOS tab: each tab is a separate NSWindow that
# halves the aerospace tile. cmd-t / cmd-n always make a fresh tile.
keybind = cmd+t=new_window
keybind = cmd+n=new_window
