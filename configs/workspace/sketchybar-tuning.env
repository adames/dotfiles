# Optional shell-side tuning for the workspace pill strip.
# Sourced by ~/.config/sketchybar/plugins/recenter.sh on every layout pass.
# Override location: WS_TUNING_CONF env var.

# ── Notch padding ────────────────────────────────────────────────────────
# Extra clearance (in points) beyond what NSScreen.auxiliaryTopLeft/RightArea
# reports. Apple's safe-area rect is sometimes a few points off from the
# visible edge of the physical camera housing.
#
# Precedence (per side): a side-specific variable beats the symmetric
# shortcut. Empty values inherit the symmetric default.
#
#   WS_NOTCH_PADDING_PT     symmetric shortcut — applies to both sides
#                           equally. Use this when the housing is uniformly
#                           wider than what macOS reports.
#
#   WS_NOTCH_PAD_LEFT_PT    overrides the LEFT side only. Use when the
#                           physical housing extends further left than the
#                           safe-area rect (left pills appear too close to
#                           the cutout).
#
#   WS_NOTCH_PAD_RIGHT_PT   same, for the right side.
#
# Visual effect with N=8 pills (4 + 4 split) on a 663pt aux-left:
#   PADDING_PT=0                       → left half ends at notch_x,
#                                        right half starts at notch_x + notch_w + 8
#   PADDING_PT=8                       → both halves shift 8pt away from notch
#   PAD_LEFT_PT=12, PAD_RIGHT_PT=4     → left pills 12pt away, right pills 4pt away
#                                        (asymmetric — for a notch shifted left)
WS_NOTCH_PADDING_PT=16
# WS_NOTCH_PAD_LEFT_PT=
# WS_NOTCH_PAD_RIGHT_PT=
