# Optional shell-side tuning for the workspace pill strip.
# Sourced by ~/.config/sketchybar/plugins/recenter.sh on every layout pass.
# Override location: WS_TUNING_CONF env var.

# Extra clearance (in points) added to EACH side of the camera notch
# beyond what NSScreen.auxiliaryTopLeft/RightArea reports. Apple's
# safe-area rect is sometimes a few points off from the visible edge
# of the physical notch; bump this up if pills look like they're being
# clipped or tucked against the housing.
#
# Effect with N=8 pills (4 + 4 split):
#   value=0  → left half ends at notch_x, right half starts at notch_x + notch_w + LEFT_MARGIN
#   value=6  → left half ends at notch_x − 6, right half starts at notch_x + notch_w + 6 + LEFT_MARGIN
#   value=-4 → pills move CLOSER to the notch (use if you want tighter visual coupling)
WS_NOTCH_PADDING_PT=16
