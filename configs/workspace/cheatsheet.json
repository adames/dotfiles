{
  "_doc": "Cheatsheet content for ws-cheatsheet (Caps+; overlay). Schema v2: each section has a `family` (system|terminal|vim|nvim|git) that drives both color and band placement, plus an `idea` mental-model caption and optional `customLayout`. Edit freely — the binary reads this on every toggle so no rebuild needed. Sections render inside family bands, top→bottom.",
  "banner": [
    {"k": "caps",        "v": "tap → Esc"},
    {"k": "caps + …",    "v": "Hyper (⌃⌥⌘⇧)  ·  +shift = Mod"},
    {"k": "C-Space …",   "v": "Tmux prefix"},
    {"k": "⟨leader⟩ …",  "v": "space · Neovim leader"}
  ],
  "sections": [
    {
      "family": "system",
      "color": "#60a5fa",
      "title": "Windows · Spaces",
      "sub": "yabai · skhd · ws-snap",
      "idea": "Hyper navigates; Mod modifies. New windows arrive on the focused space + focused; floats are centered. Unfloat to commit, go to relocate, ⌘W to dismiss.",
      "rows": [
        ["caps + hjkl",           "focus window  ←  ↓  ↑  →"],
        ["caps + shift + hjkl",   "swap window  ←  ↓  ↑  →"],
        ["caps + e",              "expose / window picker — fuzzy-search every window"],
        ["caps + v",              "toggle float / unfloat  (unfloat = commit to tiling)"],
        ["caps + shift + v",      "center floating window  (50% inner grid)"],
        ["caps + r",              "rotate space 90°"],
        ["caps + shift + r",      "rebalance space (equal BSP splits)"],
        ["caps + n  ·  caps + p", "next / prev workspace (wraps)"],
        ["caps + tab",            "last / recent workspace"]
      ]
    },
    {
      "family": "system",
      "color": "#60a5fa",
      "title": "Workspace · Slots",
      "sub": "number = stable selector · names/icons are cosmetic",
      "idea": "Three overlays. Digit (1..0) commits instantly; type letters to fuzzy-search names + Enter. Esc and click-elsewhere always cancel.",
      "rows": [
        ["caps + w",              "focus prompt → digit · letters → name search + ↵"],
        ["caps + g  ·  caps + m", "go / move prompt → digit (commit + follow) · letters + ↵"],
        ["caps + shift + w",      "manage prompt → a add · r rename · i icon · d destroy"],
        ["    (in manage)",       "⇧L layout save/load/delete · v verify · ? doctor"],
        ["esc / click-elsewhere", "cancel any prompt"],
        ["—",                     "names cannot start with a digit · all-numeric query = slot index (11+)"]
      ]
    },
    {
      "family": "system",
      "color": "#60a5fa",
      "title": "Launch",
      "sub": "skhd · auto-detected apps",
      "idea": "Each chord spawns a new window of an auto-detected app. Override the choice with $WS_* env vars.",
      "rows": [
        ["caps + t",          "new terminal  (auto: Ghostty / iTerm / …; $WS_TERMINAL_APP)"],
        ["caps + b",          "new browser  (auto: Brave / Arc / … / Safari; $WS_BROWSER_APP)"],
        ["caps + o",          "new Finder window  (o = open)"],
        ["caps + ,",          "System Settings"],
        ["caps + q",          "notes  (auto: Raycast Notes → Apple Notes; $WS_NOTES_APP)"],
        ["caps + shift + q",  "inbox  (auto: Obsidian → Apple Notes; $WS_INBOX_APP / $WS_INBOX_VAULT)"],
        ["caps + ;",          "this cheatsheet (toggle)"]
      ]
    },

    {
