        ["C-Space  0…9",       "go to window N"],
        ["C-Space  x",         "kill pane  (no confirmation)"],
        ["C-Space  &",         "kill window  (no confirmation)"],
        ["C-Space  $",         "rename current session"],
        ["C-Space  C-Space",   "send literal C-Space to inner program (nvim cmp)"]
      ]
    },
