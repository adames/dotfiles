#!/usr/bin/env bash
# workspace — CLI for the 10-slot (extensible) workspace identity layer.
#
# Mutates ~/.config/workspace/spaces.json atomically (mktemp + jq + mv),
# fires the cascade (on-space-changed.sh) so tmux / starship / borders /
# sketchybar / hammerspoon repaint, and invokes the optional
# ~/.config/workspace/hooks/post-mutate.sh as an extension point for
# other programs.
#
# Slot-count agnostic: every subcommand derives the current count from
# the JSON itself, not a hardcoded constant.
#
# Stable contract for callers:
#   exit codes  0 success · 1 runtime error · 2 usage error
#   env overrides  WS_CONFIG, WS_THEMES_DIR, WS_HANDLER, WS_HOOK
#   --json available on  status · get · themes

set -u

# Resolve WS_CONFIG via the per-host overlay helper (falls back to the
# shared spaces.json when no host-specific file exists). Sourced before
# any other default-resolution so subsequent `${WS_CONFIG:-…}` defaults
# don't clobber the host overlay.
if [[ -r "$HOME/.config/workspace/lib/resolve-config.sh" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.config/workspace/lib/resolve-config.sh"
fi

WS_CONFIG="${WS_CONFIG:-$HOME/.config/workspace/spaces.json}"
WS_THEMES_DIR="${WS_THEMES_DIR:-$HOME/.config/workspace/themes}"
WS_HANDLER="${WS_HANDLER:-$HOME/.config/workspace/on-space-changed.sh}"
WS_HOOK="${WS_HOOK:-$HOME/.config/workspace/hooks/post-mutate.sh}"
WS_DEFAULTS="${WS_DEFAULTS:-$HOME/.config/workspace/spaces.default.json}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

# Common helpers if available; tiny stubs otherwise so the CLI stays
# usable on machines without the dotfiles tree.
if [[ -r "$DOTFILES_DIR/lib/common.sh" ]]; then
  # shellcheck source=/dev/null
  . "$DOTFILES_DIR/lib/common.sh"
else
  ok()   { :; }
  step() { :; }
  info() { :; }
  err()  { printf 'ws: %s\n' "$*" >&2; }
  warn() { printf 'ws: %s\n' "$*" >&2; }
  have() { command -v "$1" >/dev/null 2>&1; }
fi

have() { command -v "$1" >/dev/null 2>&1; }   # ensure available regardless

# ── helpers ─────────────────────────────────────────────────────────────

_require_config() {
  [[ -r "$WS_CONFIG" ]] || { err "spaces.json not found: $WS_CONFIG"; exit 1; }
  jq -e . "$WS_CONFIG" >/dev/null 2>&1 || { err "spaces.json is not valid JSON"; exit 1; }
}

_count() { jq '.spaces | keys | map(tonumber) | length' "$WS_CONFIG"; }

# Accept either a numeric slot index OR a slot name. Print the resolved
# slot index to stdout. Exit 2 on no-match / ambiguous.
_resolve_slot() {
  local input="$1"
  local n; n=$(_count)
  if [[ "$input" =~ ^[1-9][0-9]*$ ]]; then
    if (( input >= 1 && input <= n )); then
      printf '%s\n' "$input"
      return 0
    fi
    err "slot index out of range: $input (have $n slots)"
    exit 2
  fi
  # Name lookup. Names must match exactly; uniqueness is enforced.
  local matches
  matches=$(jq -r --arg q "$input" '
    .spaces | to_entries | map(select(.value.name == $q) | .key) | .[]
  ' "$WS_CONFIG")
  local n_matches
  n_matches=$(printf '%s' "$matches" | grep -c '^[0-9]' || true)
  if (( n_matches == 1 )); then
    printf '%s\n' "$matches"
    return 0
  elif (( n_matches == 0 )); then
    err "no slot matches '$input' (use a 1..$n index or an exact slot name)"
    exit 2
  else
    err "ambiguous: name '$input' matches multiple slots ($(echo "$matches" | tr '\n' ' '))"
    exit 2
  fi
}

# Legacy name kept for back-compat with existing callsites. Exits on
# failure; otherwise sets nothing (callers that need the resolved index
# should use _resolve_slot directly).
_validate_slot() { _resolve_slot "$1" >/dev/null; }

_validate_color() {
  [[ "$1" =~ ^#[0-9a-fA-F]{6}$ ]] || { err "color must be #RRGGBB (got: $1)"; exit 2; }
}

_fire_post() {
  # Backgrounded; failures never abort the caller.
  if [[ -x "$WS_HOOK" ]]; then
    ( "$WS_HOOK" "$@" >/dev/null 2>&1 & ) 2>/dev/null
  fi
}

_fire_cascade() {
  if [[ -x "$WS_HANDLER" ]]; then
    ( "$WS_HANDLER" >/dev/null 2>&1 & ) 2>/dev/null
  fi
}

# Canonical ordering filter run after every mutation. Sorts .spaces
# keys numerically (so 10 comes after 9, not after 1) and writes each
# slot's (name, color) fields in that order. iconSpec (v2) and any
# user-added extras land after, untouched. The legacy `.icon` raw-glyph
# field is actively dropped: with the cascade fully v2-aware
# (on-space-changed.sh and space.sh both prefer iconSpec.codepoint), no
# reader depends on it, so retiring the field keeps diffs clean.
_NORMALIZE='
  .spaces as $s
  | .spaces = (
      reduce ($s | keys | map(tonumber) | sort | map(tostring))[] as $k ({};
        .[$k] = (
          ($s[$k] | {name, color} | with_entries(select(.value != null)))
          + ($s[$k] | del(.name, .color, .icon))
        )
      )
    )
'

# _write <jq-program> [jq-args...]  — atomic mktemp + jq + normalize + validate + mv.
_write() {
  local prog="$1"; shift
  local tmp; tmp=$(mktemp) || { err "mktemp failed"; exit 1; }
  if ! jq "$@" "$prog" "$WS_CONFIG" | jq "$_NORMALIZE" > "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    err "jq transformation failed"
    exit 1
  fi
  if ! jq -e . "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    err "produced invalid JSON (refusing to write)"
    exit 1
  fi
  mv -f "$tmp" "$WS_CONFIG"
}

# Truecolor swatch helper. Mirrors on-space-changed.sh:78-83.
_swatch() {
  local hex="${1#\#}" r g b
  r=$(( 16#${hex:0:2} ))
  g=$(( 16#${hex:2:2} ))
  b=$(( 16#${hex:4:2} ))
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    printf '\033[38;2;%d;%d;%dm▓▓▓\033[0m' "$r" "$g" "$b"
  else
    printf '   '
  fi
}

# Prompt yes/no; returns 0 on yes. Non-tty defaults to no unless -y was passed.
_confirm() {
  local msg="$1" yes="${2:-0}"
  if (( yes )); then return 0; fi
  if [[ ! -t 0 ]]; then return 1; fi
  local ans
  printf '%s [y/N] ' "$msg" >&2
  read -r ans
  [[ "$ans" =~ ^[Yy]$ ]]
}

# ── subcommands ─────────────────────────────────────────────────────────

cmd_help() {
  cat <<'EOF_HELP'
workspace — manage the workspace identity (name / icon) of each slot.

Colors are positional: slot N keeps its color across moves and reorders.
(name, icon) are what flow when you swap / move / rotate / reverse /
reorder. Use `workspace color N #HEX` to change a slot's color directly.

USAGE
  workspace <subcommand> [args]
  (anywhere a slot is expected, you can pass either an index or a unique name)

INSPECTION
  status [--json]            list all slots with color swatches
  get <SLOT> [--json]        dump slot as JSON
  count                      print current slot count
  themes [--json]            list available themes
  doctor                     validate spaces.json schema
  verify                     run end-to-end cascade tests

MUTATION  (every mutation fires the cascade + post-mutate hook)
  name <SLOT> <NEW_NAME>           rename a slot
  color <SLOT> <#HEX>              set slot color
  icon <SLOT> <GLYPH>              set slot icon
  add [NAME] [COLOR] [ICON]        append a new slot
  remove <SLOT> [-y]               delete a slot, renumber the rest
  swap <A> <B>                     swap two slots' (name, icon)
  move <SRC> <DEST>                move SRC to position DEST
  move <SRC> before|after <REF>    move SRC adjacent to REF (natural-language)
  rotate [N]                       shift all (name, icon) by N positions (default 1, signed)
  reverse                          reverse the slot order
  reorder <s1> ... <sN>            permute by full source-slot list
  theme <NAME> [--with-icons]      apply a palette to all slots
  edit                             open spaces.json in $EDITOR
  reset [-y]                       restore spaces.json from spaces.default.json

LAYOUTS  (named snapshots, per-machine)
  layout save <NAME>               snapshot current state
  layout load <NAME> [-y]          restore a saved snapshot
  layout list                      list saved layouts
  layout delete <NAME> [-y]        remove a saved layout

ENV OVERRIDES
  WS_CONFIG       path to spaces.json     (default: ~/.config/workspace/spaces.json)
  WS_THEMES_DIR   themes directory        (default: ~/.config/workspace/themes)
  WS_HANDLER      cascade entry point     (default: ~/.config/workspace/on-space-changed.sh)
  WS_HOOK         post-mutate hook        (default: ~/.config/workspace/hooks/post-mutate.sh)
  WS_LAYOUTS_DIR  layouts directory       (default: ~/.config/workspace/layouts)

EXIT CODES
  0 success · 1 runtime error · 2 usage error

Hotkey note: skhd binds Caps+1..0 to spaces 1..10. Slots beyond 10 have
no hotkey by default; bind them manually in ~/.skhdrc if desired.
EOF_HELP
}

cmd_status() {
  _require_config
  local json=0
  [[ "${1:-}" == "--json" ]] && json=1
  if (( json )); then
    jq '.spaces' "$WS_CONFIG"
    return
  fi
  local n; n=$(_count)
  printf '%-3s %-4s %-12s %-9s %s\n' '#' 'ICON' 'NAME' 'COLOR' ''
  local i
  for (( i=1; i<=n; i++ )); do
    local entry name color icon
    entry=$(jq -c --arg k "$i" '.spaces[$k]' "$WS_CONFIG")
    name=$(jq -r --arg k "$i" '.spaces[$k].name // ""' "$WS_CONFIG")
    color=$(jq -r --arg k "$i" '.spaces[$k].color // "#cdd6f4"' "$WS_CONFIG")
    icon=$(jq -r --arg k "$i" '.spaces[$k].icon // ""' "$WS_CONFIG")
    printf '%-3s %-4s %-12s %-9s %s\n' "$i" "$icon" "$name" "$color" "$(_swatch "$color")"
    : "$entry"  # silence
  done
}

cmd_get() {
  _require_config
  [[ $# -ge 1 ]] || { err "usage: workspace get <SLOT_OR_NAME> [--json]"; exit 2; }
  local slot; slot=$(_resolve_slot "$1") || exit $?
  jq --arg k "$slot" '.spaces[$k]' "$WS_CONFIG"
}

cmd_count() {
  _require_config
  _count
}

cmd_themes() {
  local json=0
  [[ "${1:-}" == "--json" ]] && json=1
  local names=()
  if [[ -d "$WS_THEMES_DIR" ]]; then
    local f
    for f in "$WS_THEMES_DIR"/*.json; do
      [[ -f "$f" ]] || continue
      names+=("$(basename "$f" .json)")
    done
  fi
  if (( json )); then
    printf '%s\n' "${names[@]:-}" | jq -R . | jq -s .
  else
    printf '%s\n' "${names[@]:-}"
  fi
}

cmd_name() {
  _require_config
  [[ $# -eq 2 ]] || { err "usage: workspace name <SLOT_OR_NAME> <NEW_NAME>"; exit 2; }
  local slot; slot=$(_resolve_slot "$1") || exit $?
  _write '.spaces[$k] = ((.spaces[$k] // {}) + {name: $v})' --arg k "$slot" --arg v "$2"
  _fire_post name "$slot"
  _fire_cascade
}

cmd_color() {
  _require_config
  [[ $# -eq 2 ]] || { err "usage: workspace color <SLOT_OR_NAME> <#HEX>"; exit 2; }
  local slot; slot=$(_resolve_slot "$1") || exit $?
  _validate_color "$2"
  _write '.spaces[$k] = ((.spaces[$k] // {}) + {color: $v})' --arg k "$slot" --arg v "$2"
  _fire_post color "$slot"
  _fire_cascade
}

cmd_icon() {
  _require_config
  [[ $# -eq 2 ]] || { err "usage: workspace icon <SLOT_OR_NAME> <GLYPH>"; exit 2; }
  local slot; slot=$(_resolve_slot "$1") || exit $?
  local glyph="$2"

  # Derive the ASCII-escaped codepoint for v2 iconSpec persistence.
  # BMP scalars (U+E000..U+F8FF — where most Nerd Font glyphs live) get
  # "\uXXXX"; supplementary plane gets "\u{XXXXX}". Python program is
  # inline via `-c` rather than heredoc so the pipe-redirected stdin
  # carries the glyph bytes (heredocs clobber pipe redirection).
  local escaped=""
  if [[ -n "$glyph" ]]; then
    local form="" hex=""
    read -r form hex < <(
      printf '%s' "$glyph" | python3 -c '
import sys
s = sys.stdin.read()
if s:
    cp = ord(s[0])
    if cp <= 0xFFFF:
        print("B", f"{cp:04x}")
    else:
        print("S", f"{cp:X}")
' 2>/dev/null
    )
    case "$form" in
      B) escaped="\\u${hex}" ;;
      S) escaped="\\u{${hex}}" ;;
    esac
  fi

  # Update iconSpec.codepoint and flip userOverridden=true. The flip is
  # the postmortem rule: an explicit user-chosen icon must survive
  # subsequent renames; auto-iconing only regenerates while
  # userOverridden=false. If iconSpec doesn't exist (unmigrated slot),
  # the merge is a no-op — run `ws-topology migrate --apply` first.
  _write '
    .spaces[$k] = (
      (.spaces[$k] // {}) as $s
      | $s
      + (
          if $s.iconSpec then
            { iconSpec: ($s.iconSpec
              + (if $cp != "" then {codepoint: $cp, kind: "nerdFont"} else {} end)
              + {userOverridden: true}) }
          else {} end
        )
    )
  ' --arg k "$slot" --arg cp "$escaped"
  _fire_post icon "$slot"
  _fire_cascade
}

cmd_migrate() {
  # Thin delegate to ws-topology. Accepts the same flags (--apply,
  # --rollback). Dry-run by default; --apply backs up to spaces.v1.json
  # then writes v2.
  if ! command -v ws-topology >/dev/null 2>&1; then
    err "ws-topology not on PATH (build + symlink from ~/.config/workspace/topology)"
    exit 1
  fi
  ws-topology migrate "$@"
}

# ── host overlay management ─────────────────────────────────────────────
# Per-host workspace identity: ~/.config/workspace/spaces.<hostname>.json
# overrides ~/.config/workspace/spaces.json on this machine. Both files
# are valid v2 configs; the overlay simply takes precedence when present.
# Useful for divergent slot identities between machines (the M3 Max and
# the M1 13" may want different slot 8 names, for instance).

_host_short() { hostname -s 2>/dev/null || echo unknown; }
_host_file()  { printf '%s/.config/workspace/spaces.%s.json' "$HOME" "$1"; }

cmd_host() {
  local sub="${1:-status}"; shift 2>/dev/null || true
  case "$sub" in
    status|"")  _host_status ;;
    init)       _host_init "$@" ;;
    reset)      _host_reset "$@" ;;
    list)       _host_list ;;
    *)
      err "usage: workspace host {status|init [HOST]|reset [HOST]|list}"
      exit 2 ;;
  esac
}

_host_status() {
  local h; h=$(_host_short)
  local hf; hf=$(_host_file "$h")
  printf 'hostname     %s\n' "$h"
  printf 'effective    %s\n' "$WS_CONFIG"
  if [[ -r "$hf" ]]; then
    printf 'overlay      yes (%s)\n' "$hf"
  else
    printf 'overlay      no (would be %s)\n' "$hf"
  fi
}

_host_init() {
  local target="${1:-$(_host_short)}"
  local hf; hf=$(_host_file "$target")
  if [[ -e "$hf" ]]; then
    err "$hf already exists; refusing to overwrite (use 'workspace host reset $target' first)"
    exit 1
  fi
  local shared="$HOME/.config/workspace/spaces.json"
  if [[ ! -r "$shared" ]]; then
    err "shared $shared not found; nothing to fork from"
    exit 1
  fi
  cp "$shared" "$hf"
  printf 'forked %s → %s\n' "$shared" "$hf" >&2
  printf '%s\n' "$hf"
  _fire_cascade
}

_host_reset() {
  local target="${1:-$(_host_short)}"
  local hf; hf=$(_host_file "$target")
  if [[ ! -e "$hf" ]]; then
    printf 'no overlay at %s; nothing to remove\n' "$hf" >&2
    return 0
  fi
  rm -f "$hf"
  printf 'removed %s (now falling back to shared spaces.json)\n' "$hf" >&2
  _fire_cascade
}

_host_list() {
  local dir="$HOME/.config/workspace"
  local active="$WS_CONFIG"
  find "$dir" -maxdepth 1 -name 'spaces*.json' -type f 2>/dev/null \
    | sort \
    | while read -r f; do
        local marker=" "
        [[ "$f" == "$active" ]] && marker="*"
        printf '%s %s\n' "$marker" "$f"
      done
}

# Optional sourcing of WORKSPACE_LABELS for default add names.
_label_for_slot() {
  local slot="$1"
  local labels_src=""
  if [[ -r "$DOTFILES_DIR/lib/colors.sh" ]]; then
    labels_src="$DOTFILES_DIR/lib/colors.sh"
  elif [[ -r "$HOME/.config/workspace/lib/colors.sh" ]]; then
    labels_src="$HOME/.config/workspace/lib/colors.sh"
  fi
  if [[ -n "$labels_src" ]]; then
    # shellcheck source=/dev/null
    ( . "$labels_src"
      if (( slot >= 1 && slot <= ${#WORKSPACE_LABELS[@]} )); then
        printf '%s' "${WORKSPACE_LABELS[$((slot-1))]}"
      fi
    )
  fi
}

cmd_add() {
  _require_config
  local n new_slot name color icon
  n=$(_count)
  new_slot=$((n + 1))
  name="${1:-}"
  color="${2:-#cdd6f4}"
  icon="${3:-}"
  if [[ -z "$name" ]]; then
    name=$(_label_for_slot "$new_slot")
    [[ -z "$name" ]] && name="ws${new_slot}"
  fi
  _validate_color "$color"
  _write '
    .spaces[$k] = {name: $n, color: $c, icon: $i}
  ' --arg k "$new_slot" --arg n "$name" --arg c "$color" --arg i "$icon"
  _fire_post add "$new_slot"
  _fire_cascade
  # Best-effort: keep yabai's space count in sync. Silent on absence and
  # on failure (e.g., scripting-addition not loaded). Disable with
  # WS_ADD_GROW_YABAI=0.
  if [[ "${WS_ADD_GROW_YABAI:-1}" == 1 ]] && have yabai && pgrep -x yabai >/dev/null 2>&1; then
    local ensure="$HOME/.config/workspace/yabai-ensure-spaces.sh"
    [[ -x "$ensure" ]] || ensure="$DOTFILES_DIR/configs/yabai-ensure-spaces.sh"
    if [[ -x "$ensure" ]]; then
      ( "$ensure" "$new_slot" >/dev/null 2>&1 & ) 2>/dev/null
    fi
  fi
}

cmd_remove() {
  _require_config
  local yes=0
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes) yes=1 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  [[ ${#args[@]} -eq 1 ]] || { err "usage: workspace remove <SLOT_OR_NAME> [-y]"; exit 2; }
  local slot; slot=$(_resolve_slot "${args[0]}") || exit $?
  local n; n=$(_count)
  if (( n <= 1 )); then
    err "refusing to remove last slot (count would go to 0)"
    exit 1
  fi
  _confirm "remove slot $slot and renumber slots $((slot+1))..$n down by 1?" "$yes" \
    || { warn "aborted"; exit 1; }
  _write '
    . as $orig
    | ($orig.spaces | keys | map(tonumber) | max) as $n
    | .spaces = (
        reduce range(1; $n+1) as $i ({};
          if $i < ($slot|tonumber) then
            .[($i|tostring)] = $orig.spaces[($i|tostring)]
          elif $i == ($slot|tonumber) then
            .
          else
            .[(($i-1)|tostring)] = $orig.spaces[($i|tostring)]
          end
        )
      )
  ' --arg slot "$slot"
  _fire_post remove "$slot"
  _fire_cascade
}

cmd_swap() {
  _require_config
  [[ $# -eq 2 ]] || { err "usage: workspace swap <SLOT_OR_NAME> <SLOT_OR_NAME>"; exit 2; }
  local a b
  a=$(_resolve_slot "$1") || exit $?
  b=$(_resolve_slot "$2") || exit $?
  if [[ "$a" == "$b" ]]; then return 0; fi
  # Positional colors: name+icon swap, color stays at slot index.
  _write '
    . as $orig
    | .spaces[$a] = (($orig.spaces[$a] // {}) | {color}) + (($orig.spaces[$b] // {}) | {name, icon})
    | .spaces[$b] = (($orig.spaces[$b] // {}) | {color}) + (($orig.spaces[$a] // {}) | {name, icon})
  ' --arg a "$a" --arg b "$b"
  _fire_post swap "$a" "$b"
  _fire_cascade
}

cmd_reorder() {
  _require_config
  local n; n=$(_count)
  if [[ $# -ne $n ]]; then
    err "reorder requires exactly $n args (current slot count); got $#"
    exit 2
  fi
  # Resolve each arg (accepts names or indices) into a normalized
  # numeric permutation. Validate: must be a permutation of 1..n.
  local resolved=()
  local i seen=""
  for (( i=1; i<=$#; i++ )); do
    local r
    r=$(_resolve_slot "${!i}") || exit $?
    if [[ ",$seen," == *",$r,"* ]]; then
      err "reorder arg $i = '${!i}' resolves to slot $r, which is a duplicate"
      exit 2
    fi
    seen="$seen,$r"
    resolved+=("$r")
  done
  local args_json
  args_json=$(printf '%s\n' "${resolved[@]}" | jq -Rn '[inputs | tonumber]')
  # Positional colors: only (name, icon) move; color stays at slot index.
  _write '
    . as $orig
    | .spaces = (
        reduce range(0; ($args | length)) as $i ({};
          .[($i+1|tostring)] = (
            (($orig.spaces[($i+1|tostring)] // {}) | {color})
            + (($orig.spaces[($args[$i]|tostring)] // {}) | {name, icon})
          )
        )
      )
  ' --argjson args "$args_json"
  _fire_post reorder "${resolved[@]}"
  _fire_cascade
}

# Apply a numeric permutation array (each entry = source slot for that
# destination index, 1..N) to .spaces with positional-color semantics.
# Used by move / rotate / reverse to keep the jq path single-sourced.
_apply_perm() {
  # _apply_perm <subcommand-label> <slot1> <slot2> ... <slotN>
  local label="$1"; shift
  local n; n=$(_count)
  if [[ $# -ne $n ]]; then
    err "internal: _apply_perm got $# args, expected $n"
    exit 1
  fi
  local args_json
  args_json=$(printf '%s\n' "$@" | jq -Rn '[inputs | tonumber]')
  _write '
    . as $orig
    | .spaces = (
        reduce range(0; ($args | length)) as $i ({};
          .[($i+1|tostring)] = (
            (($orig.spaces[($i+1|tostring)] // {}) | {color})
            + (($orig.spaces[($args[$i]|tostring)] // {}) | {name, icon})
          )
        )
      )
  ' --argjson args "$args_json"
  _fire_post "$label" "$@"
  _fire_cascade
}

cmd_move() {
  _require_config
  [[ $# -ge 2 ]] || { err "usage: workspace move <SRC> <DEST>  |  move <SRC> before|after <REF>"; exit 2; }
  local n; n=$(_count)
  local src; src=$(_resolve_slot "$1") || exit $?
  shift
  local dest=""
  if [[ "$1" == "before" || "$1" == "after" ]]; then
    [[ $# -eq 2 ]] || { err "usage: workspace move <SRC> $1 <REF>"; exit 2; }
    local direction="$1" ref
    ref=$(_resolve_slot "$2") || exit $?
    if [[ "$src" == "$ref" ]]; then return 0; fi
    # Build the list of all slots minus src, find ref's new position,
    # then compute dest position (1-indexed in the final list).
    local without_src=()
    local i
    for (( i=1; i<=n; i++ )); do
      [[ "$i" != "$src" ]] && without_src+=("$i")
    done
    local ref_pos=0
    for (( i=0; i<${#without_src[@]}; i++ )); do
      if [[ "${without_src[$i]}" == "$ref" ]]; then ref_pos=$((i+1)); break; fi
    done
    if [[ "$direction" == "before" ]]; then dest=$ref_pos; else dest=$((ref_pos + 1)); fi
  else
    [[ $# -eq 1 ]] || { err "usage: workspace move <SRC> <DEST>  |  move <SRC> before|after <REF>"; exit 2; }
    if ! [[ "$1" =~ ^[1-9][0-9]*$ ]] || (( $1 < 1 )) || (( $1 > n )); then
      err "destination must be 1..$n (got: $1)"; exit 2
    fi
    dest="$1"
    if [[ "$src" == "$dest" ]]; then return 0; fi
  fi
  # Compose final permutation: without_src with src inserted at dest.
  local without_src=()
  local i
  for (( i=1; i<=n; i++ )); do
    [[ "$i" != "$src" ]] && without_src+=("$i")
  done
  local perm=()
  for (( i=0; i<${#without_src[@]}; i++ )); do
    if (( i+1 == dest )); then perm+=("$src"); fi
    perm+=("${without_src[$i]}")
  done
  if (( dest > ${#without_src[@]} )); then perm+=("$src"); fi
  _apply_perm move "${perm[@]}"
}

cmd_rotate() {
  _require_config
  local n; n=$(_count)
  local k="${1:-1}"
  if ! [[ "$k" =~ ^-?[0-9]+$ ]]; then err "rotate takes an integer step (got: $k)"; exit 2; fi
  # Normalize k into [0, n)
  k=$(( ((k % n) + n) % n ))
  if (( k == 0 )); then return 0; fi
  # Right rotation: new[i] = old[((i-1 - k + n) mod n) + 1]
  local perm=() i src
  for (( i=1; i<=n; i++ )); do
    src=$(( ((i - 1 - k + n) % n) + 1 ))
    perm+=("$src")
  done
  _apply_perm rotate "${perm[@]}"
}

cmd_reverse() {
  _require_config
  local n; n=$(_count)
  local perm=() i
  for (( i=n; i>=1; i-- )); do perm+=("$i"); done
  _apply_perm reverse "${perm[@]}"
}

cmd_layout() {
  _require_config
  local layouts_dir="${WS_LAYOUTS_DIR:-$HOME/.config/workspace/layouts}"
  mkdir -p "$layouts_dir"
  local sub="${1:-}"; shift || true
  case "$sub" in
    save)
      [[ $# -eq 1 ]] || { err "usage: workspace layout save <NAME>"; exit 2; }
      [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || { err "layout name must be [A-Za-z0-9._-]+"; exit 2; }
      local dest="$layouts_dir/$1.json"
      local tmp; tmp=$(mktemp) || { err "mktemp failed"; exit 1; }
      cp "$WS_CONFIG" "$tmp" && mv -f "$tmp" "$dest"
      ok "saved layout ${dest/#$HOME/~}"
      ;;
    load)
      local name="" yes=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -y|--yes) yes=1 ;;
          *) [[ -z "$name" ]] && name="$1" || { err "unexpected arg: $1"; exit 2; } ;;
        esac
        shift
      done
      [[ -n "$name" ]] || { err "usage: workspace layout load <NAME> [-y]"; exit 2; }
      local src="$layouts_dir/$name.json"
      [[ -r "$src" ]] || { err "layout not found: $src"; exit 1; }
      jq -e . "$src" >/dev/null 2>&1 || { err "layout is malformed JSON: $src"; exit 1; }
      _confirm "replace spaces.json with layout '$name'?" "$yes" \
        || { warn "aborted"; exit 1; }
      local tmp; tmp=$(mktemp) || { err "mktemp failed"; exit 1; }
      cp "$src" "$tmp" && mv -f "$tmp" "$WS_CONFIG"
      _fire_post layout "$name"
      _fire_cascade
      ;;
    list)
      local f
      for f in "$layouts_dir"/*.json; do
        [[ -f "$f" ]] && basename "$f" .json
      done
      ;;
    delete|rm)
      local name="" yes=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -y|--yes) yes=1 ;;
          *) [[ -z "$name" ]] && name="$1" || { err "unexpected arg: $1"; exit 2; } ;;
        esac
        shift
      done
      [[ -n "$name" ]] || { err "usage: workspace layout delete <NAME> [-y]"; exit 2; }
      local target="$layouts_dir/$name.json"
      [[ -e "$target" ]] || { err "layout not found: $target"; exit 1; }
      _confirm "delete layout '$name'?" "$yes" || { warn "aborted"; exit 1; }
      rm -f "$target"
      ok "deleted ${target/#$HOME/~}"
      ;;
    ""|-h|--help|help)
      cat <<'EOF_LAYOUT'
workspace layout — save / load / list named snapshots of spaces.json

  workspace layout save <NAME>          snapshot current state
  workspace layout load <NAME> [-y]     restore a saved snapshot
  workspace layout list                 list saved layouts
  workspace layout delete <NAME> [-y]   remove a saved layout

Layouts are stored in ~/.config/workspace/layouts/<NAME>.json (or
$WS_LAYOUTS_DIR if set). They are per-machine and not committed.
EOF_LAYOUT
      ;;
    *)
      err "unknown layout subcommand: $sub"; exit 2 ;;
  esac
}

cmd_theme() {
  _require_config
  local name="" with_icons=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --with-icons) with_icons=1 ;;
      -*) err "unknown flag: $1"; exit 2 ;;
      *) [[ -z "$name" ]] && name="$1" || { err "unexpected arg: $1"; exit 2; } ;;
    esac
    shift
  done
  [[ -n "$name" ]] || { err "usage: workspace theme <NAME> [--with-icons]"; exit 2; }
  local theme_file="$WS_THEMES_DIR/$name.json"
  [[ -r "$theme_file" ]] || { err "theme not found: $theme_file"; exit 1; }
  jq -e . "$theme_file" >/dev/null 2>&1 || { err "theme is malformed JSON: $theme_file"; exit 1; }

  local n; n=$(_count)
  local apply_icons="false"
  (( with_icons )) && apply_icons="true"
  _write '
    . as $orig
    | ($theme[0].colors // []) as $tc
    | ($theme[0].icons  // []) as $ti
    | ($n | tonumber) as $count
    | .spaces = (
        reduce range(1; $count+1) as $i ($orig.spaces;
          .[($i|tostring)] = (
            (.[($i|tostring)] // {})
            + (if ($tc | length) >= $i then {color: $tc[$i-1]} else {} end)
            + (if ($apply_icons == "true") and ($ti | length) >= $i then {icon: $ti[$i-1]} else {} end)
          )
        )
      )
    | .palette = $name
  ' --slurpfile theme "$theme_file" --arg n "$n" --arg apply_icons "$apply_icons" --arg name "$name"
  _fire_post theme
  _fire_cascade
}

cmd_edit() {
  _require_config
  local editor="${EDITOR:-vi}"
  "$editor" "$WS_CONFIG"
  if ! jq -e . "$WS_CONFIG" >/dev/null 2>&1; then
    err "spaces.json is now malformed; refusing to fire cascade (fix the file or run 'workspace reset')"
    exit 1
  fi
  _fire_post edit
  _fire_cascade
}

cmd_reset() {
  local yes=0
  [[ "${1:-}" == "-y" || "${1:-}" == "--yes" ]] && yes=1
  [[ -r "$WS_DEFAULTS" ]] || { err "defaults file not found: $WS_DEFAULTS"; exit 1; }
  _confirm "reset spaces.json to defaults from $WS_DEFAULTS?" "$yes" \
    || { warn "aborted"; exit 1; }
  local tmp; tmp=$(mktemp) || { err "mktemp failed"; exit 1; }
  cp -f "$WS_DEFAULTS" "$tmp"
  jq -e . "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; err "defaults file is malformed"; exit 1; }
  mv -f "$tmp" "$WS_CONFIG"
  _fire_post reset
  _fire_cascade
}

cmd_doctor() {
  if [[ ! -r "$WS_CONFIG" ]]; then
    err "spaces.json not found: $WS_CONFIG"
    return 1
  fi
  if ! jq -e . "$WS_CONFIG" >/dev/null 2>&1; then
    err "spaces.json is not valid JSON"
    return 1
  fi
  local bad=0
  # Every slot has all three keys, and keys are contiguous 1..count.
  local report
  report=$(jq -r '
    .spaces as $s
    | ($s | keys | map(tonumber) | sort) as $ks
    | [ ($ks | length) as $n
      | $ks | to_entries[]
      | select(.value != (.key + 1))
      | "gap: expected slot \(.key + 1), found \(.value)"
      ] + [
        $s | to_entries[]
        | select(
            (.value.name | type) != "string" or
            (.value.color | type) != "string" or
            (.value.icon  | type) != "string"
          )
        | "slot \(.key): missing/wrong type for name|color|icon"
      ] + [
        $s | to_entries[]
        | select((.value.color // "") | test("^#[0-9a-fA-F]{6}$") | not)
        | "slot \(.key): color \"\(.value.color)\" is not #RRGGBB"
      ]
    | .[]
  ' "$WS_CONFIG" 2>/dev/null) || bad=1
  if [[ -n "$report" ]]; then
    while IFS= read -r line; do
      err "$line"
    done <<<"$report"
    bad=1
  fi
  # Soft-warn on duplicate names.
  local dups
  dups=$(jq -r '
    [.spaces[].name] | group_by(.) | map(select(length > 1) | .[0]) | .[]
  ' "$WS_CONFIG" 2>/dev/null)
  if [[ -n "$dups" ]]; then
    while IFS= read -r name; do
      warn "duplicate name: $name"
    done <<<"$dups"
  fi
  if (( bad )); then
    return 1
  fi
  ok "spaces.json schema OK ($( _count ) slots)"
}

cmd_verify() {
  local harness="$HOME/.config/workspace/cli/test-cascade.sh"
  if [[ ! -x "$harness" ]]; then
    harness="$DOTFILES_DIR/configs/workspace/cli/test-cascade.sh"
  fi
  if [[ ! -x "$harness" ]]; then
    err "test-cascade.sh not found (re-run bootstrap?)"
    exit 1
  fi
  exec "$harness" "$@"
}

# ── dispatch ────────────────────────────────────────────────────────────

case "${1:-}" in
  ""|-h|--help|help) cmd_help ;;
  status)            shift; cmd_status   "$@" ;;
  get)               shift; cmd_get      "$@" ;;
  count)             shift; cmd_count    "$@" ;;
  themes)            shift; cmd_themes   "$@" ;;
  name)              shift; cmd_name     "$@" ;;
  color)             shift; cmd_color    "$@" ;;
  icon)              shift; cmd_icon     "$@" ;;
  add)               shift; cmd_add      "$@" ;;
  remove)            shift; cmd_remove   "$@" ;;
  swap)              shift; cmd_swap     "$@" ;;
  move)              shift; cmd_move     "$@" ;;
  rotate)            shift; cmd_rotate   "$@" ;;
  reverse)           shift; cmd_reverse  "$@" ;;
  reorder)           shift; cmd_reorder  "$@" ;;
  theme)             shift; cmd_theme    "$@" ;;
  edit)              shift; cmd_edit     "$@" ;;
  reset)             shift; cmd_reset    "$@" ;;
  doctor)            shift; cmd_doctor   "$@" ;;
  verify)            shift; cmd_verify   "$@" ;;
  layout)            shift; cmd_layout   "$@" ;;
  migrate)           shift; cmd_migrate  "$@" ;;
  host)              shift; cmd_host     "$@" ;;
  *) err "unknown subcommand: $1 (try 'workspace --help')"; exit 2 ;;
esac
