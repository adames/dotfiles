#!/usr/bin/env bash
# ws — CLI for the per-display workspace pill strip. Mutates a workspace
# slot's identity (name / icon / color) and dispatches the cascade so
# every consumer (tmux, starship, borders, sketchybar) repaints in
# step. Formerly called `workspace`; the old name is kept as a compat
# symlink so older scripts and muscle-memory continue to work.
#
# Atomic spaces.json writes (mktemp + jq + mv), then on-space-changed.sh
# fires, then the optional ~/.config/workspace/hooks/post-mutate.sh runs
# as an extension point.
#
# Slot-count agnostic: every subcommand derives the current count from
# the JSON itself, not a hardcoded constant.
#
# Stable contract for callers:
#   exit codes  0 success · 1 runtime error · 2 usage error
#   env overrides  WS_CONFIG, WS_THEMES_DIR, WS_HANDLER, WS_HOOK
#   --json available on  status · get · themes

set -u

# Resolve WS_CONFIG via the per-host overlay helper (falls back to the
# shared spaces.json when no host-specific file exists). Sourced before
# any other default-resolution so subsequent `${WS_CONFIG:-…}` defaults
# don't clobber the host overlay.
if [[ -r "$HOME/.config/workspace/lib/resolve-config.sh" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.config/workspace/lib/resolve-config.sh"
fi

WS_CONFIG="${WS_CONFIG:-$HOME/.config/workspace/spaces.json}"
WS_THEMES_DIR="${WS_THEMES_DIR:-$HOME/.config/workspace/themes}"
WS_HANDLER="${WS_HANDLER:-$HOME/.config/workspace/on-space-changed.sh}"
WS_HOOK="${WS_HOOK:-$HOME/.config/workspace/hooks/post-mutate.sh}"
WS_DEFAULTS="${WS_DEFAULTS:-$HOME/.config/workspace/spaces.default.json}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

# Common helpers if available; tiny stubs otherwise so the CLI stays
# usable on machines without the dotfiles tree.
if [[ -r "$DOTFILES_DIR/lib/common.sh" ]]; then
  # shellcheck source=/dev/null
  . "$DOTFILES_DIR/lib/common.sh"
else
  ok()   { :; }
  step() { :; }
  info() { :; }
  err()  { printf 'ws: %s\n' "$*" >&2; }
  warn() { printf 'ws: %s\n' "$*" >&2; }
  have() { command -v "$1" >/dev/null 2>&1; }
fi

have() { command -v "$1" >/dev/null 2>&1; }   # ensure available regardless

# Shared helpers for codepoint unescape + hex→RGB. Stubs let the CLI keep
# working when the lib/ shipment hasn't landed (very fresh install).
if [[ -r "$HOME/.config/workspace/lib/icon-decode.sh" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.config/workspace/lib/icon-decode.sh"
else
  ws_decode_icon() { :; }
fi
if [[ -r "$HOME/.config/workspace/lib/hex-ansi.sh" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.config/workspace/lib/hex-ansi.sh"
else
  ws_hex_to_rgb() { printf '0 0 0\n'; }
fi

# ── helpers ─────────────────────────────────────────────────────────────

_require_config() {
  [[ -r "$WS_CONFIG" ]] || { err "spaces.json not found: $WS_CONFIG"; exit 1; }
  jq -e . "$WS_CONFIG" >/dev/null 2>&1 || { err "spaces.json is not valid JSON"; exit 1; }
}

_count() { jq '.spaces | keys | map(tonumber) | length' "$WS_CONFIG"; }

# Accept either a numeric slot index OR a slot name. Print the resolved
# slot index to stdout. Exit 2 on no-match / ambiguous.
_resolve_slot() {
  local input="$1"
  local n; n=$(_count)
  if [[ "$input" =~ ^[1-9][0-9]*$ ]]; then
    if (( input >= 1 && input <= n )); then
      printf '%s\n' "$input"
      return 0
    fi
    err "slot index out of range: $input (have $n slots)"
    exit 2
  fi
  # Name lookup. Names must match exactly; uniqueness is enforced.
  local matches
  matches=$(jq -r --arg q "$input" '
    .spaces | to_entries | map(select(.value.name == $q) | .key) | .[]
  ' "$WS_CONFIG")
  local n_matches
  n_matches=$(printf '%s' "$matches" | grep -c '^[0-9]' || true)
  if (( n_matches == 1 )); then
    printf '%s\n' "$matches"
    return 0
  elif (( n_matches == 0 )); then
    err "no slot matches '$input' (use a 1..$n index or an exact slot name)"
    exit 2
  else
    err "ambiguous: name '$input' matches multiple slots ($(echo "$matches" | tr '\n' ' '))"
    exit 2
  fi
}

# Legacy name kept for back-compat with existing callsites. Exits on
# failure; otherwise sets nothing (callers that need the resolved index
# should use _resolve_slot directly).
_validate_slot() { _resolve_slot "$1" >/dev/null; }

_validate_color() {
  [[ "$1" =~ ^#[0-9a-fA-F]{6}$ ]] || { err "color must be #RRGGBB (got: $1)"; exit 2; }
}

# Reject a name that is already in use on another slot. `add` calls this
# with no exclude. `name` passes the slot being renamed so the rename is
# allowed to keep its own value. Why: _resolve_slot fails closed on
# ambiguous matches (lines 96-104), so silently allowing duplicates here
# breaks slot-lookup-by-name downstream.
_validate_name_unique() {
  local name="$1" exclude="${2:-}"
  local hit
  hit=$(jq -r --arg q "$name" --arg exclude "$exclude" '
    .spaces | to_entries
    | map(select(.value.name == $q and .key != $exclude) | .key)
    | first // empty
  ' "$WS_CONFIG" 2>/dev/null)
  if [[ -n "$hit" ]]; then
    err "name '$name' already exists at slot $hit"
    exit 2
  fi
}

_fire_post() {
  # Backgrounded; failures never abort the caller.
  if [[ -x "$WS_HOOK" ]]; then
    ( "$WS_HOOK" "$@" >/dev/null 2>&1 & ) 2>/dev/null
  fi
}

_fire_cascade() {
  if [[ -x "$WS_HANDLER" ]]; then
    ( "$WS_HANDLER" >/dev/null 2>&1 & ) 2>/dev/null
  fi
}

# Canonical ordering filter run after every mutation. Sorts .spaces
# keys numerically (so 10 comes after 9, not after 1) and writes each
# slot's (name, color) fields in that order. iconSpec (v2) and any
# user-added extras land after, untouched. The legacy `.icon` raw-glyph
# field is actively dropped: with the cascade fully v2-aware
# (on-space-changed.sh and space.sh both prefer iconSpec.codepoint), no
# reader depends on it, so retiring the field keeps diffs clean.
_NORMALIZE='
  .spaces as $s
  | .spaces = (
      reduce ($s | keys | map(tonumber) | sort | map(tostring))[] as $k ({};
        .[$k] = (
          ($s[$k] | {name, color} | with_entries(select(.value != null)))
          + ($s[$k] | del(.name, .color, .icon))
        )
      )
    )
'

# _write <jq-program> [jq-args...]  — atomic mktemp + jq + normalize + validate + mv.
_write() {
  local prog="$1"; shift
  local tmp; tmp=$(mktemp) || { err "mktemp failed"; exit 1; }
  if ! jq "$@" "$prog" "$WS_CONFIG" | jq "$_NORMALIZE" > "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    err "jq transformation failed"
    exit 1
  fi
  if ! jq -e . "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    err "produced invalid JSON (refusing to write)"
    exit 1
  fi
  mv -f "$tmp" "$WS_CONFIG"
}

# Truecolor swatch helper. Uses the shared ws_hex_to_rgb parser.
_swatch() {
  local r g b
  read -r r g b < <(ws_hex_to_rgb "$1")
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    printf '\033[38;2;%d;%d;%dm▓▓▓\033[0m' "$r" "$g" "$b"
  else
    printf '   '
  fi
}

# Prompt yes/no; returns 0 on yes. Non-tty defaults to no unless -y was passed.
_confirm() {
  local msg="$1" yes="${2:-0}"
  if (( yes )); then return 0; fi
  if [[ ! -t 0 ]]; then return 1; fi
  local ans
  printf '%s [y/N] ' "$msg" >&2
  read -r ans
  [[ "$ans" =~ ^[Yy]$ ]]
}

# ── subcommands ─────────────────────────────────────────────────────────

cmd_help() {
  cat <<'EOF_HELP'
ws — manage the workspace identity (name / icon) of each slot.

Colors are positional: slot N keeps its color across moves and reorders.
(name, icon) are what flow when you swap / move / rotate / reverse /
reorder. Use `ws color N #HEX` to change a slot's color directly.
(`workspace` remains as a compat alias for muscle-memory.)

USAGE
  ws <subcommand> [args]
  (anywhere a slot is expected, you can pass either an index or a unique name)

INSPECTION
  status [--json]            list all slots with color swatches
  get <SLOT> [--json]        dump slot as JSON
  count                      print current slot count
  themes [--json]            list available themes
  doctor                     validate spaces.json schema
  verify                     run end-to-end cascade tests

MUTATION  (every mutation fires the cascade + post-mutate hook)
  name <SLOT> <NEW_NAME>           rename a slot
  color <SLOT> <#HEX>              set slot color
  icon <SLOT> [GLYPH]              set slot icon (no arg → fzf picker)
  icon search <TERM>               non-interactive list of SF Symbols
  add [NAME] [COLOR] [ICON]        append a new slot
  remove <SLOT> [-y]               delete a slot, renumber the rest
  swap <A> <B>                     swap two slots' (name, icon)
  move <SRC> <DEST>                move SRC to position DEST
  move <SRC> before|after <REF>    move SRC adjacent to REF (natural-language)
  rotate [N]                       shift all (name, icon) by N positions (default 1, signed)
  reverse                          reverse the slot order
  reorder <s1> ... <sN>            permute by full source-slot list
  theme <NAME> [--with-icons]      apply a palette to all slots
  edit                             open spaces.json in $EDITOR
  reset [-y]                       restore spaces.json from spaces.default.json

LAYOUTS  (named snapshots, per-machine)
  layout save <NAME>               snapshot current state
  layout load <NAME> [-y]          restore a saved snapshot
  layout list                      list saved layouts
  layout delete <NAME> [-y]        remove a saved layout

SYSTEM
  migrate [--apply]                spaces.json v1 → v2 importer (delegates to ws-topology)
  host {status|init|reset|list}    per-host overlay (spaces.<hostname>.json)
  refresh [--full]                 force re-run cascade + sketchybar repaint

ENV OVERRIDES
  WS_CONFIG       path to spaces.json     (default: ~/.config/workspace/spaces.json)
  WS_THEMES_DIR   themes directory        (default: ~/.config/workspace/themes)
  WS_HANDLER      cascade entry point     (default: ~/.config/workspace/on-space-changed.sh)
  WS_HOOK         post-mutate hook        (default: ~/.config/workspace/hooks/post-mutate.sh)
  WS_LAYOUTS_DIR  layouts directory       (default: ~/.config/workspace/layouts)

EXIT CODES
  0 success · 1 runtime error · 2 usage error

Hotkey note: skhd binds Caps+1..0 to spaces 1..10. Slots beyond 10 have
no hotkey by default; bind them manually in ~/.skhdrc if desired.
EOF_HELP
}

cmd_status() {
  _require_config
  local json=0
  [[ "${1:-}" == "--json" ]] && json=1
  if (( json )); then
    jq '.spaces' "$WS_CONFIG"
    return
  fi
  printf '%-3s %-4s %-12s %-9s %s\n' '#' 'ICON' 'NAME' 'COLOR' ''
  # Single jq pass yields one row per slot, fields separated by U+001F
  # (Unit Separator). Why not \t: bash's `read` with whitespace IFS
  # collapses consecutive separators, which misaligns fields when
  # codepoint is empty (kind=none slot) — fallbackText would slide
  # into the cp slot and ws_decode_icon would croak on "SM" or "CO".
  # \x1f is non-whitespace, so empty fields are preserved verbatim.
  # icon_escape is the iconSpec.codepoint (a `\uXXXX` or `\u{XXXXX}`
  # string) which ws_decode_icon turns into the literal glyph at render
  # time. fallback_text is iconSpec.fallbackText; shown when codepoint
  # is absent so the column isn't structurally empty for kind=none slots.
  while IFS=$'\x1f' read -r i name color cp ft; do
    local glyph
    if [[ -n "$cp" ]]; then
      glyph=$(ws_decode_icon "$cp")
    else
      glyph="$ft"
    fi
    printf '%-3s %-4s %-12s %-9s %s\n' "$i" "$glyph" "$name" "$color" "$(_swatch "$color")"
  done < <(jq -r '
    .spaces | to_entries
    | sort_by(.key | tonumber)
    | .[]
    | [
        .key,
        (.value.name // ""),
        (.value.color // "#cdd6f4"),
        (.value.iconSpec.codepoint // ""),
        (.value.iconSpec.fallbackText // "")
      ]
    | join("")
  ' "$WS_CONFIG")
}

cmd_get() {
  _require_config
  [[ $# -ge 1 ]] || { err "usage: ws get <SLOT_OR_NAME> [--json]"; exit 2; }
  local slot; slot=$(_resolve_slot "$1") || exit $?
  jq --arg k "$slot" '.spaces[$k]' "$WS_CONFIG"
}

cmd_count() {
  _require_config
  _count
}

cmd_themes() {
  local json=0
  [[ "${1:-}" == "--json" ]] && json=1
  local names=()
  if [[ -d "$WS_THEMES_DIR" ]]; then
    local f
    for f in "$WS_THEMES_DIR"/*.json; do
      [[ -f "$f" ]] || continue
      names+=("$(basename "$f" .json)")
    done
  fi
  if (( json )); then
    printf '%s\n' "${names[@]:-}" | jq -R . | jq -s .
  else
    printf '%s\n' "${names[@]:-}"
  fi
}

cmd_name() {
  _require_config
  [[ $# -eq 2 ]] || { err "usage: ws name <SLOT_OR_NAME> <NEW_NAME>"; exit 2; }
  local slot; slot=$(_resolve_slot "$1") || exit $?
  _validate_name_unique "$2" "$slot"
  _write '.spaces[$k] = ((.spaces[$k] // {}) + {name: $v})' --arg k "$slot" --arg v "$2"
  _fire_post name "$slot"
  _fire_cascade
}

cmd_color() {
  _require_config
  [[ $# -eq 2 ]] || { err "usage: ws color <SLOT_OR_NAME> <#HEX>"; exit 2; }
  local slot; slot=$(_resolve_slot "$1") || exit $?
  _validate_color "$2"
  _write '.spaces[$k] = ((.spaces[$k] // {}) + {color: $v})' --arg k "$slot" --arg v "$2"
  _fire_post color "$slot"
  _fire_cascade
}

_SF_TO_NERD_MAP="${WS_SF_MAP:-$HOME/.config/workspace/lib/sf-to-nerd.json}"
_NF_QUESTION_FALLBACK='\uf128'   # nf-fa-question_circle — placeholder when SF has no mapping

# Derive (codepoint, sf_name) from a single icon argument. Sets:
#   _ICON_ESCAPED   — ASCII-escaped codepoint (e.g. "") or empty
#   _ICON_SF_NAME   — SF Symbol name (e.g. "play.fill") or empty
# Heuristic:
#   • ASCII identifier matching ^[a-z][a-z0-9._]*$  → SF Symbol path
#     (look up codepoint in sf-to-nerd.json; warn + placeholder on miss)
#   • Anything else (UTF-8 multibyte, mixed case, etc.) → literal glyph path
#     (extract the first codepoint via python3, encode as \uXXXX or \u{X..})
# Interactive fzf icon picker. Prints the selected SF Symbol name to
# stdout. Returns non-zero (and prints nothing) if cancelled or fzf
# isn't available. Reused by `ws icon <slot>` and `ws add`.
_pick_icon_fzf() {
  local prompt="${1:-icon> }"
  have fzf || return 1
  [[ -r "$_SF_TO_NERD_MAP" ]] || return 1
  local picked
  picked=$(jq -r '
    to_entries
    | map(select(.key | startswith("_") | not))
    | sort_by(.key) | .[]
    | "\(.key)\t\(.value)"
  ' "$_SF_TO_NERD_MAP" \
    | while IFS=$'\t' read -r name esc; do
        printf '%s\t%s\t%s\n' "$(ws_decode_icon "$esc")" "$name" "$esc"
      done \
    | fzf --prompt="$prompt" \
          --with-nth=1,2 \
          --delimiter=$'\t' \
          --header="ENTER: apply · ESC: cancel" \
          --reverse --height=40% \
    | awk -F'\t' '{print $2}')
  [[ -n "$picked" ]] || return 1
  printf '%s' "$picked"
}

_resolve_icon_input() {
  local input="$1"
  _ICON_ESCAPED=""
  _ICON_SF_NAME=""
  [[ -z "$input" ]] && return 0

  if [[ "$input" =~ ^[a-z][a-z0-9._]*$ ]]; then
    # SF Symbol identifier. Map → Nerd Font codepoint via curated table.
    _ICON_SF_NAME="$input"
    if [[ -r "$_SF_TO_NERD_MAP" ]] && have jq; then
      _ICON_ESCAPED=$(jq -r --arg n "$input" '.[$n] // ""' "$_SF_TO_NERD_MAP" 2>/dev/null)
    fi
    if [[ -z "$_ICON_ESCAPED" ]]; then
      warn "no Nerd Font mapping for SF Symbol '$input' — using placeholder ($_NF_QUESTION_FALLBACK)."
      warn "  add a mapping in ${_SF_TO_NERD_MAP/#$HOME/~}"
      _ICON_ESCAPED="$_NF_QUESTION_FALLBACK"
    fi
    return 0
  fi

  # Literal glyph path. Extract the FIRST scalar; encode as \uXXXX or \u{X..}.
  local form="" hex=""
  read -r form hex < <(
    printf '%s' "$input" | python3 -c '
import sys
s = sys.stdin.read()
if s:
    cp = ord(s[0])
    if cp <= 0xFFFF:
        print("B", f"{cp:04x}")
    else:
        print("S", f"{cp:X}")
' 2>/dev/null
  )
  case "$form" in
    B) _ICON_ESCAPED="\\u${hex}" ;;
    S) _ICON_ESCAPED="\\u{${hex}}" ;;
  esac
}

cmd_icon() {
  _require_config

  # `workspace icon search <term>` — non-interactive list dump. Useful for
  # piping/scripting. The interactive picker is the no-glyph form below.
  if [[ "${1:-}" == "search" ]]; then
    shift
    local q="${1:-}"
    if [[ ! -r "$_SF_TO_NERD_MAP" ]] || ! have jq; then
      err "sf-to-nerd map not available"; exit 1
    fi
    jq -r --arg q "$q" '
      to_entries
      | map(select(.key | startswith("_") | not))
      | map(select($q == "" or (.key | test($q; "i"))))
      | sort_by(.key)
      | .[]
      | "\(.key)\t\(.value)"
    ' "$_SF_TO_NERD_MAP" \
      | while IFS=$'\t' read -r name esc; do
          local glyph
          glyph=$(ws_decode_icon "$esc")
          printf '  %-40s %s  %s\n' "$name" "$glyph" "$esc"
        done
    return 0
  fi

  if [[ $# -lt 1 || $# -gt 2 ]]; then
    err "usage: ws icon <SLOT_OR_NAME> [GLYPH_OR_SF_NAME]"
    err "       ws icon search <term>"
    err "   (omit GLYPH for an interactive fzf picker)"
    exit 2
  fi
  local slot; slot=$(_resolve_slot "$1") || exit $?
  local arg="${2:-}"

  # Interactive picker when no glyph was passed. Reuses the sf-to-nerd
  # table + ws_decode_icon (same data as `icon search`) so the preview
  # column shows what will land. Selection feeds back into the same
  # write path the two-arg form uses.
  if [[ -z "$arg" ]]; then
    arg=$(_pick_icon_fzf "icon for slot $slot> ") || {
      warn "no selection — slot $slot unchanged"; exit 1;
    }
  fi

  _resolve_icon_input "$arg"

  # Decide kind: sfSymbol if we identified an SF name, else nerdFont when
  # we have a codepoint, else "none" (cleared). userOverridden=true on
  # explicit edit. When iconSpec is missing (slot added pre-v2-fix), seed
  # the same baseline shape cmd_add now writes — single-source the schema.
  local kind="none"
  if [[ -n "$_ICON_SF_NAME" ]]; then
    kind="sfSymbol"
  elif [[ -n "$_ICON_ESCAPED" ]]; then
    kind="nerdFont"
  fi
  # Build iconSpec fresh, preserving only the fallback fields. This
  # clears stale `symbolName` / `codepoint` when the user switches kinds
  # (e.g. nerdFont → sfSymbol). On slots that never had iconSpec, the
  # fallback fields are synthesized from the slot name.
  _write '
    .spaces[$k] |= (
      . as $s
      | .iconSpec = (
          {
            kind: $kind,
            fallbackSfSymbol: (($s.iconSpec.fallbackSfSymbol) // "circle.fill"),
            fallbackText: (($s.iconSpec.fallbackText) // (($s.name // "") | .[0:2] | ascii_upcase)),
            userOverridden: true
          }
          + (if $cp != "" then {codepoint: $cp, fontFamily: "JetBrainsMono Nerd Font"} else {} end)
          + (if $sf != "" then {symbolName: $sf} else {} end)
        )
    )
  ' --arg k "$slot" --arg kind "$kind" --arg cp "$_ICON_ESCAPED" --arg sf "$_ICON_SF_NAME"
  _fire_post icon "$slot"
  _fire_cascade
}

cmd_migrate() {
  # Thin delegate to ws-topology. Dry-run by default; --apply writes
  # v2 in place. Idempotent on already-v2 files. Useful for importing
  # a legacy v1 spaces.json from an old backup or fresh-install seed.
  if ! command -v ws-topology >/dev/null 2>&1; then
    err "ws-topology not on PATH (build + symlink from ~/.config/workspace/topology)"
    exit 1
  fi
  ws-topology migrate "$@"
}

cmd_refresh() {
  # Force-re-run the cascade end-to-end. Useful after editing
  # spaces.json by hand, after swapping the active host overlay, or
  # any time the bar / borders / tmux env look stale.
  #
  # --full also asks ws-topologyd to republish topology.json + layout.env
  # (otherwise those refresh only on display reconfiguration events).
  local full=0
  for arg in "$@"; do
    case "$arg" in
      --full) full=1 ;;
      -h|--help)
        cat <<'EOF_REFRESH_HELP' >&2
usage: ws refresh [--full]

Re-run the cascade:
  1. on-space-changed.sh   rewrite current.env + repaint borders + trigger sketchybar
  2. per-display-pills.sh  re-apply pill display assignment + density + anchor

With --full, also kickstarts ws-topologyd so topology.json / layout.env
are re-emitted (normally only refreshed on display add/remove/change).
EOF_REFRESH_HELP
        return 0
        ;;
    esac
  done

  if [[ -x "$WS_HANDLER" ]]; then
    "$WS_HANDLER" || warn "cascade handler exited non-zero"
  else
    warn "cascade handler not executable: $WS_HANDLER"
  fi

  local pills="$HOME/.config/sketchybar/plugins/per-display-pills.sh"
  if [[ -x "$pills" ]]; then
    "$pills" >/dev/null 2>&1 || warn "per-display-pills.sh exited non-zero"
  fi

  if (( full )); then
    if launchctl print "gui/$(id -u)/com.adames.workspace.topologyd" >/dev/null 2>&1; then
      launchctl kickstart -k "gui/$(id -u)/com.adames.workspace.topologyd" 2>/dev/null || true
      printf 'ws: refreshed (--full: daemon kicked)\n' >&2
      return 0
    else
      warn "ws-topologyd not loaded; --full skipped"
    fi
  fi
  printf 'ws: refreshed\n' >&2
}

# ── host overlay management ─────────────────────────────────────────────
# Per-host workspace identity: ~/.config/workspace/spaces.<hostname>.json
# overrides ~/.config/workspace/spaces.json on this machine. Both files
# are valid v2 configs; the overlay simply takes precedence when present.
# Useful for divergent slot identities between machines (the M3 Max and
# the M1 13" may want different slot 8 names, for instance).

_host_short() { hostname -s 2>/dev/null || echo unknown; }
_host_file()  { printf '%s/.config/workspace/spaces.%s.json' "$HOME" "$1"; }

cmd_host() {
  local sub="${1:-status}"; shift 2>/dev/null || true
  case "$sub" in
    status|"")  _host_status ;;
    init)       _host_init "$@" ;;
    reset)      _host_reset "$@" ;;
    list)       _host_list ;;
    *)
      err "usage: ws host {status|init [HOST]|reset [HOST]|list}"
      exit 2 ;;
  esac
}

_host_status() {
  local h; h=$(_host_short)
  local hf; hf=$(_host_file "$h")
  printf 'hostname     %s\n' "$h"
  printf 'effective    %s\n' "$WS_CONFIG"
  if [[ -r "$hf" ]]; then
    printf 'overlay      yes (%s)\n' "$hf"
  else
    printf 'overlay      no (would be %s)\n' "$hf"
  fi
}

_host_init() {
  local target="${1:-$(_host_short)}"
  local hf; hf=$(_host_file "$target")
  if [[ -e "$hf" ]]; then
    err "$hf already exists; refusing to overwrite (use 'ws host reset $target' first)"
    exit 1
  fi
  local shared="$HOME/.config/workspace/spaces.json"
  if [[ ! -r "$shared" ]]; then
    err "shared $shared not found; nothing to fork from"
    exit 1
  fi
  cp "$shared" "$hf"
  printf 'forked %s → %s\n' "$shared" "$hf" >&2
  printf '%s\n' "$hf"
  _fire_cascade
}

_host_reset() {
  local target="${1:-$(_host_short)}"
  local hf; hf=$(_host_file "$target")
  if [[ ! -e "$hf" ]]; then
    printf 'no overlay at %s; nothing to remove\n' "$hf" >&2
    return 0
  fi
  rm -f "$hf"
  printf 'removed %s (now falling back to shared spaces.json)\n' "$hf" >&2
  _fire_cascade
}

_host_list() {
  local dir="$HOME/.config/workspace"
  local active="$WS_CONFIG"
  find "$dir" -maxdepth 1 -name 'spaces*.json' -type f 2>/dev/null \
    | sort \
    | while read -r f; do
        local marker=" "
        [[ "$f" == "$active" ]] && marker="*"
        printf '%s %s\n' "$marker" "$f"
      done
}

# Default name for a newly-added slot. The old WORKSPACE_LABELS array
# (core / forge / codex / …) is retired — yabai owns existence and we
# don't pre-name slots. Return empty so cmd_add's "ws$slot" fallback
# kicks in; the user names the slot themselves via `ws name N <new>`.
_label_for_slot() { : ; }

cmd_add() {
  _require_config
  # Flag parse: --no-prompt / -q skips interactive prompts even on a TTY.
  # Positional args (name, color, icon) still supported for back-compat
  # and for the hotkey wrapper that wants a one-shot non-interactive add.
  local no_prompt=0
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-prompt|-q) no_prompt=1 ;;
      *) positional+=("$1") ;;
    esac
    shift
  done
  set -- "${positional[@]}"

  local n new_slot name color icon
  n=$(_count)
  new_slot=$((n + 1))
  name="${1:-}"
  color="${2:-}"
  icon="${3:-}"

  # Interactive path: TTY + no --no-prompt. Skipped under skhdrc and
  # other no-tty contexts (the hotkey wrapper opens a Ghostty window
  # so the prompts get a real terminal).
  local interactive=0
  [[ $no_prompt -eq 0 && -t 0 && -t 1 ]] && interactive=1

  if (( interactive )); then
    # Name prompt with the seed-label suggestion. ENTER on empty input
    # accepts the suggestion (matches the existing label_for_slot path).
    local suggested
    suggested=$(_label_for_slot "$new_slot")
    [[ -z "$suggested" ]] && suggested="ws${new_slot}"
    if [[ -z "$name" ]]; then
      printf 'name [%s]: ' "$suggested" >&2
      read -r name
      [[ -z "$name" ]] && name="$suggested"
    fi
    # Icon prompt via fzf picker if available; ESC leaves the slot
    # icon-less (kind=none). Skipped if fzf or sf-to-nerd map missing.
    if [[ -z "$icon" ]] && have fzf && [[ -r "$_SF_TO_NERD_MAP" ]]; then
      printf 'icon: opening fzf (ESC to skip) ...\n' >&2
      icon=$(_pick_icon_fzf "icon for new slot $new_slot> " || true)
    fi
    # Color prompt with the slot's positional default from
    # spaces.default.json. Accepts blank (uses default) or any #RRGGBB
    # hex. The default file's positional colors are catppuccin pastels —
    # keeps fresh slots visually consistent with the seeded set.
    if [[ -z "$color" ]]; then
      local default_color="#cdd6f4"
      if [[ -r "$WS_DEFAULTS" ]] && have jq; then
        local seeded
        seeded=$(jq -r --arg k "$new_slot" '.spaces[$k].color // empty' "$WS_DEFAULTS" 2>/dev/null)
        [[ -n "$seeded" ]] && default_color="$seeded"
      fi
      printf 'color [%s]: ' "$default_color" >&2
      read -r color
      [[ -z "$color" ]] && color="$default_color"
    fi
  fi

  # Non-interactive fallbacks (or post-prompt defaulting if any field
  # is still unset).
  if [[ -z "$name" ]]; then
    name=$(_label_for_slot "$new_slot")
    [[ -z "$name" ]] && name="ws${new_slot}"
  fi
  [[ -z "$color" ]] && color="#cdd6f4"
  _validate_color "$color"
  _validate_name_unique "$name"

  # Build a v2 iconSpec scaffold. The fallbackText is the first two chars
  # of the name uppercased (matches the seed convention in
  # spaces.default.json so post-rename slots aren't visually distinct
  # from the seeded ones in degraded renders). If an icon arg was passed,
  # resolve it now and populate kind + codepoint/symbolName.
  # `userOverridden` flips true when an icon was actually picked — the
  # paint-all.sh "bare slot" detector keys off this + stableLogicalLabel
  # to decide gray-vs-color rendering. stableLogicalLabel is set to the
  # user-supplied name so the slot starts in "customized" state and
  # gets its color shown.
  _resolve_icon_input "$icon"
  local fallback_text
  fallback_text=$(printf '%s' "${name:0:2}" | tr '[:lower:]' '[:upper:]')
  local kind="none"
  local user_overridden=false
  if [[ -n "$_ICON_SF_NAME" ]]; then
    kind="sfSymbol"
    user_overridden=true
  elif [[ -n "$_ICON_ESCAPED" ]]; then
    kind="nerdFont"
    user_overridden=true
  fi

  _write '
    .spaces[$k] = {
      name: $n,
      color: $c,
      stableLogicalLabel: $n,
      iconSpec: (
        {
          kind: $kind,
          fallbackSfSymbol: "circle.fill",
          fallbackText: $ft,
          userOverridden: ($uo == "true")
        }
        + (if $cp != "" then {codepoint: $cp, fontFamily: "JetBrainsMono Nerd Font"} else {} end)
        + (if $sf != "" then {symbolName: $sf} else {} end)
      )
    }
  ' --arg k "$new_slot" --arg n "$name" --arg c "$color" \
    --arg kind "$kind" --arg ft "$fallback_text" --arg uo "$user_overridden" \
    --arg cp "$_ICON_ESCAPED" --arg sf "$_ICON_SF_NAME"
  _fire_post add "$new_slot"
  _fire_cascade
  # Ask yabai to create one more space. Silent on absence (Linux,
  # headless) and on failure (scripting-addition not loaded). The
  # space_created signal subscribed in yabairc will fire
  # per-display-pills.sh, which adds the matching sketchybar pill.
  # Disable with WS_ADD_GROW_YABAI=0 — useful for tests that don't
  # want to actually touch yabai state.
  if [[ "${WS_ADD_GROW_YABAI:-1}" == 1 ]] && have yabai && pgrep -x yabai >/dev/null 2>&1; then
    yabai -m space --create >/dev/null 2>&1 || true
  fi
}

cmd_remove() {
  _require_config
  local yes=0
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes) yes=1 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  [[ ${#args[@]} -eq 1 ]] || { err "usage: ws remove <SLOT_OR_NAME> [-y]"; exit 2; }
  local slot; slot=$(_resolve_slot "${args[0]}") || exit $?
  local n; n=$(_count)
  if (( n <= 1 )); then
    err "refusing to remove last slot (count would go to 0)"
    exit 1
  fi
  _confirm "remove slot $slot and renumber slots $((slot+1))..$n down by 1?" "$yes" \
    || { warn "aborted"; exit 1; }
  _write '
    . as $orig
    | ($orig.spaces | keys | map(tonumber) | max) as $n
    | .spaces = (
        reduce range(1; $n+1) as $i ({};
          if $i < ($slot|tonumber) then
            .[($i|tostring)] = $orig.spaces[($i|tostring)]
          elif $i == ($slot|tonumber) then
            .
          else
            .[(($i-1)|tostring)] = $orig.spaces[($i|tostring)]
          end
        )
      )
  ' --arg slot "$slot"
  _fire_post remove "$slot"
  _fire_cascade
}

cmd_swap() {
  _require_config
  [[ $# -eq 2 ]] || { err "usage: ws swap <SLOT_OR_NAME> <SLOT_OR_NAME>"; exit 2; }
  local a b
  a=$(_resolve_slot "$1") || exit $?
  b=$(_resolve_slot "$2") || exit $?
  if [[ "$a" == "$b" ]]; then return 0; fi
  # Positional fields stay anchored to the destination slot (color +
  # stableLogicalLabel). Identity fields move with the source (name +
  # iconSpec). with_entries(select(.value != null)) drops nulls so a
  # missing optional field on either side doesn't leak through as an
  # explicit null.
  _write '
    . as $orig
    | .spaces[$a] = (
        (($orig.spaces[$b] // {}) | {name, iconSpec})
        + (($orig.spaces[$a] // {}) | {color, stableLogicalLabel})
        | with_entries(select(.value != null))
      )
    | .spaces[$b] = (
        (($orig.spaces[$a] // {}) | {name, iconSpec})
        + (($orig.spaces[$b] // {}) | {color, stableLogicalLabel})
        | with_entries(select(.value != null))
      )
  ' --arg a "$a" --arg b "$b"
  _fire_post swap "$a" "$b"
  _fire_cascade
}

cmd_reorder() {
  _require_config
  local n; n=$(_count)
  if [[ $# -ne $n ]]; then
    err "reorder requires exactly $n args (current slot count); got $#"
    exit 2
  fi
  # Resolve each arg (accepts names or indices) into a normalized
  # numeric permutation. Validate: must be a permutation of 1..n.
  local resolved=()
  local i seen=""
  for (( i=1; i<=$#; i++ )); do
    local r
    r=$(_resolve_slot "${!i}") || exit $?
    if [[ ",$seen," == *",$r,"* ]]; then
      err "reorder arg $i = '${!i}' resolves to slot $r, which is a duplicate"
      exit 2
    fi
    seen="$seen,$r"
    resolved+=("$r")
  done
  local args_json
  args_json=$(printf '%s\n' "${resolved[@]}" | jq -Rn '[inputs | tonumber]')
  # Positional: color + stableLogicalLabel stay anchored to slot index.
  # Identity: name + iconSpec move with the source slot.
  _write '
    . as $orig
    | .spaces = (
        reduce range(0; ($args | length)) as $i ({};
          .[($i+1|tostring)] = (
            (($orig.spaces[($args[$i]|tostring)] // {}) | {name, iconSpec})
            + (($orig.spaces[($i+1|tostring)] // {}) | {color, stableLogicalLabel})
            | with_entries(select(.value != null))
          )
        )
      )
  ' --argjson args "$args_json"
  _fire_post reorder "${resolved[@]}"
  _fire_cascade
}

# Apply a numeric permutation array (each entry = source slot for that
# destination index, 1..N) to .spaces with positional-color semantics.
# Used by move / rotate / reverse to keep the jq path single-sourced.
_apply_perm() {
  # _apply_perm <subcommand-label> <slot1> <slot2> ... <slotN>
  local label="$1"; shift
  local n; n=$(_count)
  if [[ $# -ne $n ]]; then
    err "internal: _apply_perm got $# args, expected $n"
    exit 1
  fi
  local args_json
  args_json=$(printf '%s\n' "$@" | jq -Rn '[inputs | tonumber]')
  # Same permutation semantics as cmd_reorder: identity (name + iconSpec)
  # moves with the source slot, positional fields (color +
  # stableLogicalLabel) stay anchored to slot index.
  _write '
    . as $orig
    | .spaces = (
        reduce range(0; ($args | length)) as $i ({};
          .[($i+1|tostring)] = (
            (($orig.spaces[($args[$i]|tostring)] // {}) | {name, iconSpec})
            + (($orig.spaces[($i+1|tostring)] // {}) | {color, stableLogicalLabel})
            | with_entries(select(.value != null))
          )
        )
      )
  ' --argjson args "$args_json"
  _fire_post "$label" "$@"
  _fire_cascade
}

cmd_move() {
  _require_config
  [[ $# -ge 2 ]] || { err "usage: ws move <SRC> <DEST>  |  move <SRC> before|after <REF>"; exit 2; }
  local n; n=$(_count)
  local src; src=$(_resolve_slot "$1") || exit $?
  shift

  # Compute the 1..n list minus src ONCE; both the before|after path and
  # the numeric-dest path use it.
  local without_src=()
  local i
  for (( i=1; i<=n; i++ )); do
    [[ "$i" != "$src" ]] && without_src+=("$i")
  done

  local dest=""
  if [[ "$1" == "before" || "$1" == "after" ]]; then
    [[ $# -eq 2 ]] || { err "usage: ws move <SRC> $1 <REF>"; exit 2; }
    local direction="$1" ref
    ref=$(_resolve_slot "$2") || exit $?
    if [[ "$src" == "$ref" ]]; then return 0; fi
    local ref_pos=0
    for (( i=0; i<${#without_src[@]}; i++ )); do
      if [[ "${without_src[$i]}" == "$ref" ]]; then ref_pos=$((i+1)); break; fi
    done
    if [[ "$direction" == "before" ]]; then dest=$ref_pos; else dest=$((ref_pos + 1)); fi
  else
    [[ $# -eq 1 ]] || { err "usage: ws move <SRC> <DEST>  |  move <SRC> before|after <REF>"; exit 2; }
    if ! [[ "$1" =~ ^[1-9][0-9]*$ ]] || (( $1 < 1 )) || (( $1 > n )); then
      err "destination must be 1..$n (got: $1)"; exit 2
    fi
    dest="$1"
    if [[ "$src" == "$dest" ]]; then return 0; fi
  fi

  # Compose final permutation: without_src with src inserted at dest.
  local perm=()
  for (( i=0; i<${#without_src[@]}; i++ )); do
    if (( i+1 == dest )); then perm+=("$src"); fi
    perm+=("${without_src[$i]}")
  done
  if (( dest > ${#without_src[@]} )); then perm+=("$src"); fi
  _apply_perm move "${perm[@]}"
}

cmd_rotate() {
  _require_config
  local n; n=$(_count)
  local k="${1:-1}"
  if ! [[ "$k" =~ ^-?[0-9]+$ ]]; then err "rotate takes an integer step (got: $k)"; exit 2; fi
  # Normalize k into [0, n)
  k=$(( ((k % n) + n) % n ))
  if (( k == 0 )); then return 0; fi
  # Right rotation: new[i] = old[((i-1 - k + n) mod n) + 1]
  local perm=() i src
  for (( i=1; i<=n; i++ )); do
    src=$(( ((i - 1 - k + n) % n) + 1 ))
    perm+=("$src")
  done
  _apply_perm rotate "${perm[@]}"
}

cmd_reverse() {
  _require_config
  local n; n=$(_count)
  local perm=() i
  for (( i=n; i>=1; i-- )); do perm+=("$i"); done
  _apply_perm reverse "${perm[@]}"
}

cmd_layout() {
  _require_config
  local layouts_dir="${WS_LAYOUTS_DIR:-$HOME/.config/workspace/layouts}"
  mkdir -p "$layouts_dir"
  local sub="${1:-}"; shift || true
  case "$sub" in
    save)
      [[ $# -eq 1 ]] || { err "usage: ws layout save <NAME>"; exit 2; }
      [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || { err "layout name must be [A-Za-z0-9._-]+"; exit 2; }
      local dest="$layouts_dir/$1.json"
      local tmp; tmp=$(mktemp) || { err "mktemp failed"; exit 1; }
      cp "$WS_CONFIG" "$tmp" && mv -f "$tmp" "$dest"
      ok "saved layout ${dest/#$HOME/~}"
      ;;
    load)
      local name="" yes=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -y|--yes) yes=1 ;;
          *) [[ -z "$name" ]] && name="$1" || { err "unexpected arg: $1"; exit 2; } ;;
        esac
        shift
      done
      [[ -n "$name" ]] || { err "usage: ws layout load <NAME> [-y]"; exit 2; }
      local src="$layouts_dir/$name.json"
      [[ -r "$src" ]] || { err "layout not found: $src"; exit 1; }
      jq -e . "$src" >/dev/null 2>&1 || { err "layout is malformed JSON: $src"; exit 1; }
      _confirm "replace spaces.json with layout '$name'?" "$yes" \
        || { warn "aborted"; exit 1; }
      local tmp; tmp=$(mktemp) || { err "mktemp failed"; exit 1; }
      cp "$src" "$tmp" && mv -f "$tmp" "$WS_CONFIG"
      _fire_post layout "$name"
      _fire_cascade
      ;;
    list)
      local f
      for f in "$layouts_dir"/*.json; do
        [[ -f "$f" ]] && basename "$f" .json
      done
      ;;
    delete|rm)
      local name="" yes=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -y|--yes) yes=1 ;;
          *) [[ -z "$name" ]] && name="$1" || { err "unexpected arg: $1"; exit 2; } ;;
        esac
        shift
      done
      [[ -n "$name" ]] || { err "usage: ws layout delete <NAME> [-y]"; exit 2; }
      local target="$layouts_dir/$name.json"
      [[ -e "$target" ]] || { err "layout not found: $target"; exit 1; }
      _confirm "delete layout '$name'?" "$yes" || { warn "aborted"; exit 1; }
      rm -f "$target"
      ok "deleted ${target/#$HOME/~}"
      ;;
    ""|-h|--help|help)
      cat <<'EOF_LAYOUT'
ws layout — save / load / list named snapshots of spaces.json

  ws layout save <NAME>          snapshot current state
  ws layout load <NAME> [-y]     restore a saved snapshot
  ws layout list                 list saved layouts
  ws layout delete <NAME> [-y]   remove a saved layout

Layouts are stored in ~/.config/workspace/layouts/<NAME>.json (or
$WS_LAYOUTS_DIR if set). They are per-machine and not committed.
EOF_LAYOUT
      ;;
    *)
      err "unknown layout subcommand: $sub"; exit 2 ;;
  esac
}

cmd_theme() {
  _require_config
  local name="" with_icons=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --with-icons) with_icons=1 ;;
      -*) err "unknown flag: $1"; exit 2 ;;
      *) [[ -z "$name" ]] && name="$1" || { err "unexpected arg: $1"; exit 2; } ;;
    esac
    shift
  done
  [[ -n "$name" ]] || { err "usage: ws theme <NAME> [--with-icons]"; exit 2; }
  local theme_file="$WS_THEMES_DIR/$name.json"
  [[ -r "$theme_file" ]] || { err "theme not found: $theme_file"; exit 1; }
  jq -e . "$theme_file" >/dev/null 2>&1 || { err "theme is malformed JSON: $theme_file"; exit 1; }

  local n; n=$(_count)
  local apply_icons="false"
  (( with_icons )) && apply_icons="true"

  # Pre-resolve theme icons (when --with-icons) into a parallel array of
  # ASCII-escaped codepoints, so jq can patch iconSpec.codepoint per slot
  # without forking _resolve_icon_input mid-reduce. The theme file stores
  # icons as raw glyph strings; we round-trip through _resolve_icon_input
  # to get the same `\uXXXX`/`\u{XXXXX}` form spaces.json uses.
  local theme_icons_json="[]"
  if (( with_icons )); then
    local raw_icons=()
    mapfile -t raw_icons < <(jq -r '.icons // [] | .[]' "$theme_file")
    local escaped=()
    local raw
    for raw in "${raw_icons[@]}"; do
      if [[ -z "$raw" ]]; then
        escaped+=("")
      else
        _resolve_icon_input "$raw"
        escaped+=("$_ICON_ESCAPED")
      fi
    done
    theme_icons_json=$(printf '%s\n' "${escaped[@]:-}" | jq -R . | jq -s .)
  fi

  _write '
    . as $orig
    | ($theme[0].colors // []) as $tc
    | ($n | tonumber) as $count
    | ($icons | length) as $ni
    | .spaces = (
        reduce range(1; $count+1) as $i ($orig.spaces;
          .[($i|tostring)] = (
            (.[($i|tostring)] // {}) as $s
            | $s
            + (if ($tc | length) >= $i then {color: $tc[$i-1]} else {} end)
            + (
                if ($apply_icons == "true") and $ni >= $i and ($icons[$i-1] // "") != "" then
                  { iconSpec: (
                      {
                        kind: "nerdFont",
                        fallbackSfSymbol: ($s.iconSpec.fallbackSfSymbol // "circle.fill"),
                        fallbackText: ($s.iconSpec.fallbackText // (($s.name // "") | .[0:2] | ascii_upcase)),
                        userOverridden: false,
                        codepoint: $icons[$i-1],
                        fontFamily: "JetBrainsMono Nerd Font"
                      }
                  )}
                else {} end
              )
          )
        )
      )
    | .palette = $name
  ' --slurpfile theme "$theme_file" \
    --arg n "$n" --arg apply_icons "$apply_icons" --arg name "$name" \
    --argjson icons "$theme_icons_json"
  _fire_post theme
  _fire_cascade
}

cmd_edit() {
  _require_config
  local editor="${EDITOR:-vi}"
  "$editor" "$WS_CONFIG"
  if ! jq -e . "$WS_CONFIG" >/dev/null 2>&1; then
    err "spaces.json is now malformed; refusing to fire cascade (fix the file or run 'ws reset')"
    exit 1
  fi
  _fire_post edit
  _fire_cascade
}

cmd_reset() {
  local yes=0
  [[ "${1:-}" == "-y" || "${1:-}" == "--yes" ]] && yes=1
  [[ -r "$WS_DEFAULTS" ]] || { err "defaults file not found: $WS_DEFAULTS"; exit 1; }
  _confirm "reset spaces.json to defaults from $WS_DEFAULTS?" "$yes" \
    || { warn "aborted"; exit 1; }
  local tmp; tmp=$(mktemp) || { err "mktemp failed"; exit 1; }
  cp -f "$WS_DEFAULTS" "$tmp"
  jq -e . "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; err "defaults file is malformed"; exit 1; }
  mv -f "$tmp" "$WS_CONFIG"
  _fire_post reset
  _fire_cascade
}

cmd_doctor() {
  if [[ ! -r "$WS_CONFIG" ]]; then
    err "spaces.json not found: $WS_CONFIG"
    return 1
  fi
  if ! jq -e . "$WS_CONFIG" >/dev/null 2>&1; then
    err "spaces.json is not valid JSON"
    return 1
  fi
  local bad=0
  # Schema invariants:
  #   - slot keys are contiguous 1..count
  #   - name (string) + color (#RRGGBB string)
  #   - iconSpec (object) with kind ∈ {sfSymbol, nerdFont, none}
  #   - kind=nerdFont implies codepoint (string)
  #   - kind=sfSymbol implies symbolName (string)
  #   - userOverridden is boolean
  local report
  report=$(jq -r '
    .spaces as $s
    | ($s | keys | map(tonumber) | sort) as $ks
    | [ ($ks | length) as $n
      | $ks | to_entries[]
      | select(.value != (.key + 1))
      | "gap: expected slot \(.key + 1), found \(.value)"
      ] + [
        $s | to_entries[]
        | select(
            (.value.name | type) != "string" or
            (.value.color | type) != "string"
          )
        | "slot \(.key): missing/wrong type for name|color"
      ] + [
        $s | to_entries[]
        | select((.value.color // "") | test("^#[0-9a-fA-F]{6}$") | not)
        | "slot \(.key): color \"\(.value.color)\" is not #RRGGBB"
      ] + [
        $s | to_entries[]
        | select((.value.iconSpec | type) != "object")
        | "slot \(.key): iconSpec missing or not an object"
      ] + [
        $s | to_entries[]
        | select(.value.iconSpec | type == "object")
        | select((.value.iconSpec.kind // "") as $k | $k != "sfSymbol" and $k != "nerdFont" and $k != "none")
        | "slot \(.key): iconSpec.kind \"\(.value.iconSpec.kind)\" must be sfSymbol|nerdFont|none"
      ] + [
        $s | to_entries[]
        | select(.value.iconSpec.kind == "nerdFont")
        | select((.value.iconSpec.codepoint // "") == "" or (.value.iconSpec.codepoint | type) != "string")
        | "slot \(.key): kind=nerdFont but codepoint missing"
      ] + [
        $s | to_entries[]
        | select(.value.iconSpec.kind == "sfSymbol")
        | select((.value.iconSpec.symbolName // "") == "" or (.value.iconSpec.symbolName | type) != "string")
        | "slot \(.key): kind=sfSymbol but symbolName missing"
      ] + [
        $s | to_entries[]
        | select(.value.iconSpec | type == "object")
        | select(.value.iconSpec.userOverridden != null and (.value.iconSpec.userOverridden | type) != "boolean")
        | "slot \(.key): iconSpec.userOverridden must be boolean"
      ]
    | .[]
  ' "$WS_CONFIG" 2>/dev/null) || bad=1
  if [[ -n "$report" ]]; then
    while IFS= read -r line; do
      err "$line"
    done <<<"$report"
    bad=1
  fi
  # Soft-warn on duplicate names.
  local dups
  dups=$(jq -r '
    [.spaces[].name] | group_by(.) | map(select(length > 1) | .[0]) | .[]
  ' "$WS_CONFIG" 2>/dev/null)
  if [[ -n "$dups" ]]; then
    while IFS= read -r name; do
      warn "duplicate name: $name"
    done <<<"$dups"
  fi
  if (( bad )); then
    return 1
  fi
  ok "spaces.json schema OK ($( _count ) slots)"
}

cmd_verify() {
  local harness="$HOME/.config/workspace/cli/test-cascade.sh"
  if [[ ! -x "$harness" ]]; then
    harness="$DOTFILES_DIR/configs/workspace/cli/test-cascade.sh"
  fi
  if [[ ! -x "$harness" ]]; then
    err "test-cascade.sh not found (re-run bootstrap?)"
    exit 1
  fi
  exec "$harness" "$@"
}

