#!/usr/bin/env bash
# ws-destroy-current — guarded "destroy currently focused workspace".
# Called from skhd `manage` mode (Mod+W → Shift+D). Even with Shift+D
# already requiring intent, this script enforces a confirmation dialog
# because losing a workspace is destructive — windows reparent to a
# neighbouring space, spaces.json metadata for the slot is pruned, and
# slot numbers above the deleted one all shift down by one.
set -u

ws_bin="${WS_BIN:-$HOME/.local/bin/ws}"
[[ -x "$ws_bin" ]] || {
  osascript -e 'display notification "ws CLI missing" with title "ws"'
  exit 1
}

index=$(yabai -m query --spaces --space 2>/dev/null | jq -r '.index' 2>/dev/null)
if [[ -z "${index:-}" || "$index" == "null" ]]; then
  osascript -e 'display notification "yabai unavailable" with title "ws"'
  exit 1
fi

name=$(jq -r --arg k "$index" '.spaces[$k].name // "(unnamed)"' \
  "$HOME/.config/workspace/spaces.json" 2>/dev/null)

choice=$(osascript <<OSA 2>/dev/null
try
  display dialog "Destroy workspace ${index} (\"${name}\")?

Windows on this space will reparent to a neighbouring space. spaces.json metadata for slot ${index} will be pruned, and higher-numbered slots will shift down by one." \
    with title "Workspace destroy" with icon caution buttons {"Cancel","Destroy"} default button "Cancel"
  return button returned of result
on error
  return "Cancel"
end try
OSA
)
[[ "$choice" == "Destroy" ]] || exit 0

exec "$ws_bin" remove "$index" -y
