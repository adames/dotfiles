#!/usr/bin/env bash
# ws-focus <SLOT> — focus space N if it exists, else notify.
# Called from skhd `focus` mode (Hyper+W → digit). yabai's
# `space --focus N` silently no-ops for nonexistent N (its stderr
# message never surfaces), which is the existing UX bug we're fixing.
set -u

target="${1:-}"
[[ -n "$target" ]] || {
  osascript -e 'display notification "ws-focus: missing slot arg" with title "ws"'
  exit 2
}

count=$(yabai -m query --spaces 2>/dev/null | jq 'length' 2>/dev/null)
if [[ -z "${count:-}" || ! "$count" =~ ^[0-9]+$ ]]; then
  osascript -e 'display notification "yabai unavailable" with title "ws"'
  exit 1
fi

if [[ "$target" =~ ^[0-9]+$ ]] && (( target < 1 || target > count )); then
  osascript -e "display notification \"slot $target does not exist (have $count)\" with title \"ws\""
  exit 1
fi

# Optimistic pre-paint: tell sketchybar the new active SID + DISPLAY
# *before* yabai's transition animation, so the pill snaps the instant
# the user commits the chord. paint-all.sh honors the env vars and
# overrides its yabai query; the eventual space_changed cascade fires
# this same paint with the now-real values, no visible flicker.
#
# Best-effort — sketchybar missing, or a different display layout than
# spaces.json knows about, falls through to the legacy "wait for the
# cascade" path with no UX regression.
if command -v sketchybar >/dev/null 2>&1; then
  disp=$(yabai -m query --spaces 2>/dev/null \
         | jq -r --arg t "$target" \
             '.[] | select((.index|tostring) == $t) | .display' 2>/dev/null)
  if [[ -n "${disp:-}" ]]; then
    sketchybar --trigger workspace_changed \
      WS_OPTIMISTIC_SID="$target" \
      WS_OPTIMISTIC_DISPLAY="$disp" >/dev/null 2>&1 || true
  fi
fi

yabai -m space --focus "$target" 2>/dev/null || {
  # On failure restore correct state — re-trigger without the
  # optimistic env vars so paint-all.sh falls back to yabai's real
  # active SID.
  command -v sketchybar >/dev/null 2>&1 \
    && sketchybar --trigger workspace_changed >/dev/null 2>&1 || true
  osascript -e "display notification \"yabai focus failed for $target\" with title \"ws\""
  exit 1
}
