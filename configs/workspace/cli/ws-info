#!/usr/bin/env bash
# ws-info — surface the current workspace identity as a notification.
# Bound to skhd `manage` mode (Mod+W → i). Reads spaces.json + yabai
# state directly; no caching, so it always reflects ground truth.
set -u

index=$(yabai -m query --spaces --space 2>/dev/null | jq -r '.index' 2>/dev/null)
if [[ -z "${index:-}" || "$index" == "null" ]]; then
  osascript -e 'display notification "yabai unavailable" with title "ws"'
  exit 1
fi

read -r name color icon < <(jq -r --arg k "$index" '
  .spaces[$k] // {} |
  [(.name // "(unnamed)"),
   (.color // "(no color)"),
   (.iconSpec.codepoint // "")] | @tsv
' "$HOME/.config/workspace/spaces.json" 2>/dev/null)

osascript -e "display notification \"slot ${index} · ${name} · ${color} · ${icon}\" with title \"ws info\""
