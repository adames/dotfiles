#!/usr/bin/env sh
# JankyBorders daemon config. Read on `borders` startup. Active colour is
# overwritten per-space by configs/workspace/on-space-changed.sh — the
# value below is just the bootstrap default until the first space switch.
#
# brew formula: FelixKratz/formulae/borders.

options=(
  # 2.0 px is the cyberpunk sweet spot — visible without dominating the
  # tile gap. 3+ reads as gamer chaos, 1 disappears against most apps.
  width=2.0

  # Round corners pair with Ghostty's 8px padding; square borders against
  # round terminal corners look unfinished.
  style=round

  # Active colour is the per-space identity (peach for forge, sky for
  # uplink, …). Bootstrap default = mauve (slot 1, "core") so a fresh
  # daemon launch before any space switch already looks right.
  active_color=0xffcba6f7

  # Inactive: surface2 at 25% alpha. Visible enough to mark unfocused
  # tile boundaries; faint enough not to compete with the active border.
  inactive_color=0x40585b70

  # Skip floating windows entirely. Most floats here are dialogs that
  # don't benefit from a border (System Settings, Calculator, etc.).
  background_color=0x00000000

  # Hide on macOS native fullscreen windows — yabai can't manage them
  # and a stranded border looks broken.
  hidpi=on
)

borders "${options[@]}"
