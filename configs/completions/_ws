#compdef ws workspace
# Zsh completion for the `ws` workspace CLI (and the `workspace` compat alias).
#
# Loaded by zshrc's `fpath` hook. The bash equivalent lives in ws.bash.

local -a subcommands
subcommands=(
  'status:list every slot with color swatches'
  'get:dump a single slot as JSON'
  'count:print current slot count'
  'themes:list available palettes'
  'name:rename a slot'
  'color:set a slot color (#RRGGBB)'
  'icon:set a slot icon (or invoke fzf picker / SF Symbol search)'
  'add:append a new slot (interactive unless --no-prompt)'
  'remove:delete a slot, renumber the rest'
  'swap:exchange two slots (name + icon)'
  'reorder:permute every slot by position list'
  'move:move a slot to a new position or before/after another'
  'rotate:shift all (name, icon) by N positions'
  'reverse:reverse the slot order'
  'layout:save / load / list / delete named snapshots'
  'theme:apply a color palette to all slots'
  'edit:open spaces.json in $EDITOR'
  'reset:restore spaces.json from spaces.default.json'
  'doctor:validate spaces.json schema'
  'verify:run end-to-end cascade test harness'
  'migrate:import a legacy v1 spaces.json'
  'refresh:force re-run cascade (current.env + sketchybar)'
  'host:manage the per-host overlay (spaces.<hostname>.json)'
  'help:print usage'
)

# Resolve slots from the live spaces.json. Each completion candidate is
# `<index>:<name>` so zsh shows both number and human-readable label.
__ws_slots() {
  local cfg="${WS_CONFIG:-$HOME/.config/workspace/spaces.json}"
  [[ -r "$cfg" ]] || return
  local -a slots
  while IFS=$'\t' read -r idx name; do
    [[ -z "$idx" ]] && continue
    slots+=("$idx:$name")
  done < <(jq -r '.spaces | to_entries | sort_by(.key | tonumber) | .[] | [.key, (.value.name // "")] | join("\t")' "$cfg" 2>/dev/null)
  _describe -t slots 'slot' slots
}

__ws_slot_names() {
  local cfg="${WS_CONFIG:-$HOME/.config/workspace/spaces.json}"
  [[ -r "$cfg" ]] || return
  local -a names
  names=( ${(f)"$(jq -r '.spaces | to_entries | sort_by(.key | tonumber) | .[].value.name // empty' "$cfg" 2>/dev/null)"} )
  _describe -t names 'slot name' names
}

__ws_themes() {
  local dir="${WS_THEMES_DIR:-$HOME/.config/workspace/themes}"
  [[ -d "$dir" ]] || return
  local -a themes
  themes=( ${(f)"$(cd "$dir" && ls *.json 2>/dev/null | sed 's/\.json$//')"} )
  _describe -t themes 'theme' themes
}

__ws_layouts() {
  local dir="${WS_LAYOUTS_DIR:-$HOME/.config/workspace/layouts}"
  [[ -d "$dir" ]] || return
  local -a layouts
  layouts=( ${(f)"$(cd "$dir" && ls *.json 2>/dev/null | sed 's/\.json$//')"} )
  _describe -t layouts 'layout' layouts
}

_ws() {
  local context state line
  typeset -A opt_args

  _arguments -C \
    '1:subcommand:->cmd' \
    '*::arg:->args'

  case $state in
    cmd)
      _describe -t commands 'ws subcommand' subcommands
      ;;
    args)
      case ${line[1]} in
        get|name|color|icon|remove|swap|move|rotate)
          # First positional after the subcommand is a slot.
          if (( CURRENT == 2 )); then
            __ws_slots
          elif [[ ${line[1]} == swap || ${line[1]} == move ]] && (( CURRENT == 3 )); then
            __ws_slots
          fi
          ;;
        theme)
          (( CURRENT == 2 )) && __ws_themes
          ;;
        layout)
          if (( CURRENT == 2 )); then
            _values 'layout subcommand' \
              'save[snapshot current state]' \
              'load[restore a saved snapshot]' \
              'list[list saved layouts]' \
              'delete[remove a saved layout]'
          elif (( CURRENT == 3 )) && [[ ${line[2]} == (load|delete) ]]; then
            __ws_layouts
          fi
          ;;
        host)
          (( CURRENT == 2 )) && _values 'host subcommand' \
            'status[show effective config + overlay state]' \
            'init[fork off a per-host overlay]' \
            'reset[remove overlay, fall back to shared]' \
            'list[list known overlays]'
          ;;
        refresh)
          (( CURRENT == 2 )) && _values 'flag' '--full[also kickstart ws-topologyd]'
          ;;
        icon)
          if (( CURRENT == 2 )); then
            _alternative 'subcommand:icon subcommand:(search)' 'slot:slot:__ws_slots'
          fi
          ;;
        migrate)
          (( CURRENT == 2 )) && _values 'flag' '--apply[write the v2 file]'
          ;;
        add)
          (( CURRENT == 2 )) && _values 'flag' \
            '--no-prompt[skip interactive prompts; use positional args or auto-gen]' \
            '-q[short for --no-prompt]'
          ;;
      esac
      ;;
  esac
}

_ws "$@"
