# ~/.zshenv — sourced by EVERY zsh: interactive, login, and above all the
# non-interactive ones. That last case is the point of this file.
#
# PATH used to live only in .zshrc, which interactive shells read and
# nothing else does. So `node` was v24 when I typed it and v26 when a
# script, a cron job, an editor subprocess — or an AI harness running a
# build — asked for it. Reviewing on one runtime while the agent that
# wrote the code built on another is a bug generator, and an invisible
# one: both shells report success.
#
# Kept deliberately minimal. .zshenv runs for every single zsh, so
# anything slow or interactive here is a tax on every script on the
# machine. PATH and nothing else.

# Base: user bins, then brew. /usr/local/bin for the Intel-brew case.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Keg-only formulae aren't symlinked into /opt/homebrew/bin, so their bin
# dirs go on by hand. python@3.12 via libexec/bin — the only place brew
# provides a bare `python3`/`python`. Guarded on the directory existing,
# so this file is a no-op on Linux and on a Mac before brew is installed.
for _kb in /opt/homebrew/opt/node@24/bin \
           /opt/homebrew/opt/python@3.12/libexec/bin
do [[ -d "$_kb" ]] && PATH="$_kb:$PATH"; done
unset _kb

typeset -U PATH
export PATH
