#!/usr/bin/env sh
# yabai BSP tiling. Hotkeys in ~/.skhdrc.
#
# Philosophy: yabai owns existence (which spaces exist, on which
# display). macOS / Mission Control is the source of truth — we don't
# create, destroy, label, or relocate spaces here. spaces.json layers
# optional identity (name / color / icon) on top of whatever yabai
# reports. New space via Mission Control "+" → bar gets a bare pill;
# `ws name N foo` paints it. Destroy via Mission Control "×" → bar
# pill drops, spaces.json entry prunes.

yabai -m config layout                      bsp
yabai -m config window_placement            second_child
yabai -m config window_gap                  8
yabai -m config top_padding                 8
yabai -m config bottom_padding              8
yabai -m config left_padding                8
yabai -m config right_padding               8

# Reserve 26px at the top of every display for the SketchyBar workspace
# strip. With macOS auto-hide menu bar on, the menu bar overlays the
# strip only while the cursor is at the top — yabai's tiling never
# encroaches, so the strip is always exposed (and clickable) the rest
# of the time. Format: <edge>:<top_offset>:<bottom_offset>.
yabai -m config external_bar               all:26:0
yabai -m config split_ratio                 0.50
yabai -m config auto_balance                off

yabai -m config mouse_follows_focus         off
yabai -m config focus_follows_mouse         off
yabai -m config mouse_modifier              fn
yabai -m config mouse_action1               move
yabai -m config mouse_action2               resize
yabai -m config mouse_drop_action           swap

# Float system dialogs / utility apps
yabai -m rule --add app="^System Settings$"     manage=off
yabai -m rule --add app="^System Preferences$"  manage=off
yabai -m rule --add app="^Calculator$"          manage=off
yabai -m rule --add app="^Karabiner-Elements$"  manage=off
yabai -m rule --add app="^Finder$" title="^(Copy|Move|Info)" manage=off

# Ghostty: yabai-managed. The old "halve-on-Cmd+T" bug is fixed at the
# source — Ghostty's config rebinds cmd+t and cmd+n to new_window so each
# new terminal arrives as a top-level NSWindow yabai expects, rather than
# a phantom tab-window. tmux handles in-window splits (C-Space + v/s).
yabai -m signal --remove ghostty_tab_dance 2>/dev/null   # remove old approach if present

# ── workspace identity signals ──────────────────────────────────────────
# space_changed → repaint window borders, refresh tmux/shell env. Single
# point of integration; everything else subscribes by reading
# ~/.cache/workspace/current.env or env vars in tmux's global session.
yabai -m signal --remove ws_space_changed 2>/dev/null || true
yabai -m signal --add \
  event=space_changed \
  label=ws_space_changed \
  action="\"$HOME/.config/workspace/on-space-changed.sh\""

# window_focused → re-assert borders' active_color from the cached
# MACOS_SPACE_COLOR. Defends against state drift between space_changed
# events (new windows in the focused space, borders daemon restarts).
yabai -m signal --remove ws_borders_window_focused 2>/dev/null || true
yabai -m signal --add \
  event=window_focused \
  label=ws_borders_window_focused \
  action="\"$HOME/.config/workspace/borders-refresh.sh\""

# Sync sketchybar pill set with yabai's per-display assignment whenever
# a display attaches/detaches or its index changes. per-display-pills.sh
# is idempotent + silent-on-absence.
#
# NOT subscribed to space_changed: per-pill display assignment doesn't
# change on focus (paint-all.sh handles the active-pill highlight via
# workspace_changed). A previous iteration subscribed and produced
# visible "paint then snap" flicker.
yabai -m signal --remove ws_pills_space_changed 2>/dev/null || true
for ev in display_added display_removed display_changed; do
  yabai -m signal --remove "ws_pills_${ev}" 2>/dev/null || true
  yabai -m signal --add \
    event=$ev \
    label=ws_pills_${ev} \
    action="\"$HOME/.config/sketchybar/plugins/per-display-pills.sh\""
done

# Space lifecycle: track macOS-native Space creation / destruction so
# the bar stays in sync with Mission Control gestures. These signals
# fire on BOTH `yabai -m space --create/--destroy` AND Mission
# Control's `+`/`×` controls.
#
# space_created  → per-display-pills.sh adds the new pill.
# space_destroyed → on-space-destroyed.sh prunes the now-orphan slot
#                  from spaces.json + per-display-pills.sh drops the
#                  dead pill.
for ev in space_created space_destroyed; do
  yabai -m signal --remove "ws_pills_${ev}" 2>/dev/null || true
  yabai -m signal --add \
    event=$ev \
    label=ws_pills_${ev} \
    action="\"$HOME/.config/sketchybar/plugins/per-display-pills.sh\""
done
yabai -m signal --remove ws_prune_space_destroyed 2>/dev/null || true
yabai -m signal --add \
  event=space_destroyed \
  label=ws_prune_space_destroyed \
  action="\"$HOME/.config/workspace/on-space-destroyed.sh\""

# ── neon window borders (JankyBorders) ──────────────────────────────────
# Per-space active colour is set by on-space-changed.sh on every
# space_changed event. Static defaults (width, style, inactive colour)
# live in ~/.config/borders/bordersrc, which is itself the launch script.
# brew formula: FelixKratz/formulae/borders.
if command -v borders >/dev/null 2>&1 && [ -x "$HOME/.config/borders/bordersrc" ]; then
  pgrep -x borders >/dev/null 2>&1 || ( "$HOME/.config/borders/bordersrc" >/dev/null 2>&1 & )
fi

# Prime current.env so a fresh shell launched before any space switch
# already has identity metadata. Cheap; fails silently if the workspace
# subsystem hasn't been installed yet.
[ -x "$HOME/.config/workspace/on-space-changed.sh" ] && \
  "$HOME/.config/workspace/on-space-changed.sh" >/dev/null 2>&1 || true

# Clean up stale signal labels from retired architecture iterations.
yabai -m signal --remove workspace_on_space_change   2>/dev/null || true
yabai -m signal --remove workspace_on_display_change 2>/dev/null || true
yabai -m signal --remove ensure_spaces_on_display_add 2>/dev/null || true
yabai -m signal --remove ws_reconcile_display_added   2>/dev/null || true
yabai -m signal --remove ws_reconcile_display_removed 2>/dev/null || true
yabai -m signal --remove ws_reconcile_display_changed 2>/dev/null || true

echo "yabai configuration loaded"
