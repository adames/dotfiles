#!/usr/bin/env sh
# yabai BSP tiling. Hotkeys in ~/.skhdrc.
# Mission Control owns space lifecycle; spaces.json layers name/color/icon on top.

yabai -m config layout                      bsp
yabai -m config window_placement            second_child
yabai -m config window_gap                  8
yabai -m config top_padding                 8
yabai -m config bottom_padding              8
yabai -m config left_padding                8
yabai -m config right_padding               8

# 26px top: SketchyBar workspace strip. Format: <edge>:<top_offset>:<bottom_offset>.
yabai -m config external_bar               all:26:0
yabai -m config split_ratio                 0.50
yabai -m config auto_balance                off

yabai -m config mouse_follows_focus         off
yabai -m config focus_follows_mouse         off
yabai -m config mouse_modifier              fn
yabai -m config mouse_action1               move
yabai -m config mouse_action2               resize
yabai -m config mouse_drop_action           swap

# Float system dialogs. sub-layer=above prevents them sinking behind tiled windows.
yabai -m rule --add app="^System Settings$"     manage=off sub-layer=above
yabai -m rule --add app="^System Preferences$"  manage=off sub-layer=above
yabai -m rule --add app="^Calculator$"          manage=off sub-layer=above
yabai -m rule --add app="^Karabiner-Elements$"  manage=off sub-layer=above
yabai -m rule --add app="^Finder$" title="^(Copy|Move|Info)" manage=off sub-layer=above

# AX subrole catch-alls: covers save sheets, alerts, modals without enumerating apps.
yabai -m rule --add subrole="^AXDialog$"               manage=off sub-layer=above
yabai -m rule --add subrole="^AXSystemDialog$"         manage=off sub-layer=above
yabai -m rule --add subrole="^AXSystemFloatingWindow$" manage=off sub-layer=above

# Installer-class: anchor on "Install" prefix to catch CLT helper + Installer.app.
yabai -m rule --add app="^Install( |$)"          manage=off sub-layer=above
yabai -m rule --add app="^Installer$"            manage=off sub-layer=above
yabai -m rule --add app="^Software Update$"      manage=off sub-layer=above

# New windows: migrate to focused space, center if floating, then focus.
# Skips AXDialog/AXSheet so modal sheets stay attached.
yabai -m signal --remove ws_float_raise   2>/dev/null || true
yabai -m signal --remove ws_stage_window  2>/dev/null || true
yabai -m signal --add \
  event=window_created \
  label=ws_stage_window \
  action="\"\$HOME/.config/workspace/stage-window.sh\""

# Ghostty: cmd+t/n → new_window (not tab) so yabai sees one NSWindow per terminal.
yabai -m signal --remove ghostty_tab_dance 2>/dev/null   # remove old approach if present

# ── workspace signals ────────────────────────────────────────────────────
# space_changed → refresh tmux/shell env via on-space-changed.sh.
yabai -m signal --remove ws_space_changed 2>/dev/null || true
yabai -m signal --add \
  event=space_changed \
  label=ws_space_changed \
  action="\"$HOME/.config/workspace/on-space-changed.sh\""

# display_changed: cross-monitor focus doesn't always fire space_changed;
# wiring the same cascade here closes the gap.
yabai -m signal --remove ws_cascade_display_changed 2>/dev/null || true
yabai -m signal --add \
  event=display_changed \
  label=ws_cascade_display_changed \
  action="\"$HOME/.config/workspace/on-space-changed.sh\""

# Retired: ws_borders_window_focused — JankyBorders was removed.
yabai -m signal --remove ws_borders_window_focused 2>/dev/null || true

# Sync sketchybar pills on display events.
# Not subscribed to space_changed: previous attempt caused visible "paint then snap" flicker.
yabai -m signal --remove ws_pills_space_changed 2>/dev/null || true
for ev in display_added display_removed display_changed; do
  yabai -m signal --remove "ws_pills_${ev}" 2>/dev/null || true
  yabai -m signal --add \
    event=$ev \
    label=ws_pills_${ev} \
    action="\"$HOME/.config/sketchybar/plugins/per-display-pills.sh\""
done

# Space lifecycle: keeps bar in sync with Mission Control gestures.
for ev in space_created space_destroyed; do
  yabai -m signal --remove "ws_pills_${ev}" 2>/dev/null || true
  yabai -m signal --add \
    event=$ev \
    label=ws_pills_${ev} \
    action="\"$HOME/.config/sketchybar/plugins/per-display-pills.sh\""
done
yabai -m signal --remove ws_prune_space_destroyed 2>/dev/null || true
yabai -m signal --add \
  event=space_destroyed \
  label=ws_prune_space_destroyed \
  action="\"$HOME/.config/workspace/on-space-destroyed.sh\""

# Prime current.env on startup so new shells have identity metadata immediately.
[ -x "$HOME/.config/workspace/on-space-changed.sh" ] && \
  "$HOME/.config/workspace/on-space-changed.sh" >/dev/null 2>&1 || true

# Clean up stale signal labels from retired architecture iterations.
yabai -m signal --remove workspace_on_space_change   2>/dev/null || true
yabai -m signal --remove workspace_on_display_change 2>/dev/null || true
yabai -m signal --remove ensure_spaces_on_display_add 2>/dev/null || true
yabai -m signal --remove ws_reconcile_display_added   2>/dev/null || true
yabai -m signal --remove ws_reconcile_display_removed 2>/dev/null || true
yabai -m signal --remove ws_reconcile_display_changed 2>/dev/null || true

echo "yabai configuration loaded"
