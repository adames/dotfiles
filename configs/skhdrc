# Hyper+key (cmd+alt+ctrl+shift) = focus.  Hyper+Shift+key (cmd+alt+ctrl) = swap.
# Karabiner emits Hyper for Caps and Mod for Caps+Shift (Shift consumed).
# yabai tiling config is in ~/.yabairc.

# --- focus ---------------------------------------------------------------
cmd + alt + ctrl + shift - h : yabai -m window --focus west
cmd + alt + ctrl + shift - j : yabai -m window --focus south
cmd + alt + ctrl + shift - k : yabai -m window --focus north
cmd + alt + ctrl + shift - l : yabai -m window --focus east

# --- swap (Hyper+Shift) --------------------------------------------------
cmd + alt + ctrl - h : yabai -m window --swap west
cmd + alt + ctrl - j : yabai -m window --swap south
cmd + alt + ctrl - k : yabai -m window --swap north
cmd + alt + ctrl - l : yabai -m window --swap east

# --- layout / float -------------------------------------------------------
# New windows are staged on the focused space by ~/.yabairc's
# ws_stage_window signal: cross-space migrated, focused, and (if the
# app/rule has them floating) centered. Tile-vs-float is the app's call.
# Floating-staged windows have three exits:
#   1. caps + return → digit  — send to another workspace (send mode)
#   2. ⌘W                     — close
#   3. caps + shift + f       — toggle float (unfloat = commit to tiling)
cmd + alt + ctrl + shift - f      : yabai -m window --toggle zoom-fullscreen
cmd + alt + ctrl + shift - r      : yabai -m space  --rotate 90
cmd + alt + ctrl + shift - e      : yabai -m space  --balance
cmd + alt + ctrl - f              : yabai -m window --toggle float

# --- workspace modes ----------------------------------------------------
# Three transient submodes, all capturing (@) so unbound keys don't leak
# to the foreground app while a mode is active:
#
#   focus    caps+space        → digit (focus space), n/p/tab cycle.
#   send     caps+return       → digit (send window+follow), n/p.
#   manage   caps+shift+return → a (add), r (rename), i (info),
#                                l (list), shift+d (destroy).
#
# Entry chords use return/space because they're easier to hit than the
# old w/ctrl-space chords, and they group naturally: return for
# slot-targeted ops (send/manage), space for the navigation mode (focus).
#
# Why each mode declares `: true` on entry: skhd has a documented
# mode-transition race (koekeishiya/skhd #34, #102) where the first
# keystroke after entry can be dropped at high typing speeds. A trivial
# on-enter command forces a synchronous flush of the dispatcher's event
# queue and eliminates the drop.
#
# Why modes don't auto-exit on action: skhd's binding grammar makes
# `: command` and `; mode` mutually exclusive — a single line cannot
# both run a command AND switch back to default. Modes therefore stay
# sticky after an action; press escape / return / q to leave.

:: focus  @ : true
:: send   @ : true
:: manage @ : true

# Mode entries (no shell command — `; mode` and `: command` cannot
# coexist on one line). Hyper+Esc is the global panic-exit; bound to
# `; default` both at default level and inside every mode so it always
# returns you home, even if focus gets stuck.
cmd + alt + ctrl + shift - space  ; focus
cmd + alt + ctrl + shift - return ; send
cmd + alt + ctrl - return         ; manage
cmd + alt + ctrl + shift - escape ; default

# focus mode --------------------------------------------------------------
focus < 1 : "$HOME/.local/bin/ws-focus" 1
focus < 2 : "$HOME/.local/bin/ws-focus" 2
focus < 3 : "$HOME/.local/bin/ws-focus" 3
focus < 4 : "$HOME/.local/bin/ws-focus" 4
focus < 5 : "$HOME/.local/bin/ws-focus" 5
focus < 6 : "$HOME/.local/bin/ws-focus" 6
focus < 7 : "$HOME/.local/bin/ws-focus" 7
focus < 8 : "$HOME/.local/bin/ws-focus" 8
focus < 9 : "$HOME/.local/bin/ws-focus" 9
focus < 0 : "$HOME/.local/bin/ws-focus" 10
focus < n         : yabai -m space --focus next || yabai -m space --focus first
focus < p         : yabai -m space --focus prev || yabai -m space --focus last
focus < tab       : yabai -m space --focus next || yabai -m space --focus first
focus < shift - tab : yabai -m space --focus prev || yabai -m space --focus last
focus < escape ; default
focus < return ; default
focus < q      ; default
focus < cmd + alt + ctrl + shift - escape ; default

# send mode ---------------------------------------------------------------
send < 1 : "$HOME/.local/bin/ws-send-follow" 1
send < 2 : "$HOME/.local/bin/ws-send-follow" 2
send < 3 : "$HOME/.local/bin/ws-send-follow" 3
send < 4 : "$HOME/.local/bin/ws-send-follow" 4
send < 5 : "$HOME/.local/bin/ws-send-follow" 5
send < 6 : "$HOME/.local/bin/ws-send-follow" 6
send < 7 : "$HOME/.local/bin/ws-send-follow" 7
send < 8 : "$HOME/.local/bin/ws-send-follow" 8
send < 9 : "$HOME/.local/bin/ws-send-follow" 9
send < 0 : "$HOME/.local/bin/ws-send-follow" 10
send < n : "$HOME/.local/bin/ws-send-follow" next
send < p : "$HOME/.local/bin/ws-send-follow" prev
send < escape ; default
send < return ; default
send < q      ; default
send < cmd + alt + ctrl + shift - escape ; default

# manage mode -------------------------------------------------------------
# `a` (add) may fail without yabai's scripting-addition + SIP off — the
# fallback notification keeps the failure loud. `d` bare is intentionally
# bound to a "press Shift+D" notification rather than left unbound: a
# silent-eat would violate the system's fail-loudly principle.
manage < a         : yabai -m space --create 2>/dev/null || osascript -e 'display notification "space create failed (needs SA + SIP off, or use Mission Control +)" with title "ws"'
manage < r         : "$HOME/.config/workspace/rename.sh"
manage < i         : "$HOME/.local/bin/ws-info"
manage < l         : "$HOME/.local/bin/ws-cheatsheet" --toggle >/dev/null 2>&1 &
manage < d         : osascript -e 'display notification "Press Shift+D to destroy this workspace" with title "ws"'
manage < shift - d : "$HOME/.local/bin/ws-destroy-current"
manage < escape ; default
manage < return ; default
manage < q      ; default
manage < cmd + alt + ctrl + shift - escape ; default

# --- displays -----------------------------------------------------------
# Cycle focus between monitors. Scales past 10 spaces — useful with 3+
# displays where digit-row bindings stop making sense.
cmd + alt + ctrl + shift - tab : yabai -m display --focus next
cmd + alt + ctrl - tab         : yabai -m display --focus prev

# --- cheatsheet ---------------------------------------------------------
# Hyper+; toggles the native SwiftUI HUD (ws-cheatsheet). The
# previously-shipped Hyper+/ and Mod+; aliases were dropped — Hyper+/
# never reliably fired (skhd binding never matched the key code on this
# machine; long-standing issue, not worth debugging), and the Mod+;
# alias was redundant.
# 0x29 = ; on US ANSI.
cmd + alt + ctrl + shift - 0x29 : $HOME/.local/bin/ws-cheatsheet --toggle >/dev/null 2>&1 &

# --- open terminal ------------------------------------------------------
# Hyper+T → open a new terminal window in the current workspace.
# Terminal app is auto-detected; no hardcoding here. Override the
# detection with $WS_TERMINAL_APP. See configs/workspace/launch-terminal.sh.
cmd + alt + ctrl + shift - t : "$HOME/.local/bin/ws-launch-terminal" >/dev/null 2>&1 &

# --- open browser -------------------------------------------------------
# Hyper+B → open a new browser window in whatever browser is available.
# Browser app is auto-detected (Brave → Arc → Vivaldi → Chrome → Edge
# → Firefox → Safari); no hardcoding. Override with $WS_BROWSER_APP.
# See configs/workspace/launch-browser.sh.
cmd + alt + ctrl + shift - b : "$HOME/.local/bin/ws-launch-browser" >/dev/null 2>&1 &

# --- open Finder / Settings --------------------------------------------
# Hyper+O → open a new Finder window (o = open). AppleScript dictionary
# (no Accessibility permission required). Hyper+F is now zoom-fullscreen.
# Hyper+S → activate macOS System Settings.
cmd + alt + ctrl + shift - o : osascript -e 'tell application "Finder" to make new Finder window' -e 'tell application "Finder" to activate' >/dev/null 2>&1 &
cmd + alt + ctrl + shift - s : open -a "System Settings"

# --- app launchers (just activate; no new-window semantics) ------------
cmd + alt + ctrl + shift - c : open -a "Claude"
cmd + alt + ctrl + shift - m : open -a "Spotify"

