# Hyper+key (cmd+alt+ctrl+shift) = focus.  Hyper+Shift+key (cmd+alt+ctrl) = swap.
# Karabiner emits Hyper for Caps and Meh for Caps+Shift (Shift consumed).
# yabai tiling config is in ~/.yabairc.

# --- focus ---------------------------------------------------------------
cmd + alt + ctrl + shift - h : yabai -m window --focus west
cmd + alt + ctrl + shift - j : yabai -m window --focus south
cmd + alt + ctrl + shift - k : yabai -m window --focus north
cmd + alt + ctrl + shift - l : yabai -m window --focus east

# --- swap (Hyper+Shift) --------------------------------------------------
cmd + alt + ctrl - h : yabai -m window --swap west
cmd + alt + ctrl - j : yabai -m window --swap south
cmd + alt + ctrl - k : yabai -m window --swap north
cmd + alt + ctrl - l : yabai -m window --swap east

# --- layout / float ------------------------------------------------------
cmd + alt + ctrl + shift - return : yabai -m window --toggle zoom-fullscreen
cmd + alt + ctrl + shift - f      : yabai -m window --toggle float
cmd + alt + ctrl + shift - r      : yabai -m space  --rotate 90
cmd + alt + ctrl + shift - e      : yabai -m space  --balance

# --- spaces (Hyper+digit focus, Meh+digit send window) -----------------
# 4 BSP spaces per display (set by yabai-ensure-spaces.sh, fired both at
# yabai startup and on the display_added signal). With 2 displays attached
# that's 1..4 on display 1, 5..8 on display 2. Caps + 0 is the cheatsheet;
# Caps + 9 unbound. For 3+ monitors use Caps + Tab to cycle displays.
cmd + alt + ctrl + shift - 1 : yabai -m space --focus 1
cmd + alt + ctrl + shift - 2 : yabai -m space --focus 2
cmd + alt + ctrl + shift - 3 : yabai -m space --focus 3
cmd + alt + ctrl + shift - 4 : yabai -m space --focus 4
cmd + alt + ctrl + shift - 5 : yabai -m space --focus 5
cmd + alt + ctrl + shift - 6 : yabai -m space --focus 6
cmd + alt + ctrl + shift - 7 : yabai -m space --focus 7
cmd + alt + ctrl + shift - 8 : yabai -m space --focus 8

# Meh (Caps+Shift) is "modify": send focused window to space N and follow it.
cmd + alt + ctrl - 1 : yabai -m window --space 1 && yabai -m space --focus 1
cmd + alt + ctrl - 2 : yabai -m window --space 2 && yabai -m space --focus 2
cmd + alt + ctrl - 3 : yabai -m window --space 3 && yabai -m space --focus 3
cmd + alt + ctrl - 4 : yabai -m window --space 4 && yabai -m space --focus 4
cmd + alt + ctrl - 5 : yabai -m window --space 5 && yabai -m space --focus 5
cmd + alt + ctrl - 6 : yabai -m window --space 6 && yabai -m space --focus 6
cmd + alt + ctrl - 7 : yabai -m window --space 7 && yabai -m space --focus 7
cmd + alt + ctrl - 8 : yabai -m window --space 8 && yabai -m space --focus 8

# --- displays -----------------------------------------------------------
# Cycle focus between monitors. Scales past 8 spaces — useful with 3+
# displays where digit-row bindings stop making sense.
cmd + alt + ctrl + shift - tab : yabai -m display --focus next
cmd + alt + ctrl - tab         : yabai -m display --focus prev

# Hyper+T (new Ghostty window) is handled by Hammerspoon so it retargets
# Ghostty even when it isn't frontmost. Hyper+N intentionally unbound.

# --- workspace metadata --------------------------------------------------
# Meh+R prompts to rename the current space. Hammerspoon's textPrompt is
# preferred; falls back to an osascript dialog when hs is down so the
# binding never feels broken. (Hyper+R is `--rotate 90`; rename uses Meh+R
# to avoid the collision — rename is much rarer than rotation.)
cmd + alt + ctrl - r : hs -c "Workspace.rename()" || "$HOME/.config/workspace/rename.sh"
