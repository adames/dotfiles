# Hyper+key (cmd+alt+ctrl+shift) = focus.  Hyper+Shift+key (cmd+alt+ctrl) = swap.
# Karabiner emits Hyper for Caps and Mod for Caps+Shift (Shift consumed).
# yabai tiling config is in ~/.yabairc.

# --- focus ---------------------------------------------------------------
cmd + alt + ctrl + shift - h : yabai -m window --focus west
cmd + alt + ctrl + shift - j : yabai -m window --focus south
cmd + alt + ctrl + shift - k : yabai -m window --focus north
cmd + alt + ctrl + shift - l : yabai -m window --focus east

# --- swap (Hyper+Shift) --------------------------------------------------
cmd + alt + ctrl - h : yabai -m window --swap west
cmd + alt + ctrl - j : yabai -m window --swap south
cmd + alt + ctrl - k : yabai -m window --swap north
cmd + alt + ctrl - l : yabai -m window --swap east

# --- layout / float ------------------------------------------------------
cmd + alt + ctrl + shift - return : yabai -m window --toggle zoom-fullscreen
cmd + alt + ctrl + shift - r      : yabai -m space  --rotate 90
cmd + alt + ctrl + shift - e      : yabai -m space  --balance

# Hyper+F is "open Finder" (see below). Toggle-float lives on Mod+F:
# Mod is the "modify" layer (Hyper = navigate, Mod = modify), so
# changing a window's tiled/floating state belongs here next to swap.
cmd + alt + ctrl - f              : yabai -m window --toggle float

# --- spaces (Hyper+digit focus, Mod+digit send window) -----------------
# Inlined for simplicity. yabai silently no-ops on `--space N --focus`
# when space N doesn't exist, so binding 1..9 unconditionally is safe
# regardless of the user's current slot count. Hyper+0 is intentionally
# absent here — it's bound below to the terminal launcher.
#
# (Previously these were generated by `ws-topology emit-skhd` and loaded
# via `.load "~/.config/skhd/spaces.skhdrc"` — but skhd's `.load` parser
# does not expand `~`, so the fragment never resolved. Inlining drops
# both the broken indirection and the dynamic-regeneration machinery in
# the post-mutate hook.)
cmd + alt + ctrl + shift - 1 : yabai -m space --focus 1
cmd + alt + ctrl + shift - 2 : yabai -m space --focus 2
cmd + alt + ctrl + shift - 3 : yabai -m space --focus 3
cmd + alt + ctrl + shift - 4 : yabai -m space --focus 4
cmd + alt + ctrl + shift - 5 : yabai -m space --focus 5
cmd + alt + ctrl + shift - 6 : yabai -m space --focus 6
cmd + alt + ctrl + shift - 7 : yabai -m space --focus 7
cmd + alt + ctrl + shift - 8 : yabai -m space --focus 8
cmd + alt + ctrl + shift - 9 : yabai -m space --focus 9
cmd + alt + ctrl + shift - 0 : yabai -m space --focus 10

cmd + alt + ctrl - 1 : yabai -m window --space 1 && yabai -m space --focus 1
cmd + alt + ctrl - 2 : yabai -m window --space 2 && yabai -m space --focus 2
cmd + alt + ctrl - 3 : yabai -m window --space 3 && yabai -m space --focus 3
cmd + alt + ctrl - 4 : yabai -m window --space 4 && yabai -m space --focus 4
cmd + alt + ctrl - 5 : yabai -m window --space 5 && yabai -m space --focus 5
cmd + alt + ctrl - 6 : yabai -m window --space 6 && yabai -m space --focus 6
cmd + alt + ctrl - 7 : yabai -m window --space 7 && yabai -m space --focus 7
cmd + alt + ctrl - 8 : yabai -m window --space 8 && yabai -m space --focus 8
cmd + alt + ctrl - 9 : yabai -m window --space 9 && yabai -m space --focus 9
cmd + alt + ctrl - 0 : yabai -m window --space 10 && yabai -m space --focus 10

# --- displays -----------------------------------------------------------
# Cycle focus between monitors. Scales past 10 spaces — useful with 3+
# displays where digit-row bindings stop making sense.
cmd + alt + ctrl + shift - tab : yabai -m display --focus next
cmd + alt + ctrl - tab         : yabai -m display --focus prev

# --- cheatsheet ---------------------------------------------------------
# Hyper+; toggles the native SwiftUI HUD (ws-cheatsheet). The
# previously-shipped Hyper+/ and Mod+; aliases were dropped — Hyper+/
# never reliably fired (skhd binding never matched the key code on this
# machine; long-standing issue, not worth debugging), and the Mod+;
# alias was redundant.
# 0x29 = ; on US ANSI.
cmd + alt + ctrl + shift - 0x29 : $HOME/.local/bin/ws-cheatsheet --toggle >/dev/null 2>&1 &

# --- open terminal ------------------------------------------------------
# Hyper+T → open a new terminal window in the current workspace.
# Terminal app is auto-detected; no hardcoding here. Override the
# detection with $WS_TERMINAL_APP. See configs/workspace/launch-terminal.sh.
cmd + alt + ctrl + shift - t : "$HOME/.local/bin/ws-launch-terminal" >/dev/null 2>&1 &

# --- open browser -------------------------------------------------------
# Hyper+B → open a new browser window in whatever browser is available.
# Browser app is auto-detected (Brave → Arc → Vivaldi → Chrome → Edge
# → Firefox → Safari); no hardcoding. Override with $WS_BROWSER_APP.
# See configs/workspace/launch-browser.sh.
cmd + alt + ctrl + shift - b : "$HOME/.local/bin/ws-launch-browser" >/dev/null 2>&1 &

# --- open Finder / Settings --------------------------------------------
# Hyper+F → open a new Finder window. AppleScript dictionary (no
# Accessibility permission required).
# Hyper+S → activate macOS System Settings.
cmd + alt + ctrl + shift - f : osascript -e 'tell application "Finder" to make new Finder window' -e 'tell application "Finder" to activate' >/dev/null 2>&1 &
cmd + alt + ctrl + shift - s : open -a "System Settings"

# --- app launchers (just activate; no new-window semantics) ------------
cmd + alt + ctrl + shift - c : open -a "Claude"
cmd + alt + ctrl + shift - m : open -a "Spotify"

# --- floating-window snaps (Mod+arrows) ---------------------------------
# SIP-safe absolute snaps for yabai-unmanaged windows (System Settings,
# floating Ghostty). Hyper layer keeps hjkl/yabai; Mod keeps arrows as
# manual snaps — see docs/architecture.md "Hyper = navigate, Mod = modify".
cmd + alt + ctrl - left  : $HOME/.local/bin/ws-snap left
cmd + alt + ctrl - right : $HOME/.local/bin/ws-snap right
cmd + alt + ctrl - up    : $HOME/.local/bin/ws-snap max
cmd + alt + ctrl - down  : $HOME/.local/bin/ws-snap center

# --- workspace metadata --------------------------------------------------
# Mod+R prompts to rename the current space via the osascript dialog in
# workspace/rename.sh. (Hyper+R is `--rotate 90`; rename uses Mod+R to
# avoid the collision — rename is much rarer than rotation.) The script
# updates spaces.json and fires on-space-changed.sh to cascade the new
# name into tmux env / starship / SketchyBar.
cmd + alt + ctrl - r : "$HOME/.config/workspace/rename.sh"

# --- workspace remove (Hyper+Shift+-) -----------------------------------
# Removes the currently focused workspace non-interactively. Sources the
# workspace cache file for MACOS_SPACE_INDEX (written by the cascade on
# every space change), then runs `ws remove $idx -y`.
#
# The companion add binding (Hyper+Shift+=) was removed: spawning a
# Ghostty window from skhd's no-tty context to run `ws add` interactively
# proved unreliable in practice — the timing between window-spawn and
# keystroke is fragile. Until we have a better interactive-entry path
# (a native picker / a non-Ghostty prompt), use `ws add` from any
# terminal directly.
#
# 0x1B = `-` on the standard ANSI macOS layout. Verify with
# `skhd --observe` if rebinding for a non-ANSI layout.
cmd + alt + ctrl + shift - 0x1B : bash -c '[ -r "$HOME/.cache/workspace/current.env" ] && . "$HOME/.cache/workspace/current.env"; "$HOME/.local/bin/ws" remove "${MACOS_SPACE_INDEX:-1}" -y' >/dev/null 2>&1
