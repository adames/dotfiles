# Hyper+key (cmd+alt+ctrl+shift) = focus.  Hyper+Shift+key (cmd+alt+ctrl) = swap.
# Karabiner emits Hyper for Caps and Meh for Caps+Shift (Shift consumed).
# yabai tiling config is in ~/.yabairc.

# --- focus ---------------------------------------------------------------
cmd + alt + ctrl + shift - h : yabai -m window --focus west
cmd + alt + ctrl + shift - j : yabai -m window --focus south
cmd + alt + ctrl + shift - k : yabai -m window --focus north
cmd + alt + ctrl + shift - l : yabai -m window --focus east

# --- swap (Hyper+Shift) --------------------------------------------------
cmd + alt + ctrl - h : yabai -m window --swap west
cmd + alt + ctrl - j : yabai -m window --swap south
cmd + alt + ctrl - k : yabai -m window --swap north
cmd + alt + ctrl - l : yabai -m window --swap east

# --- layout / float ------------------------------------------------------
cmd + alt + ctrl + shift - return : yabai -m window --toggle zoom-fullscreen
cmd + alt + ctrl + shift - f      : yabai -m window --toggle float
cmd + alt + ctrl + shift - r      : yabai -m space  --rotate 90
cmd + alt + ctrl + shift - e      : yabai -m space  --balance

# --- spaces (Hyper+digit focus, Meh+digit send window) -----------------
# 10 BSP spaces total (set by yabai-ensure-spaces.sh, fired both at yabai
# startup and on the display_added signal). With 2 displays attached
# slot 1 stays on the laptop ("core") and slots 2..10 migrate to the
# monitor — see configs/workspace/reconcile-displays.sh. Caps + 0
# focuses slot 10 ("void"); the cheatsheet has moved to Caps + /.
#
# Bindings are generated by `ws-topology emit-skhd --write` from
# spaces.json's current slot count, and the resulting fragment is loaded
# here. The post-mutate hook regenerates on every workspace mutation so
# the binding set matches the live slot count up to the hardware-limited
# 10-digit cap.
.load "~/.config/skhd/spaces.skhdrc"

# --- displays -----------------------------------------------------------
# Cycle focus between monitors. Scales past 10 spaces — useful with 3+
# displays where digit-row bindings stop making sense.
cmd + alt + ctrl + shift - tab : yabai -m display --focus next
cmd + alt + ctrl - tab         : yabai -m display --focus prev

# --- cheatsheet ---------------------------------------------------------
# Hyper+; and Hyper+/ both toggle the native SwiftUI HUD (ws-cheatsheet).
# 0x2C = / on US ANSI; 0x29 = ; on US ANSI. Two bindings because Hyper+;
# is the muscle-memory binding and Hyper+/ is the universal "show
# shortcuts" gesture.
cmd + alt + ctrl + shift - 0x29 : $HOME/.local/bin/ws-cheatsheet --toggle >/dev/null 2>&1 &
cmd + alt + ctrl + shift - 0x2C : $HOME/.local/bin/ws-cheatsheet --toggle >/dev/null 2>&1 &
cmd + alt + ctrl - 0x29         : $HOME/.local/bin/ws-cheatsheet --toggle >/dev/null 2>&1 &

# --- terminal launcher --------------------------------------------------
# Hyper+T → new terminal window in the current workspace. Terminal app
# is auto-detected (Ghostty preferred; falls back through iTerm /
# Alacritty / kitty / WezTerm / Terminal). Override with
# $WS_TERMINAL_APP. See configs/workspace/launch-terminal.sh.
#
# Hyper+0 → focus the "code" workspace AND spawn a new terminal there.
# This makes Hyper+0 the dev-entry shortcut; pairs with the "code" pill
# in the factory-default 2-slot navbar (home, code).
cmd + alt + ctrl + shift - t : "$HOME/.local/bin/ws-launch-terminal" >/dev/null 2>&1 &
cmd + alt + ctrl + shift - 0 : "$HOME/.local/bin/ws-launch-terminal" code >/dev/null 2>&1 &

# --- app launchers ------------------------------------------------------
cmd + alt + ctrl + shift - b : open -a "Brave Browser"
cmd + alt + ctrl + shift - c : open -a "Claude"
cmd + alt + ctrl + shift - m : open -a "Spotify"

# --- floating-window snaps (Meh+arrows) ---------------------------------
# SIP-safe absolute snaps for yabai-unmanaged windows (System Settings,
# floating Ghostty). Hyper layer keeps hjkl/yabai; Meh keeps arrows as
# manual snaps — see docs/architecture.md "Hyper = navigate, Meh = modify".
cmd + alt + ctrl - left  : $HOME/.local/bin/ws-snap left
cmd + alt + ctrl - right : $HOME/.local/bin/ws-snap right
cmd + alt + ctrl - up    : $HOME/.local/bin/ws-snap max
cmd + alt + ctrl - down  : $HOME/.local/bin/ws-snap center

# --- workspace metadata --------------------------------------------------
# Meh+R prompts to rename the current space via the osascript dialog in
# workspace/rename.sh. (Hyper+R is `--rotate 90`; rename uses Meh+R to
# avoid the collision — rename is much rarer than rotation.) The script
# updates spaces.json and fires on-space-changed.sh to cascade the new
# name into tmux env / starship / SketchyBar.
cmd + alt + ctrl - r : "$HOME/.config/workspace/rename.sh"

# --- workspace remove (Hyper+Shift+-) -----------------------------------
# Removes the currently focused workspace non-interactively. Sources the
# workspace cache file for MACOS_SPACE_INDEX (written by the cascade on
# every space change), then runs `ws remove $idx -y`.
#
# The companion add binding (Hyper+Shift+=) was removed: spawning a
# Ghostty window from skhd's no-tty context to run `ws add` interactively
# proved unreliable in practice — the timing between window-spawn and
# keystroke is fragile. Until we have a better interactive-entry path
# (a native picker / a non-Ghostty prompt), use `ws add` from any
# terminal directly.
#
# 0x1B = `-` on the standard ANSI macOS layout. Verify with
# `skhd --observe` if rebinding for a non-ANSI layout.
cmd + alt + ctrl + shift - 0x1B : bash -c '[ -r "$HOME/.cache/workspace/current.env" ] && . "$HOME/.cache/workspace/current.env"; "$HOME/.local/bin/ws" remove "${MACOS_SPACE_INDEX:-1}" -y' >/dev/null 2>&1
