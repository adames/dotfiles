# Hyper+key (cmd+alt+ctrl+shift) = focus.  Hyper+Shift+key (cmd+alt+ctrl) = swap.
# Karabiner emits Hyper for Caps and Mod for Caps+Shift (Shift consumed).
# yabai tiling config is in ~/.yabairc.

# --- focus ---------------------------------------------------------------
cmd + alt + ctrl + shift - h : yabai -m window --focus west
cmd + alt + ctrl + shift - j : yabai -m window --focus south
cmd + alt + ctrl + shift - k : yabai -m window --focus north
cmd + alt + ctrl + shift - l : yabai -m window --focus east

# --- swap (Hyper+Shift) --------------------------------------------------
cmd + alt + ctrl - h : yabai -m window --swap west
cmd + alt + ctrl - j : yabai -m window --swap south
cmd + alt + ctrl - k : yabai -m window --swap north
cmd + alt + ctrl - l : yabai -m window --swap east

# --- layout / float -------------------------------------------------------
# New windows are staged on the focused space by ~/.yabairc's
# ws_stage_window signal: cross-space migrated, focused, and (if the
# app/rule has them floating) centered. Tile-vs-float is the app's call.
# Floating-staged windows have three exits:
#   1. caps + return → digit  — send to another workspace (send mode)
#   2. ⌘W                     — close
#   3. caps + f               — toggle float (unfloat = commit to tiling)
#
# No zoom-fullscreen binding: BSP + plenty of workspaces means covering
# the whole screen with one tile is rarely the right move — send the
# window to its own workspace instead.
cmd + alt + ctrl + shift - f      : yabai -m window --toggle float
cmd + alt + ctrl + shift - r      : yabai -m space  --rotate 90
cmd + alt + ctrl + shift - e      : yabai -m space  --balance

# --- workspace prompts --------------------------------------------------
# Workspace focus / send / manage are dispatched to a SwiftUI overlay
# (ws-prompt), not skhd modes. The overlay captures keystrokes itself
# and exits on commit / cancel / blur — so skhd never enters or holds
# a workspace mode. No mode declarations, no sticky-state worry.
#
#   focus   caps+space        → digit (1..0) commits instantly · letters
#                              fuzzy-match workspace name + Enter
#   send    caps+return       → digit commits + follow · letters fuzzy-match
#   manage  caps+shift+return → a add · r rename · i info · l list · ⇧D destroy
#
# Entry chords use return / space for the same reasons as before:
# easier to hit than letter chords, and grouping naturally — return
# for slot-targeted ops (send/manage), space for navigation (focus).
#
# Caps+Esc is preserved as a no-op so users who built muscle memory
# around the old panic-exit still see "nothing happened" (rather than
# the chord leaking into the foreground app).
cmd + alt + ctrl + shift - space  : "$HOME/.local/bin/ws-prompt" focus  >/dev/null 2>&1 &
cmd + alt + ctrl + shift - return : "$HOME/.local/bin/ws-prompt" send   >/dev/null 2>&1 &
cmd + alt + ctrl - return         : "$HOME/.local/bin/ws-prompt" manage >/dev/null 2>&1 &
cmd + alt + ctrl + shift - escape : :

# --- displays -----------------------------------------------------------
# Cycle focus between monitors. Scales past 10 spaces — useful with 3+
# displays where digit-row bindings stop making sense.
cmd + alt + ctrl + shift - tab : yabai -m display --focus next
cmd + alt + ctrl - tab         : yabai -m display --focus prev

# --- cheatsheet ---------------------------------------------------------
# Hyper+; toggles the native SwiftUI HUD (ws-cheatsheet). The
# previously-shipped Hyper+/ and Mod+; aliases were dropped — Hyper+/
# never reliably fired (skhd binding never matched the key code on this
# machine; long-standing issue, not worth debugging), and the Mod+;
# alias was redundant.
# 0x29 = ; on US ANSI.
cmd + alt + ctrl + shift - 0x29 : $HOME/.local/bin/ws-cheatsheet --toggle >/dev/null 2>&1 &

# --- open terminal ------------------------------------------------------
# Hyper+T → open a new terminal window in the current workspace.
# Terminal app is auto-detected; no hardcoding here. Override the
# detection with $WS_TERMINAL_APP. See configs/workspace/launch-terminal.sh.
cmd + alt + ctrl + shift - t : "$HOME/.local/bin/ws-launch-terminal" >/dev/null 2>&1 &

# --- open browser -------------------------------------------------------
# Hyper+B → open a new browser window in whatever browser is available.
# Browser app is auto-detected (Brave → Arc → Vivaldi → Chrome → Edge
# → Firefox → Safari); no hardcoding. Override with $WS_BROWSER_APP.
# See configs/workspace/launch-browser.sh.
cmd + alt + ctrl + shift - b : "$HOME/.local/bin/ws-launch-browser" >/dev/null 2>&1 &

# --- open Finder / Settings --------------------------------------------
# Hyper+O → open a new Finder window (o = open). AppleScript dictionary
# (no Accessibility permission required). Hyper+F is now zoom-fullscreen.
# Hyper+S → activate macOS System Settings.
cmd + alt + ctrl + shift - o : osascript -e 'tell application "Finder" to make new Finder window' -e 'tell application "Finder" to activate' >/dev/null 2>&1 &
cmd + alt + ctrl + shift - s : open -a "System Settings"

# --- app launchers (just activate; no new-window semantics) ------------
cmd + alt + ctrl + shift - c : open -a "Claude"
cmd + alt + ctrl + shift - m : open -a "Spotify"

