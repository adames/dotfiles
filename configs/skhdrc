# Hyper (Caps) navigates; Mod (Caps+Shift) modifies. Full inventory: docs/keymap.md.

# @cs section Windows · Spaces
# @cs family system
# @cs sub yabai · skhd · ws-snap
# @cs idea Hyper navigates; Mod modifies. New windows arrive on the focused space + focused; floats are centered. Unfloat to commit, go to relocate, ⌘W to dismiss.
# @cs row caps + hjkl              :: focus window  ←  ↓  ↑  →
# @cs row caps + shift + hjkl      :: swap window  ←  ↓  ↑  →
# @cs row caps + v                 :: toggle float / unfloat  (unfloat = commit staged window to tiling)
# @cs row caps + shift + v         :: center floating window  (50% inner grid)
# @cs row caps + e                 :: expose / window picker — fuzzy-search every visible window
# @cs row caps + r                 :: rotate space 90°
# @cs row caps + shift + r         :: rebalance space (equal BSP splits)
# @cs row caps + n  ·  caps + p    :: next / prev workspace (wraps)
# @cs row caps + tab               :: last / recent workspace
# @cs end

# --- focus / swap ---------------------------------------------------------
cmd + alt + ctrl + shift - h : yabai -m window --focus west
cmd + alt + ctrl + shift - j : yabai -m window --focus south
cmd + alt + ctrl + shift - k : yabai -m window --focus north
cmd + alt + ctrl + shift - l : yabai -m window --focus east

cmd + alt + ctrl - h : yabai -m window --swap west
cmd + alt + ctrl - j : yabai -m window --swap south
cmd + alt + ctrl - k : yabai -m window --swap north
cmd + alt + ctrl - l : yabai -m window --swap east

# --- layout / float -------------------------------------------------------
cmd + alt + ctrl + shift - v : yabai -m window --toggle float
cmd + alt + ctrl         - v : yabai -m window --grid 4:4:1:1:2:2
cmd + alt + ctrl + shift - r : yabai -m space  --rotate 90
cmd + alt + ctrl         - r : yabai -m space  --balance
cmd + alt + ctrl + shift - e : "$HOME/.local/bin/ws-picker" >/dev/null 2>&1 &

# --- workspace cycle ------------------------------------------------------
cmd + alt + ctrl + shift - n   : "$HOME/.local/bin/ws-focus" next
cmd + alt + ctrl + shift - p   : "$HOME/.local/bin/ws-focus" prev
cmd + alt + ctrl + shift - tab : "$HOME/.local/bin/ws-focus" last

# @cs section Workspace · Slots
# @cs family system
# @cs sub number = stable selector · names/icons are cosmetic
# @cs idea Three overlays. Digit (1..0) commits instantly; type letters to fuzzy-search names + Enter. Esc and click-elsewhere always cancel.
# @cs row caps + w                  :: focus prompt → digit · letters → name search + ↵
# @cs row caps + g  ·  caps + m     :: go / move prompt → digit (commit + follow) · letters + ↵
# @cs row caps + shift + w          :: manage prompt → a add · r rename · i icon · d destroy
# @cs row     (in manage)           :: ⇧L layout save/load/delete · v verify · ? doctor
# @cs row esc / click-elsewhere     :: cancel any prompt
# @cs row —                         :: names cannot start with a digit · all-numeric query = slot index (11+)
# @cs end

# --- workspace prompts ----------------------------------------------------
# Caps+Esc no-op: chord must not leak into focused app.
cmd + alt + ctrl + shift - w      : "$HOME/.local/bin/ws-prompt" focus  >/dev/null 2>&1 &
cmd + alt + ctrl + shift - g      : "$HOME/.local/bin/ws-prompt" send   >/dev/null 2>&1 &
# Caps+m aliases Caps+g — "move" mnemonic.
cmd + alt + ctrl + shift - m      : "$HOME/.local/bin/ws-prompt" send   >/dev/null 2>&1 &
cmd + alt + ctrl         - w      : "$HOME/.local/bin/ws-prompt" manage >/dev/null 2>&1 &
cmd + alt + ctrl + shift - escape : :

# --- cheatsheet -----------------------------------------------------------
# 0x29 = ; on US ANSI.
cmd + alt + ctrl + shift - 0x29 : $HOME/.local/bin/ws-cheatsheet --toggle >/dev/null 2>&1 &

# @cs section Launch
# @cs family system
# @cs sub skhd · auto-detected apps
# @cs idea Each chord spawns a new window of an auto-detected app. Override the choice with $WS_* env vars.
# @cs row caps + t          :: new terminal  (auto: Ghostty / iTerm / …; $WS_TERMINAL_APP)
# @cs row caps + b          :: new browser  (auto: Brave / Arc / … / Safari; $WS_BROWSER_APP)
# @cs row caps + o          :: new Finder window  (o = open)
# @cs row caps + ,          :: System Settings
# @cs row caps + q          :: notes  (auto: Raycast Notes → Apple Notes; $WS_NOTES_APP)
# @cs row caps + shift + q  :: inbox  (auto: Obsidian → Apple Notes; $WS_INBOX_APP / $WS_INBOX_VAULT)
# @cs row caps + ;          :: this cheatsheet (toggle)
# @cs end

# --- launchers ------------------------------------------------------------
# Helpers under ~/.local/bin/ auto-detect the app; $WS_* env vars override.
# 0x2B = , on US ANSI.
cmd + alt + ctrl + shift - t    : "$HOME/.local/bin/ws-launch-terminal" >/dev/null 2>&1 &
cmd + alt + ctrl + shift - b    : "$HOME/.local/bin/ws-launch-browser"  >/dev/null 2>&1 &
cmd + alt + ctrl + shift - o    : osascript -e 'tell application "Finder" to make new Finder window' -e 'tell application "Finder" to activate' >/dev/null 2>&1 &
cmd + alt + ctrl + shift - 0x2B : open -a "System Settings"
cmd + alt + ctrl + shift - q    : "$HOME/.local/bin/ws-launch-notes" >/dev/null 2>&1 &
cmd + alt + ctrl         - q    : "$HOME/.local/bin/ws-launch-inbox" >/dev/null 2>&1 &
