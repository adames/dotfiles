#!/usr/bin/env bash
# SketchyBar workspace indicator. One catppuccin pill per slot in
# ~/.config/workspace/spaces.json (slot-count agnostic). Refreshed by
# the yabai signal chain:
#   yabai space_changed → on-space-changed.sh → --trigger workspace_changed
# All pill rendering lives in plugins/space.sh.
#
# In-session add/remove of pills (when `workspace add` / `workspace
# remove` changes the slot count) is driven by the post-mutate hook at
# ~/.config/workspace/hooks/post-mutate.sh. This rc only matters at
# `sketchybar --reload` time, when it rebuilds the pill set from
# scratch — using the *current* slot count.

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# shellcheck source=/dev/null
source "$CONFIG_DIR/colors.sh"

##### bar ####################################################################
# Top-of-screen, full-width. On notched MacBooks, items anchored `left`
# land in the left-of-notch region (between the screen corner and the
# camera) — sketchybar handles the notch-aware geometry automatically.
#
# topmost=off so the macOS menu bar (when revealed by hovering at the
# top) draws OVER our strip. Combined with macOS "Automatically hide
# and show the menu bar" = on, this gives:
#   • cursor away from top → menu bar hidden, sketchybar visible + clickable
#   • cursor at top → menu bar slides in, occludes sketchybar in that
#     region, system menu items take clicks
# Windows can also cover the strip; yabai's external_bar in ~/.yabairc
# reserves the top 26px so tiled windows never do, leaving the strip
# always-exposed under normal usage.
#
# y_offset=7 vertically centers the 26px bar within the y=0..40 band
# (top of screen → top of yabai window snap line, which is macOS menu
# bar reserve 32 + top_padding 8). padding_left starts at 8 and is
# rewritten by the recenter call below so pills sit centered between
# the screen's top-left corner and the camera notch.
sketchybar --bar \
  height=26 \
  position=top \
  y_offset=7 \
  padding_left=8 \
  padding_right=8 \
  color="$BAR_COLOR" \
  topmost=off

##### defaults ###############################################################
# Icon-only pills (label.drawing=off). Font family is "JetBrainsMono NF"
# with the space — that's the Core Text registered family name (per
# `mdls -name kMDItemFonts ...`); the no-space variant does not resolve
# and falls back to a non-Nerd-Font, hiding all PUA glyphs.
# Wider per-pill padding gives the breathing room a bottom dock needs.
sketchybar --default \
  drawing=on \
  updates=when_shown \
  label.drawing=off \
  background.corner_radius=6 \
  background.height=22 \
  background.padding_left=8 \
  background.padding_right=8 \
  icon.font="JetBrainsMono NF:Bold:14.0" \
  icon.padding_left=10 \
  icon.padding_right=10

##### space items (dynamic, capped at 10 visible) ############################
# Pill count derives from spaces.json so `workspace add` / `workspace
# remove` survive a `--reload`. Falls back to 10 if jq or the config
# file is missing. Hard cap at 10 visible — even if the user has more
# workspaces, the dock displays at most 10 (matches the skhd hotkey
# range of Caps+1..0).
# Registered as one custom event so all pills repaint atomically.
sketchybar --add event workspace_changed

WS_CONFIG="$HOME/.config/workspace/spaces.json"
SLOT_COUNT=10
if [[ -r "$WS_CONFIG" ]] && command -v jq >/dev/null 2>&1; then
  SLOT_COUNT=$(jq '.spaces | keys | length' "$WS_CONFIG" 2>/dev/null || echo 10)
fi
VISIBLE=$SLOT_COUNT
(( VISIBLE > 10 )) && VISIBLE=10

for (( sid=1; sid<=VISIBLE; sid++ )); do
  sketchybar --add item "space.$sid" left \
             --set "space.$sid" \
                script="$PLUGIN_DIR/space.sh" \
                click_script="yabai -m space --focus $sid" \
             --subscribe "space.$sid" workspace_changed
done

##### init paint + recenter ##################################################
sketchybar --update
sketchybar --trigger workspace_changed
[[ -x "$PLUGIN_DIR/recenter.sh" ]] && "$PLUGIN_DIR/recenter.sh"
