#!/usr/bin/env bash
# SketchyBar workspace indicator. One catppuccin pill per slot in
# ~/.config/workspace/spaces.json (slot-count agnostic). Layout is
# dead-simple: items anchored left, drawn left-to-right from the
# screen corner toward the center. No centering math, no
# notch-aware split — sketchybar already lands `left`-anchored items
# in the left aux region on notched MacBooks, and the visible-pill
# cap in per-display-pills.sh prevents pills from sliding under the
# camera housing.
#
# Refresh chain:
#   yabai space_changed → on-space-changed.sh → --trigger workspace_changed
# A hidden `workspace.paint` sentinel is the sole subscriber to
# workspace_changed; it runs plugins/paint-all.sh once per event,
# emitting one batched --set transaction for all pills + per-display
# name chips (no repaint stagger).
#
# In-session add/remove of pills (via `ws add` / `ws remove`) is driven
# by the post-mutate hook at ~/.config/workspace/hooks/post-mutate.sh.
# This rc only matters at `sketchybar --reload` time, when it rebuilds
# the pill set from scratch.

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# shellcheck source=/dev/null
source "$CONFIG_DIR/colors.sh"

##### bar ####################################################################
# Top-of-screen, full-width.
#
# topmost=off so the macOS menu bar (when revealed by hovering at the
# top) draws OVER our strip. Combined with macOS "Automatically hide
# and show the menu bar" = on, this gives:
#   • cursor away from top → menu bar hidden, sketchybar visible + clickable
#   • cursor at top → menu bar slides in, occludes sketchybar in that
#     region, system menu items take clicks
# Windows can also cover the strip; yabai's external_bar in ~/.yabairc
# reserves the top 26px so tiled windows never do.
#
# y_offset=7 vertically centers the 26px bar within the y=0..40 band.
# padding_left=8 = bar-edge margin (so the leftmost item doesn't touch
# the screen corner).
sketchybar --bar \
  height=26 \
  position=top \
  y_offset=7 \
  padding_left=8 \
  padding_right=8 \
  color="$BAR_COLOR" \
  topmost=off

##### defaults ###############################################################
# Pills are icon-only. The focused workspace's NAME lives on the
# per-display `workspace.name.<D>` chip (created by per-display-pills.sh
# as the leftmost item of each display's strip) — that keeps "where
# am I" visible without resizing the pill chain.
# Font family is "JetBrainsMono Nerd Font" — that's the Core Text
# registered family name shipped by `font-jetbrains-mono-nerd-font`
# (verify with `osascript -e 'use framework "AppKit"' …` or Font Book).
# The obsolete `JetBrainsMono NF` short name no longer resolves on
# modern cask installs and falls back to a non-Nerd-Font, hiding all
# PUA glyphs.
sketchybar --default \
  drawing=on \
  updates=when_shown \
  label.drawing=off \
  background.corner_radius=6 \
  background.height=22 \
  background.padding_left=8 \
  background.padding_right=8 \
  icon.font="JetBrainsMono Nerd Font:Bold:12.0" \
  icon.padding_left=8 \
  icon.padding_right=8 \
  label.font="JetBrainsMono Nerd Font:Bold:12.0"

##### space items (per-display, yabai-driven) ################################
# Yabai is the source of truth for "what spaces exist and which display
# owns each one". per-display-pills.sh assigns display=<N> + the
# visible-pill cap on notched laptops; this rc just registers the
# items so they exist before the first paint.
#
# Falls back to whatever spaces.json reports if yabai isn't reachable
# (fresh boot before yabai is up, or running headless).
sketchybar --add event workspace_changed

space_indices=""
if command -v yabai >/dev/null 2>&1 && yabai -m query --spaces >/dev/null 2>&1; then
  space_indices=$(yabai -m query --spaces 2>/dev/null \
    | command jq -r '.[].index' 2>/dev/null \
    | tr '\n' ' ')
fi
if [[ -z "${space_indices// }" ]]; then
  WS_CONFIG="$HOME/.config/workspace/spaces.json"
  count=10
  if [[ -r "$WS_CONFIG" ]] && command -v jq >/dev/null 2>&1; then
    count=$(jq '.spaces | length' "$WS_CONFIG" 2>/dev/null)
    [[ -z "$count" || "$count" -lt 1 ]] && count=10
  fi
  space_indices=$(seq 1 "$count" | tr '\n' ' ')
fi

# Pills carry no per-item script and no event subscription — paint is
# centralized at the workspace.paint sentinel below. padding_left=2
# is the inter-pill gap; the bar's own padding_left=8 handles the
# corner margin and per-display-pills.sh reorders so the leftmost
# item on each display is the workspace.name chip.
for sid in $space_indices; do
  sketchybar --add item "space.$sid" left \
             --set "space.$sid" \
                click_script="yabai -m space --focus $sid" \
                padding_left=2 \
                padding_right=0
done

##### workspace.paint sentinel (single subscriber → batched repaint) #########
# Hidden, never drawn. Its only job is to receive the workspace_changed
# event once per cascade and run plugins/paint-all.sh, which emits a
# single batched sketchybar --set transaction for every pill + every
# per-display name chip.
sketchybar --add item workspace.paint left \
           --set workspace.paint \
              drawing=off \
              updates=on \
              script="$PLUGIN_DIR/paint-all.sh" \
           --subscribe workspace.paint workspace_changed

##### clock ##################################################################
# Right-anchored HH:MM. Updates every 20s; the --default block has
# label.drawing=off (icon-only pills), so this item enables it.
# Background stays transparent (no fill) so the clock reads as
# ambient info alongside the colored workspace pills rather than
# competing with the active-pill focus cue.
sketchybar --add item clock right \
           --set clock \
              update_freq=20 \
              script="$PLUGIN_DIR/clock.sh" \
              label.drawing=on \
              label.color="$INACTIVE_LABEL"

##### init paint + per-display assignment ####################################
# Order matters: per-display-pills.sh creates the workspace.name.<D>
# chips and assigns display=<N> to every item, THEN trigger the paint
# so the chips exist when paint-all.sh tries to set their labels.
sketchybar --update
[[ -x "$PLUGIN_DIR/per-display-pills.sh" ]] && "$PLUGIN_DIR/per-display-pills.sh"
sketchybar --trigger workspace_changed
